STIFIN_API_BASE=https://apro.stifin.id/api
STIFIN_BRANCH_CODES=KODE-CABANG-ANDA
# Alternatif untuk daftar sangat panjang: simpan daftar kode sebagai secret file.
# STIFIN_BRANCH_CODES_FILE=/run/secrets/STIFIN_BRANCH_CODES
STIFIN_API_AUTH_HEADER=Authorization
STIFIN_SYNC_CONCURRENCY=6
STIFIN_SYNC_TIMEOUT_MS=15000
STIFIN_SYNC_RETRIES=2
STIFIN_MIN_SUCCESS_RATE=1
STIFIN_MAX_DROP_RATE=0.35
# Tolok ukur audit opsional. Nilai ini hanya memunculkan peringatan cakupan di log build.
# STIFIN_EXPECTED_PROMOTERS=4476
# STIFIN_EXPECTED_BRANCHES=185

# Opsional. Kosongkan selama website memakai alur WhatsApp langsung tanpa n8n.
PUBLIC_STIFIN_LEAD_WEBHOOK_URL=
PUBLIC_META_PIXEL_ID=

# Rahasia autentikasi tidak ditulis di file ini.
# Gunakan Docker Build Secret dengan id STIFIN_API_AUTH_VALUE.
