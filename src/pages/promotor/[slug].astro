---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Callout from '../../components/Callout.astro';
import { waLink } from '../../data/site';
import { networkGeneratedAt, networkLocations, type NetworkLocation } from '../../data/network';

export function getStaticPaths() {
  return networkLocations.map((location) => ({ params: { slug: location.slug }, props: { location } }));
}

const { location } = Astro.props as { location: NetworkLocation };
const updatedAt = networkGeneratedAt ? new Date(networkGeneratedAt) : null;
const updatedLabel = updatedAt?.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Jakarta' });
const ageDays = updatedAt ? Math.floor((Date.now() - updatedAt.getTime()) / 86400000) : 999;
const nearby = networkLocations.filter((item) => item.province === location.province && item.slug !== location.slug).slice(0, 6);
const pageUrl = new URL(`/promotor/${location.slug}/`, Astro.site).toString();
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `Tes STIFIn di ${location.city}`,
    url: pageUrl,
    serviceType: 'Tes STIFIn dan konsultasi hasil',
    areaServed: { '@type': 'AdministrativeArea', name: `${location.city}, ${location.province}` },
    provider: { '@id': new URL('/#organization', Astro.site).toString() },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Jaringan Promotor', item: new URL('/jaringan-promotor/', Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: location.city, item: pageUrl },
    ],
  },
];
---
<BaseLayout title={`Tes STIFIn di ${location.city}, ${location.province} | STIFIn Mulia`} description={`Cari promotor Tes STIFIn di ${location.city}, ${location.province}. Periksa data jaringan, proses pemesanan, dan konsultasikan jadwal melalui WhatsApp STIFIn Mulia.`} noindex={ageDays > 90} schema={schemas}>
  <PageHero eyebrow={`Pencarian promotor · ${location.province}`} title={`Butuh Tes STIFIn di ${location.city}? Tim bantu periksa jadwal promotornya`} description={`Sistem mencatat ${location.promoters} promotor aktif melalui ${location.branches} cabang di wilayah ini. Angka tersebut bukan jaminan ketersediaan hari ini; tim akan memeriksa lokasi dan waktu terlebih dahulu.`}><div class="actions"><a class="button" data-wa-intent="kota-cek-jadwal" href={waLink(`Assalamu’alaikum, saya ingin mengecek jadwal Tes STIFIn di ${location.city}, ${location.province}. Nama: ... Jumlah peserta: ... Usia peserta: ... Waktu yang diinginkan: ...`)} target="_blank" rel="noopener noreferrer">Cek Jadwal di {location.city}</a><a class="button secondary" href="#data-wilayah">Lihat Data Wilayah</a></div><p class="microcopy">Kontak pribadi promotor tidak ditampilkan. Pesan Anda masuk melalui WhatsApp pusat STIFIn Mulia.</p></PageHero>

  <section id="data-wilayah" class="section"><div class="container local-grid"><div><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Beranda</a><span>›</span><a href="/jaringan-promotor/">Jaringan Promotor</a><span>›</span><span>{location.city}</span></nav><span class="eyebrow">Data wilayah teragregasi</span><h2>Data membantu pencarian, konfirmasi menentukan jadwal</h2><p class="lead">Sistem hanya menampilkan kota, provinsi, jumlah promotor aktif, dan jumlah cabang. Nomor pribadi, email, PassID, saldo, dan data sensitif lain tidak dipublikasikan.</p><p>Tim akan mencocokkan jumlah peserta, lokasi pertemuan, dan pilihan waktu sebelum memberikan jawaban.</p>{updatedLabel && <p class:list={{ freshness: true, stale: ageDays > 45 }}>Pembaruan data: {updatedLabel}{ageDays > 45 ? ' — data perlu diperbarui kembali' : ''}</p>}</div><div class="local-card"><span>Kota atau area</span><strong>{location.city}</strong><span>Provinsi</span><strong>{location.province}</strong><span>Promotor aktif tercatat</span><strong>{location.promoters}</strong><span>Cabang terhubung</span><strong>{location.branches}</strong></div></div></section>

  <section class="section soft"><div class="container"><div class="section-head"><div><span class="eyebrow">Cara memeriksa jadwal</span><h2>Tiga langkah, tanpa mencari nomor promotor sendiri</h2></div></div><div class="steps"><article class="step"><h3>Kirim kebutuhan</h3><p>Sampaikan jumlah peserta, usia peserta, pilihan waktu, dan area di {location.city}.</p></article><article class="step"><h3>Tim memeriksa</h3><p>Ketersediaan promotor, lokasi, dan waktu dicocokkan melalui jaringan.</p></article><article class="step"><h3>Terima konfirmasi</h3><p>Jadwal, biaya, tempat tes, dan proses selanjutnya dijelaskan sebelum Anda mendaftar.</p></article></div></div></section>

  <section class="section"><div class="container faq-grid"><div><span class="eyebrow">Pertanyaan wilayah</span><h2>Hal yang sering ditanyakan</h2></div><div><details><summary>Apakah angka promotor berarti semuanya tersedia hari ini?</summary><p>Tidak. Angka menunjukkan promotor aktif yang tercatat saat sinkronisasi. Jadwal tetap diperiksa terlebih dahulu.</p></details><details><summary>Apakah nomor promotor dapat dilihat langsung?</summary><p>Kontak pribadi tidak ditampilkan. Permintaan disaring melalui WhatsApp pusat STIFIn Mulia untuk menjaga privasi dan ketepatan informasi.</p></details><details><summary>Apakah bisa untuk keluarga atau lembaga?</summary><p>Bisa. Sampaikan jumlah peserta dan kebutuhan agar tim dapat mencarikan format layanan yang sesuai.</p></details></div></div></section>

  {nearby.length > 0 && <section class="section soft"><div class="container"><div class="section-head"><div><span class="eyebrow">Wilayah sekitar</span><h2>Jaringan lain di {location.province}</h2></div></div><div class="nearby-grid">{nearby.map((item) => <a href={`/promotor/${item.slug}/`}><strong>{item.city}</strong><span>{item.promoters} promotor aktif</span></a>)}</div></div></section>}

  <Callout title={`Cari jadwal Tes STIFIn di ${location.city}`} text="Kirimkan jumlah peserta dan waktu yang diinginkan. Tim akan membantu memeriksa promotor yang tersedia." message={`Assalamu’alaikum, saya ingin Tes STIFIn di ${location.city}, ${location.province}. Jumlah peserta: ... Usia peserta: ... Waktu yang diinginkan: ...`} />
</BaseLayout>
<style>
  .local-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(35px,7vw,90px);align-items:start}.breadcrumb{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:26px;color:var(--muted);font-size:.86rem}.breadcrumb a{color:var(--green-800);font-weight:750}.local-card{display:grid;grid-template-columns:1fr auto;gap:14px 25px;padding:28px;border:1px solid var(--line);border-radius:var(--radius);background:white;box-shadow:var(--shadow)}.local-card span{color:var(--muted)}.local-card strong{color:var(--green-950)}.freshness{font-size:.9rem;font-weight:700}.freshness.stale{color:#8a5410}.steps{grid-template-columns:repeat(3,1fr)}.faq-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(35px,7vw,90px)}details{padding:18px 0;border-bottom:1px solid var(--line)}summary{cursor:pointer;color:var(--green-950);font-weight:850}details p{margin:12px 0 0}.nearby-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.nearby-grid a{display:grid;gap:4px;padding:20px;border:1px solid var(--line);border-radius:var(--radius-sm);background:white}.nearby-grid span{color:var(--muted);font-size:.86rem}@media(max-width:760px){.local-grid,.faq-grid{grid-template-columns:1fr}.steps,.nearby-grid{grid-template-columns:1fr}}
</style>
