---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Callout from '../../components/Callout.astro';
import { waLink } from '../../data/site';
import { networkGeneratedAt, networkLocations, type NetworkLocation } from '../../data/network';

export function getStaticPaths() {
  return networkLocations.map((location) => ({ params: { slug: location.slug }, props: { location } }));
}

const { location } = Astro.props as { location: NetworkLocation };
const updatedAt = networkGeneratedAt ? new Date(networkGeneratedAt) : null;
const updatedLabel = updatedAt?.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Jakarta' });
const ageDays = updatedAt ? Math.floor((Date.now() - updatedAt.getTime()) / 86400000) : 999;
const provinceLabel = location.province || 'wilayah layanan STIFIn';
const placeLabel = [location.city, location.province, location.country && location.country !== 'Indonesia' ? location.country : ''].filter(Boolean).join(', ');
const locationType = location.administrativeType || 'Area';
const promoterList = location.promoterList || [];
const nearby = location.province
  ? networkLocations.filter((item) => item.province === location.province && item.slug !== location.slug).slice(0, 6)
  : [];
const pageUrl = new URL(`/promotor/${location.slug}/`, Astro.site).toString();
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `Tes STIFIn di ${location.city}`,
    url: pageUrl,
    serviceType: 'Tes STIFIn dan konsultasi hasil',
    areaServed: { '@type': 'AdministrativeArea', name: placeLabel },
    provider: { '@id': new URL('/#organization', Astro.site).toString() },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: 'Jaringan Promotor', item: new URL('/jaringan-promotor/', Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: location.city, item: pageUrl },
    ],
  },
];
---
<BaseLayout title={`Tes STIFIn di ${placeLabel} | STIFIn Mulia`} description={`Cari promotor Tes STIFIn di ${placeLabel}. Periksa data jaringan, proses pemesanan, dan konsultasikan jadwal melalui WhatsApp STIFIn Mulia.`} noindex={ageDays > 90} schema={schemas}>
  <PageHero eyebrow={`Tes STIFIn · ${locationType} · ${provinceLabel}`} title={`Ingin Tes STIFIn di ${location.city}? Kami bantu carikan jadwalnya.`} description={`Data terbaru mencatat ${location.promoters} promotor aktif dari ${location.branches} cabang tersinkron di wilayah ini. Ceritakan kebutuhan dan waktu pilihan Anda; tim STIFIn Mulia akan membantu menelusuri layanan yang tersedia.`}><div class="actions"><a class="button" data-wa-intent="kota-cek-jadwal" href={waLink(`Assalamu’alaikum, saya ingin Tes STIFIn di ${placeLabel}. Nama: ... Jumlah peserta: ... Usia peserta: ... Waktu yang diinginkan: ...`)} target="_blank" rel="noopener noreferrer">Cari Jadwal di {location.city}</a><a class="button secondary" href="#promotor-wilayah">Lihat Promotor</a></div><p class="microcopy">Anda cukup mengirim satu pesan. Jadwal, lokasi, biaya, dan ketersediaan promotor akan dikonfirmasi sebelum pendaftaran.</p></PageHero>

  <section id="data-wilayah" class="section"><div class="container local-grid"><div><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Beranda</a><span>›</span><a href="/jaringan-promotor/">Tes di Kota Saya</a><span>›</span><span>{location.city}</span></nav><span class="eyebrow">Jaringan di kota Anda</span><h2>Lebih mudah menemukan layanan tanpa mencari kontak satu per satu</h2><p class="lead">Data kota dan jaringan membantu tim memulai pencarian dari wilayah terdekat, kemudian menyesuaikannya dengan jumlah peserta, lokasi, dan waktu pilihan Anda.</p><p>Kontak pribadi promotor tetap terlindungi, sementara Anda mendapat satu jalur komunikasi yang lebih sederhana melalui STIFIn Mulia.</p>{updatedLabel && <p class:list={{ freshness: true, stale: ageDays > 45 }}>Data jaringan diperbarui {updatedLabel}{ageDays > 45 ? ' dan sedang menunggu pembaruan berikutnya' : ''}.</p>}</div><div class="local-card"><span>Kota atau area</span><strong>{location.city}</strong>{location.province && <><span>Provinsi</span><strong>{location.province}</strong></>}<span>Promotor aktif tercatat</span><strong>{location.promoters}</strong><span>Jaringan cabang terhubung</span><strong>{location.branches}</strong></div></div></section>

  {promoterList.length > 0 && <section id="promotor-wilayah" class="section soft"><div class="container"><div class="section-head"><div><span class="eyebrow">Promotor tersinkron</span><h2>Promotor yang tercatat di {location.city}</h2><p class="lead">Nama dan kode promotor ditampilkan agar data jaringan lebih mudah dikenali. Nomor pribadi, email, PassID, saldo, dan data sensitif lainnya tetap tidak dipublikasikan.</p></div></div><div class="promoter-grid">{promoterList.map((promoter) => <article><span>Kode promotor</span><strong>{promoter.code}</strong><h3>{promoter.name || 'Nama belum tersedia dari API'}</h3><small>{promoter.branch}</small></article>)}</div></div></section>}

  <section class:list={{ section: true, soft: promoterList.length === 0 }}><div class="container"><div class="section-head"><div><span class="eyebrow">Cara mendapatkan jadwal</span><h2>Tiga langkah menuju Tes STIFIn Anda</h2></div></div><div class="steps"><article class="step"><h3>Ceritakan kebutuhan Anda</h3><p>Sebutkan area di {location.city}, jumlah dan usia peserta, serta waktu yang diharapkan.</p></article><article class="step"><h3>Tim memeriksa pilihan</h3><p>Kami menelusuri promotor, lokasi, dan waktu melalui cabang yang telah tersinkron.</p></article><article class="step"><h3>Konfirmasi sebelum mendaftar</h3><p>Anda melanjutkan setelah jadwal, lokasi, biaya, dan prosesnya sudah jelas.</p></article></div></div></section>

  <section class="section"><div class="container faq-grid"><div><span class="eyebrow">Pertanyaan wilayah</span><h2>Hal yang sering ditanyakan</h2></div><div><details><summary>Apakah angka promotor berarti semuanya tersedia hari ini?</summary><p>Tidak. Angka menunjukkan promotor aktif yang tercatat saat sinkronisasi. Jadwal tetap diperiksa terlebih dahulu.</p></details><details><summary>Apakah nomor promotor dapat dilihat langsung?</summary><p>Kontak pribadi tidak ditampilkan. Permintaan disaring melalui WhatsApp pusat STIFIn Mulia untuk menjaga privasi dan ketepatan informasi.</p></details><details><summary>Apakah bisa untuk keluarga atau lembaga?</summary><p>Bisa. Sampaikan jumlah peserta dan kebutuhan agar tim dapat mencarikan format layanan yang sesuai.</p></details></div></div></section>

  {nearby.length > 0 && <section class="section soft"><div class="container"><div class="section-head"><div><span class="eyebrow">Wilayah sekitar</span><h2>Jaringan lain di {location.province}</h2></div></div><div class="nearby-grid">{nearby.map((item) => <a href={`/promotor/${item.slug}/`}><strong>{item.city}</strong><span>{item.promoters} promotor aktif</span></a>)}</div></div></section>}

  <Callout title={`Ayo jadwalkan Tes STIFIn di ${location.city}`} text="Kirim jumlah peserta dan waktu pilihan Anda. Tim akan membantu menemukan layanan yang paling sesuai." message={`Assalamu’alaikum, saya ingin Tes STIFIn di ${placeLabel}. Jumlah peserta: ... Usia peserta: ... Waktu yang diinginkan: ...`} />
</BaseLayout>
<style>
  .local-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(35px,7vw,90px);align-items:start}.breadcrumb{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:26px;color:var(--muted);font-size:.86rem}.breadcrumb a{color:var(--green-800);font-weight:750}.local-card{display:grid;grid-template-columns:1fr auto;gap:14px 25px;padding:28px;border:1px solid var(--line);border-radius:var(--radius);background:white;box-shadow:var(--shadow)}.local-card span{color:var(--muted)}.local-card strong{color:var(--green-950)}.freshness{font-size:.9rem;font-weight:700}.freshness.stale{color:#8a5410}.promoter-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.promoter-grid article{display:grid;align-content:start;min-height:170px;padding:22px;border:1px solid var(--line);border-radius:var(--radius-sm);background:#fff;box-shadow:var(--shadow-soft)}.promoter-grid span,.promoter-grid small{color:var(--muted);font-size:.8rem}.promoter-grid strong{margin:6px 0 17px;color:var(--green-700);font-size:.86rem}.promoter-grid h3{margin:0 0 10px;font-size:1.05rem}.promoter-grid small{margin-top:auto}.steps{grid-template-columns:repeat(3,1fr)}.faq-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(35px,7vw,90px)}details{padding:18px 0;border-bottom:1px solid var(--line)}summary{cursor:pointer;color:var(--green-950);font-weight:850}details p{margin:12px 0 0}.nearby-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.nearby-grid a{display:grid;gap:4px;padding:20px;border:1px solid var(--line);border-radius:var(--radius-sm);background:white}.nearby-grid span{color:var(--muted);font-size:.86rem}@media(max-width:900px){.promoter-grid{grid-template-columns:1fr 1fr}}@media(max-width:760px){.local-grid,.faq-grid{grid-template-columns:1fr}.steps,.nearby-grid,.promoter-grid{grid-template-columns:1fr}}
</style>
