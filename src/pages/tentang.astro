---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Callout from '../components/Callout.astro';
---
<BaseLayout title="Tentang STIFIn Mulia" description="Mengenal visi, nilai, wilayah, serta pengelola STIFIn Mulia.">
  <PageHero eyebrow="Tentang STIFIn Mulia" title="Ruang belajar dan layanan STIFIn yang tumbuh bersama masyarakat" description="Kami membantu orang mengenali potensi dirinya, menerapkannya dalam kehidupan, lalu memperluas manfaatnya melalui layanan tes, edukasi, dan jaringan promotor."></PageHero>
  <section class="section"><div class="container vision"><div><span class="eyebrow">Arah yang kami bangun</span><h2>Lebih banyak orang mengenali kekuatannya dan bertumbuh dengan cara yang lebih selaras</h2></div><div><p class="lead">Perjalanan tidak berhenti pada hasil tes. Kami menghadirkan penjelasan, materi belajar, ruang konsultasi, dan jalur profesi agar pemahaman dapat berubah menjadi langkah nyata.</p><div class="notice"><strong>Terhubung dalam jaringan STIFIn:</strong> STIFIn Mulia dibangun dan dikelola oleh Muhamad Sofyan AR, Branch Manager STIFIn Genetic Indonesia Cabang Pekalongan. Dari basis kegiatan di Bandung, STIFIn Mulia melayani tes, pembelajaran promotor, dan program lembaga dengan dukungan jaringan STIFIn di berbagai wilayah.</div></div></div></section>
  <section class="section soft"><div class="container"><div class="section-head"><div><span class="eyebrow">Nilai kerja</span><h2>Lima prinsip yang menjaga arah layanan</h2></div></div><div class="values"><article><b>Ilmu</b><p>Belajar sebelum menjelaskan.</p></article><article><b>Amanah</b><p>Jujur pada data dan batas layanan.</p></article><article><b>Adab</b><p>Menghormati perbedaan setiap manusia.</p></article><article><b>Sistem</b><p>Mengubah niat baik menjadi layanan yang teratur.</p></article><article><b>Manfaat</b><p>Menggunakan pengetahuan untuk mengambil langkah yang baik.</p></article></div></div></section>
  <section class="section dark"><div class="container profile"><div class="portrait"><img src="/images/muhamad-sofyan-ar.webp" width="900" height="1200" alt="Muhamad Sofyan AR, Branch Manager STIFIn Genetic Indonesia Cabang Pekalongan" /></div><div><span class="eyebrow">Penggerak STIFIn Mulia</span><h2>Muhamad Sofyan AR</h2><p class="lead">Branch Manager STIFIn Genetic Indonesia Cabang Pekalongan, berbasis kegiatan di Bandung dan terhubung dengan jaringan layanan di berbagai wilayah.</p><p>Ia menempuh studi Ilmu Al-Qur’an dan Tafsir di UIN Bandung. Latar tersebut memperkuat pendekatan yang mengutamakan nilai, etika, amanah, dan refleksi dalam pembelajaran serta pelayanan.</p><p>Fokus pengembangannya adalah menghadirkan pengalaman tes yang berlanjut pada pemahaman, membina promotor yang siap melayani, dan membuka kolaborasi dengan keluarga, sekolah, komunitas, serta lembaga.</p></div></div></section>
  <Callout title="Mulai perjalanan Anda bersama STIFIn Mulia" text="Pilih jalur tes, peluang promotor, atau program lembaga yang paling sesuai dengan tujuan Anda." message="Assalamu’alaikum, saya ingin memulai bersama STIFIn Mulia. Saya tertarik pada: tes / promotor / program lembaga." secondaryHref="/artikel/" secondaryLabel="Mulai Belajar" />
</BaseLayout>
<style>
  .vision,.profile{display:grid;grid-template-columns:1fr 1fr;gap:clamp(40px,8vw,110px);align-items:center}.values{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}.values article{position:relative;min-height:170px;padding:24px 18px;border:1px solid var(--line);border-radius:var(--radius-sm);background:white;box-shadow:var(--shadow-soft)}.values article:nth-child(even){background:var(--green-950);color:white;transform:translateY(18px)}.values article:nth-child(even) p{color:#bfd1c9}.values b{font-family:var(--font-display);font-size:1.35rem}.values p{margin:12px 0 0;font-size:.9rem}.portrait{min-height:460px;overflow:hidden;border:1px solid rgba(255,255,255,.15);border-radius:90px 22px 22px 22px;background:linear-gradient(145deg,#0b6d5c,#052c25)}.portrait img{display:block;width:100%;height:100%;min-height:460px;object-fit:cover;object-position:center 30%}@media(max-width:900px){.values{grid-template-columns:1fr 1fr}.vision,.profile{grid-template-columns:1fr}}@media(max-width:560px){.values{grid-template-columns:1fr}.values article:nth-child(even){transform:none}.portrait,.portrait img{min-height:360px}}
</style>
