---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Callout from '../components/Callout.astro';
---
<BaseLayout title="Tentang STIFIn Mulia" description="Mengenal visi, nilai, wilayah, serta pengelola STIFIn Mulia.">
  <PageHero eyebrow="Tentang Kami" title="Belajar, melayani, dan bertumbuh bersama" description="STIFIn Mulia menyediakan layanan tes, pembelajaran promotor, komunitas, dan kerja sama yang dijalankan dengan aturan jelas."></PageHero>
  <section class="section"><div class="container vision"><div><span class="eyebrow">Visi</span><h2>Lebih banyak orang mengenali potensi dirinya dan menggunakannya untuk memberi manfaat</h2></div><div><p class="lead">Kami membantu masyarakat mengenali potensi melalui layanan tes, penjelasan hasil, pembelajaran yang bertanggung jawab, dan pendampingan promotor.</p><div class="notice">STIFIn Mulia merupakan merek layanan yang dikelola Muhamad Sofyan AR. Lisensi, wilayah, harga, alat, sertifikasi, dan penggunaan merek tetap mengikuti ketentuan terbaru STIFIn Genetic Indonesia.</div></div></div></section>
  <section class="section soft"><div class="container"><div class="section-head"><div><span class="eyebrow">Nilai kerja</span><h2>Lima prinsip yang menjaga arah layanan</h2></div></div><div class="values"><article><b>Ilmu</b><p>Belajar sebelum menjelaskan.</p></article><article><b>Amanah</b><p>Jujur pada data dan batas layanan.</p></article><article><b>Adab</b><p>Menghormati perbedaan setiap manusia.</p></article><article><b>Sistem</b><p>Mengubah niat baik menjadi layanan yang teratur.</p></article><article><b>Manfaat</b><p>Menggunakan pengetahuan untuk mengambil langkah yang baik.</p></article></div></div></section>
  <section class="section dark"><div class="container profile"><div class="portrait"><span>MS</span></div><div><span class="eyebrow">Profil pengelola</span><h2>Muhamad Sofyan AR</h2><p class="lead">Branch Manager STIFIn Genetic Indonesia Cabang Pekalongan. Berdomisili dan menjalankan basis operasional di Bandung Raya.</p><p>Ia menempuh studi Ilmu Al-Qur’an dan Tafsir di UIN Bandung. Latar akademik tersebut ditempatkan sebagai sumber penguatan nilai, etika, amanah, dan refleksi. Bukan sebagai bukti ilmiah bagi metode STIFIn.</p><p>Fokus pengembangannya meliputi Bandung, Kabupaten Bandung, Bandung Barat, Cimahi, Sumedang, serta perluasan bertahap melalui mitra dan promotor lokal.</p></div></div></section>
  <Callout title="Terhubung dengan STIFIn Mulia" text="Pilih jalur tes, promotor, atau kemitraan sesuai kebutuhan Anda." message="Assalamu’alaikum, saya ingin mengenal layanan STIFIn Mulia lebih lanjut." secondaryHref="/artikel/" secondaryLabel="Baca Artikel" />
</BaseLayout>
<style>
  .vision,.profile{display:grid;grid-template-columns:1fr 1fr;gap:clamp(40px,8vw,110px);align-items:center}.values{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}.values article{padding:24px 18px;border:1px solid var(--line);border-radius:var(--radius-sm);background:white}.values p{margin:6px 0 0;font-size:.9rem}.portrait{display:grid;min-height:380px;place-items:center;border:1px solid rgba(255,255,255,.15);border-radius:var(--radius-lg);background:linear-gradient(145deg,#0b6d5c,#052c25)}.portrait span{display:grid;width:130px;aspect-ratio:1;place-items:center;border:1px solid rgba(255,255,255,.2);border-radius:50%;color:#bce070;font-family:Georgia,serif;font-size:2.6rem}@media(max-width:900px){.values{grid-template-columns:1fr 1fr}.vision,.profile{grid-template-columns:1fr}}@media(max-width:560px){.values{grid-template-columns:1fr}}
</style>
