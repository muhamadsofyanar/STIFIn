---
import BaseLayout from '../layouts/BaseLayout.astro';
import { waLink } from '../data/site';
const journeys = [
  { icon: '01', title: 'Saya mau Tes STIFIn', text: 'Temukan Mesin Kecerdasan Anda, pahami hasilnya, lalu gunakan sebagai panduan belajar, bekerja, dan berelasi.', href: '/tes-stifin/', cta: 'Lihat Cara Tes' },
  { icon: '02', title: 'Saya mau jadi promotor', text: 'Pelajari cara melayani tes, membangun pasar, memperoleh margin layanan, dan bertumbuh bersama komunitas.', href: '/jadi-promotor/', cta: 'Lihat Peluang Promotor' },
  { icon: '03', title: 'Saya membawa lembaga', text: 'Hadirkan seminar, tes kelompok, atau program pengembangan untuk sekolah, kampus, komunitas, dan tim kerja.', href: '/kerja-sama/', cta: 'Susun Program Bersama' },
];
---
<BaseLayout title="STIFIn Mulia | Tes, Promotor, dan Program Lembaga" description="Ikuti Tes STIFIn, pelajari Program Promotor, atau susun kegiatan untuk lembaga bersama STIFIn Mulia di Bandung Raya, Sumedang, dan jaringan layanan lainnya.">
  <section class="hero"><div class="container hero-grid"><div class="hero-copy"><span class="eyebrow">Kenal diri · Tumbuh · Berdampak</span><h1>Kenali potensi diri.<br /><em>Temukan cara terbaik untuk bertumbuh.</em></h1><p class="lead">Mulai dengan Tes STIFIn, pahami Mesin Kecerdasan Anda, lalu gunakan hasilnya untuk belajar lebih nyaman, bekerja lebih terarah, dan membangun hubungan yang lebih selaras.</p><div class="actions"><a class="button" data-wa-intent="beranda-cek-jadwal" href={waLink('Assalamu’alaikum, saya mau Tes STIFIn. Nama: ... Kota: ... Jumlah peserta: ...')} target="_blank" rel="noopener noreferrer">Saya Mau Tes STIFIn</a><a class="button secondary" href="#pilih-layanan">Lihat Pilihan Lain</a></div><p class="microcopy">Sebutkan kota dan jumlah peserta. Tim kami membantu memilih jadwal serta layanan yang paling pas.</p></div><div class="hero-visual" aria-label="Dokumentasi layanan STIFIn Mulia"><figure class="visual-main"><img src="/images/kegiatan/layanan-peserta.webp" width="1200" height="800" alt="Pendampingan peserta dalam kegiatan STIFIn Mulia" /><figcaption><span>Dari hasil menjadi langkah</span><strong>Tes, penjelasan, dan arah penerapan</strong></figcaption></figure><figure class="visual-small"><img src="/images/kegiatan/pembelajaran-promotor.webp" width="1200" height="800" alt="Pembelajaran promotor STIFIn" /></figure><div class="brand-stamp"><small>Berbasis di Bandung</small><strong>Terhubung<br />lintas kota</strong></div></div></div></section>

  <section class="section-tight"><div class="container proof-strip"><div><strong>Kenal diri lebih cepat</strong><span>Temukan Mesin Kecerdasan dan personaliti genetik Anda.</span></div><div><strong>Paham cara menerapkan</strong><span>Hubungkan hasil dengan belajar, karier, keluarga, dan relasi.</span></div><div><strong>Terhubung lintas kota</strong><span>Kami membantu mencarikan layanan melalui jaringan STIFIn.</span></div></div></section>

  <section id="pilih-layanan" class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Mulai dari tujuan Anda</span><h2>Anda ingin mengenal diri, membuka peluang, atau membawa manfaat lebih luas?</h2><p class="lead">Pilih jalur yang paling dekat dengan rencana Anda hari ini.</p></div></div><div class="grid-3">{journeys.map((item) => <article class="card"><span class="card-icon">{item.icon}</span><h3>{item.title}</h3><p>{item.text}</p><a class="text-link" href={item.href}>{item.cta} →</a></article>)}</div></div></section>

  <section class="section soft"><div class="container split"><div><span class="eyebrow">Satu hasil, banyak penerapan</span><h2>Lebih dari sekadar tahu tipe—Anda pulang membawa arah</h2><p class="lead">Hasil Tes STIFIn membantu Anda memahami cara menyerap informasi, mengambil keputusan, membangun relasi, dan mengembangkan kekuatan alami.</p><a class="button" href="/tes-stifin/">Temukan Manfaat Tes</a></div><ul class="check-list"><li><strong>Kenali pola belajar dan bekerja</strong><br />Temukan pendekatan yang terasa lebih alami untuk dijalankan.</li><li><strong>Pahami bahasa komunikasi</strong><br />Lihat mengapa diri, anak, pasangan, atau rekan merespons dengan cara berbeda.</li><li><strong>Pilih area yang ingin dikembangkan</strong><br />Arahkan pembahasan pada keluarga, profesi, bisnis, atau kepemimpinan.</li></ul></div></section>

  <section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Mudah untuk memulai</span><h2>Empat langkah menuju hasil Tes STIFIn Anda</h2></div></div><div class="steps"><article class="step"><h3>Sebutkan kota</h3><p>Kirim nama, kota, dan jumlah orang yang ingin mengikuti tes.</p></article><article class="step"><h3>Pilih jadwal</h3><p>Tim membantu mencocokkan waktu, lokasi, dan biaya tes.</p></article><article class="step"><h3>Ikuti tes</h3><p>Proses pemindaian sepuluh sidik jari dilakukan secara langsung.</p></article><article class="step"><h3>Kenali hasil Anda</h3><p>Dengarkan penjelasan dan temukan area penerapan yang paling relevan.</p></article></div></div></section>

  <section class="section dark"><div class="container founder-grid"><div class="portrait"><img src="/images/muhamad-sofyan-ar.webp" width="900" height="1200" alt="Muhamad Sofyan AR, pengelola STIFIn Mulia" loading="lazy" /></div><div><span class="eyebrow">Pengelola STIFIn Mulia</span><h2>Muhamad Sofyan AR</h2><p class="lead">Branch Manager STIFIn Genetic Indonesia Cabang Pekalongan yang tinggal dan menjalankan kegiatan utama di Bandung Raya. Saat ini menempuh studi Ilmu Al-Qur’an dan Tafsir di UIN Bandung.</p><p>STIFIn Mulia tergabung dalam jaringan STIFIn Genetic Indonesia. Layanan dijalankan dengan tiga pegangan: amanah, proses yang jelas, dan pembinaan yang dapat dilakukan bersama.</p><a class="button secondary" href="/tentang/">Kenali Pengelolanya</a></div></div></section>

  <section class="section network-section"><div class="container network-grid"><div><span class="eyebrow">Tes di kota Anda</span><h2>Tinggal di luar Bandung? Tetap bisa mulai dari sini</h2><p class="lead">Sebutkan kota Anda. STIFIn Mulia akan membantu menghubungkan Anda dengan jadwal dan layanan yang tersedia melalui jaringan STIFIn.</p><div class="actions"><a class="button" data-wa-intent="beranda-cari-promotor" href={waLink('Assalamu’alaikum, saya mau Tes STIFIn di kota saya. Nama: ... Kota/Kabupaten: ... Provinsi/Negara: ... Jumlah peserta: ...')} target="_blank" rel="noopener noreferrer">Cari Tes di Kota Saya</a><a class="button secondary" href="/jaringan-promotor/">Lihat Jangkauan Layanan</a></div></div><div class="coverage"><div><strong>Berbagai kota di Indonesia</strong><span>Pencarian melalui jaringan cabang dan promotor STIFIn</span></div><div><strong>Layanan luar Indonesia</strong><span>Tim membantu mengecek koneksi jaringan yang tersedia</span></div><div><strong>Satu kontak yang mudah</strong><span>Mulai percakapan melalui WhatsApp STIFIn Mulia</span></div></div></div></section>

  <section class="section soft"><div class="container"><div class="section-head"><div><span class="eyebrow">Dokumentasi kegiatan</span><h2>Lihat proses yang benar-benar dijalankan</h2><p class="lead">Foto kegiatan memperlihatkan pelaksanaan tes, pembelajaran, dan pertemuan jaringan—bukan foto stok yang menggantikan bukti proses.</p></div></div><div class="gallery"><figure><img src="/images/kegiatan/pelaksanaan-tes.webp" width="1200" height="800" alt="Pelaksanaan Tes STIFIn menggunakan alat pemindai" loading="lazy" /><figcaption>Pelaksanaan tes</figcaption></figure><figure><img src="/images/kegiatan/pembelajaran-promotor.webp" width="1200" height="800" alt="Kegiatan pembelajaran dan pengembangan promotor STIFIn" loading="lazy" /><figcaption>Pembelajaran promotor</figcaption></figure><figure><img src="/images/kegiatan/jaringan-promotor.webp" width="1200" height="800" alt="Pertemuan jaringan promotor dan pengelola STIFIn" loading="lazy" /><figcaption>Jaringan promotor</figcaption></figure><figure><img src="/images/kegiatan/pertemuan-jaringan.webp" width="1200" height="800" alt="Pertemuan pengelola STIFIn dengan jaringan mitra" loading="lazy" /><figcaption>Pertemuan jaringan</figcaption></figure></div></div></section>

  <section class="section"><div class="container final-cta"><span class="eyebrow">Siap mengenal diri lebih dekat?</span><h2>Mulai dengan satu pesan sederhana</h2><p>Kirim nama, kota, dan jumlah peserta. Tim STIFIn Mulia akan membantu menunjukkan langkah berikutnya.</p><div class="actions"><a class="button" data-wa-intent="beranda-final" href={waLink('Assalamu’alaikum, saya mau mulai mengenal layanan STIFIn Mulia. Nama: ... Kota: ... Saya tertarik pada: Tes STIFIn/Promotor/Program lembaga.')} target="_blank" rel="noopener noreferrer">Mulai via WhatsApp</a></div></div></section>
</BaseLayout>
<style>
  .hero{position:relative;overflow:hidden;padding:clamp(72px,10vw,130px) 0 105px;background:linear-gradient(120deg,#f7f8f4 0 61%,#e5efe8 61%)}.hero::before{position:absolute;top:-160px;left:-140px;width:390px;height:390px;border:1px solid rgba(4,63,43,.12);border-radius:50%;content:''}.hero::after{position:absolute;right:-90px;bottom:-190px;width:420px;height:420px;border:74px solid rgba(131,169,71,.09);border-radius:50%;content:''}.hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:1.03fr .97fr;align-items:center;gap:clamp(50px,7vw,90px)}.hero h1{max-width:820px;margin-bottom:25px;font-size:clamp(2.8rem,6.4vw,5.35rem);line-height:1.01;text-wrap:balance}.hero h1 em{color:var(--green-700);font-weight:500}.hero-copy{padding-block:20px}.hero-visual{position:relative;min-height:520px}.hero-visual figure{overflow:hidden;margin:0;background:var(--green-950);box-shadow:var(--shadow)}.hero-visual img{width:100%;height:100%;object-fit:cover}.visual-main{position:absolute;top:0;right:0;width:86%;height:440px;border-radius:120px 24px 24px 24px}.visual-main::after{position:absolute;inset:0;background:linear-gradient(transparent 50%,rgba(3,38,26,.78));content:''}.visual-main figcaption{position:absolute;z-index:1;right:26px;bottom:25px;left:26px;color:white}.visual-main figcaption span,.visual-main figcaption strong{display:block}.visual-main figcaption span{margin-bottom:5px;color:#cfdfa8;font-size:.72rem;font-weight:850;letter-spacing:.12em;text-transform:uppercase}.visual-main figcaption strong{font-family:var(--font-display);font-size:1.45rem}.visual-small{position:absolute;z-index:2;bottom:0;left:0;width:44%;height:190px;border:7px solid var(--paper);border-radius:18px}.brand-stamp{position:absolute;z-index:3;right:-5px;bottom:5px;padding:19px 22px;border-radius:16px 0 16px 16px;background:var(--green-950);color:white;box-shadow:var(--shadow)}.brand-stamp small,.brand-stamp strong{display:block}.brand-stamp small{margin-bottom:5px;color:#b8cfae;font-size:.7rem;font-weight:800;text-transform:uppercase}.brand-stamp strong{font-family:var(--font-display);font-size:1.15rem;line-height:1.15}.text-link{color:var(--green-800);font-weight:800}.founder-grid{display:grid;grid-template-columns:.9fr 1.1fr;align-items:center;gap:clamp(40px,8vw,100px)}.portrait{min-height:400px;overflow:hidden;border:1px solid rgba(255,255,255,.14);border-radius:var(--radius-lg);background:linear-gradient(145deg,#0b6d5c,#052c25)}.portrait img{width:100%;height:100%;min-height:400px;object-fit:cover;object-position:center 30%}.founder-grid .button{margin-top:16px}.network-section{background:linear-gradient(145deg,#f7fbf8,#edf7f1)}.network-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(35px,7vw,90px);align-items:center}.coverage{display:grid;gap:12px}.coverage div{padding:24px;border:1px solid var(--line);border-radius:var(--radius-sm);background:white;box-shadow:var(--shadow-soft)}.coverage strong,.coverage span{display:block}.coverage strong{margin-bottom:5px;color:var(--green-950);font-size:1.1rem}.coverage span{color:var(--muted);font-size:.9rem}.gallery{display:grid;grid-template-columns:1.15fr .85fr;grid-auto-rows:260px;gap:18px}.gallery figure{position:relative;overflow:hidden;margin:0;border-radius:var(--radius);background:var(--green-950)}.gallery figure:first-child{grid-row:span 2}.gallery img{width:100%;height:100%;object-fit:cover;transition:transform .35s ease}.gallery figure:hover img{transform:scale(1.025)}.gallery figcaption{position:absolute;right:14px;bottom:14px;padding:8px 12px;border-radius:10px;background:rgba(4,63,43,.92);color:white;font-size:.8rem;font-weight:800}.final-cta{position:relative;overflow:hidden;padding:clamp(45px,8vw,80px);border:1px solid var(--line);border-radius:var(--radius-lg);background:linear-gradient(135deg,white,#eff5ef);text-align:center;box-shadow:var(--shadow)}.final-cta::before{position:absolute;top:-55px;left:-55px;width:140px;height:140px;border:28px solid var(--green-100);border-radius:50%;content:''}.final-cta p{max-width:700px;margin-inline:auto}.final-cta .actions{justify-content:center}@media(max-width:900px){.hero{background:linear-gradient(155deg,#f7f8f4 0 58%,#e5efe8 58%)}.hero-grid,.founder-grid,.network-grid{grid-template-columns:1fr}.hero-visual{min-height:520px}.founder-grid .portrait{min-height:300px}}@media(max-width:620px){.hero{padding-top:58px}.hero h1{font-size:clamp(2.55rem,13vw,4rem)}.hero-visual{min-height:410px}.visual-main{width:94%;height:355px;border-radius:70px 18px 18px 18px}.visual-small{width:46%;height:140px}.brand-stamp{right:0;bottom:5px;padding:15px}.gallery{grid-template-columns:1fr;grid-auto-rows:220px}.gallery figure:first-child{grid-row:auto}}
</style>
