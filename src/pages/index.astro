---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CentralProof from '../components/CentralProof.astro';
import ProofNavigator from '../components/ProofNavigator.astro';
import VisitorConcierge from '../components/VisitorConcierge.astro';
import NeedDiscovery from '../components/NeedDiscovery.astro';
const allArticles = (await getCollection('articles', ({ data }) => !data.draft)).sort((a,b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const articles = allArticles.slice(0,3);
const stages = [
  { number: '01', label: 'Mulai dari tes', title: 'Kenali pola diri', text: 'Tes menjadi pintu masuk untuk mengenali Mesin Kecerdasan dan personaliti genetik Anda.' },
  { number: '02', label: 'Pahami hasil', title: 'Hubungkan dengan hidup nyata', text: 'Bawa pertanyaan tentang belajar, keluarga, pekerjaan, bisnis, atau relasi ke sesi penjelasan.' },
  { number: '03', label: 'Dalami lewat WSL 1', title: 'Belajar membaca perbedaan', text: 'Bangun fondasi konsep agar hasil tes tidak berhenti sebagai label, tetapi menjadi bahasa pertumbuhan.' },
  { number: '04', label: 'Bertumbuh menjadi promotor', title: 'Bagikan manfaat lebih luas', text: 'Setelah memahami konsep, pelajari jalur promotor untuk melayani tes dan mengembangkan jaringan.' },
];
---
<BaseLayout title="STIFIn Mulia | Gerakan 100 Tes STIFIn" description="Mulai Tes STIFIn, pahami hasilnya, lanjutkan melalui WSL 1, dan bertumbuh menjadi promotor bersama STIFIn Mulia.">
  <section class="hero"><div class="container hero-grid"><div class="hero-copy"><span class="eyebrow">Gerakan 100 Tes STIFIn</span><h1>Kenali pola diri.<br /><em>Mulai langkah yang lebih berarti.</em></h1><p class="lead">Kami ingin membantu lebih banyak orang berhenti menebak-nebak dirinya. Mulailah dari Tes STIFIn, pahami cara kerja diri Anda, lalu susun langkah nyata untuk belajar, bekerja, berkeluarga, dan bertumbuh.</p><div class="actions"><a class="button" data-funnel-stage="tes" href="/ikut-tes-stifin/#daftar">Saya Mau Tes STIFIn</a><a class="button secondary" href="/langkah-selanjutnya/">Pilih Langkah Saya</a></div><p class="microcopy">Isi nama, WhatsApp, kota, dan kebutuhan Anda. Tim membantu mengecek jadwal, lokasi, serta langkah berikutnya.</p></div><div class="hero-visual"><figure class="visual-main"><img src="/images/kegiatan/layanan-peserta.webp" width="1200" height="800" alt="Pendampingan peserta STIFIn Mulia" /><figcaption><span>Tes adalah awal</span><strong>Kenal diri, belajar, lalu berdampak</strong></figcaption></figure><figure class="visual-small"><img src="/images/kegiatan/pelaksanaan-tes.webp" width="1200" height="800" alt="Pelaksanaan Tes STIFIn" /></figure><div class="brand-stamp"><small>Satu gerakan</small><strong>100 orang<br />lebih mengenal diri</strong></div></div></div></section>

  <section class="section-tight"><div class="container proof-strip"><div><strong>Prosesnya jelas</strong><span>Mulai dari konsultasi, tes, hingga penjelasan hasil.</span></div><div><strong>Hasilnya dibawa ke kehidupan</strong><span>Bahas belajar, keluarga, profesi, bisnis, dan relasi.</span></div><div><strong>Bisa bertumbuh lebih jauh</strong><span>Lanjutkan ke WSL 1 dan jalur promotor saat Anda siap.</span></div></div></section>

  <section class="section journey-invite"><div class="container journey-invite-grid"><div><span class="eyebrow">Baru di STIFIn Mulia</span><h2>Belum tahu harus mulai dari tes, belajar, atau promotor?</h2><p class="lead">Jawab empat pertanyaan singkat. Anda langsung mendapat jalur personal, tiga bacaan pilihan, dan langkah yang dapat dilakukan sesuai kesiapan.</p><a class="button" href="/perjalanan/">Temukan Langkah Saya</a></div><div class="journey-preview"><span>01 · Pilih kebutuhan</span><span>02 · Tentukan untuk siapa</span><span>03 · Pilih kesiapan</span><strong>04 · Dapatkan rekomendasi</strong></div></div></section>

  <VisitorConcierge />

  <section class="section-tight decision-invite"><div class="container decision-invite-inner"><div><span>Masih menimbang?</span><strong>Pelajari kapan tes relevan, kapan sebaiknya belajar dahulu, dan apa perbedaan setiap tahap.</strong></div><a href="/apakah-tes-stifin-cocok-untuk-saya/">Buka Pusat Keputusan →</a></div></section>

  <section class="section movement"><div class="container movement-grid"><div><span class="eyebrow">Mengapa gerakan ini hadir</span><h2>Banyak orang bekerja keras, tetapi belum memahami cara terbaik dirinya bergerak</h2></div><div><p class="lead">Ketika cara belajar, cara berkomunikasi, atau arah profesi terasa selalu dipaksakan, masalahnya belum tentu kurang kemampuan. Bisa jadi pendekatan yang dipakai tidak selaras dengan pola diri.</p><p>Gerakan 100 Tes STIFIn mengajak keluarga, pendidik, profesional, dan calon promotor memulai dari satu fondasi: mengenali diri sebelum menentukan strategi. Target 100 bukan sekadar angka; setiap peserta diharapkan pulang membawa satu pemahaman baru dan satu langkah yang dapat dijalankan.</p><a class="text-link" href="/tes-stifin/">Pelajari proses Tes STIFIn →</a></div></div></section>

  <NeedDiscovery articles={allArticles} compact={true} />

  <ProofNavigator compact />
  <CentralProof mode="home" />

  <section class="section soft"><div class="container"><div class="section-head"><div><span class="eyebrow">Satu perjalanan pertumbuhan</span><h2>Dari mengenal diri sampai membantu orang lain</h2><p class="lead">Anda tidak harus memutuskan semuanya hari ini. Mulai dari tes, alami manfaatnya, lalu lanjutkan sesuai kesiapan.</p></div></div><div class="growth-path">{stages.map((stage) => <article><span>{stage.number}</span><small>{stage.label}</small><h3>{stage.title}</h3><p>{stage.text}</p></article>)}</div></div></section>

  <section class="section"><div class="container split"><div><span class="eyebrow">Hasil yang dapat ditindaklanjuti</span><h2>Tes selesai dalam satu sesi. Manfaatnya bertumbuh saat diterapkan.</h2><p class="lead">Hasil tes membantu Anda mempunyai bahasa untuk membaca kecenderungan diri. Penjelasan dan pembelajaran lanjutan membantu bahasa itu menjadi keputusan yang lebih matang.</p><a class="button" href="/tes-stifin/">Lihat Manfaat dan Proses Tes</a></div><ul class="check-list"><li><strong>Belajar dan bekerja lebih sadar</strong><br />Pilih cara menyerap informasi dan membangun kebiasaan yang lebih mudah dijalankan.</li><li><strong>Berkomunikasi dengan lebih selaras</strong><br />Pahami mengapa anak, pasangan, rekan, atau tim memerlukan pendekatan berbeda.</li><li><strong>Menentukan langkah pengembangan</strong><br />Gunakan hasil sebagai peta awal, lalu uji penerapannya melalui tindakan nyata.</li></ul></div></section>

  <section class="section wsl"><div class="container wsl-grid"><div class="wsl-photo"><img src="/images/kegiatan/pembelajaran-promotor.webp" width="1200" height="800" alt="Pembelajaran WSL dan promotor STIFIn" loading="lazy" /></div><div><span class="eyebrow">Setelah tes, jangan berhenti di hasil</span><h2>WSL 1 membantu Anda memahami bahasa dasar STIFIn</h2><p class="lead">Tes memberi tahu hasil Anda. WSL 1 membantu Anda melihat hubungan antarpola, memahami perbedaan, dan menggunakan konsep secara lebih utuh.</p><p>Program ini cocok bagi peserta tes yang ingin menerapkan STIFIn dalam keluarga atau pekerjaan, sekaligus menjadi fondasi bagi mereka yang mulai mempertimbangkan jalur promotor.</p><div class="actions"><a class="button" data-funnel-stage="wsl1" href="/wsl-1/">Kenali WSL 1</a><a class="button secondary" data-funnel-stage="promotor" href="/jadi-promotor/">Lihat Perjalanan Promotor</a></div></div></div></section>

  <section class="section dark"><div class="container founder-grid"><div class="portrait"><img src="/images/muhamad-sofyan-ar.webp" width="900" height="1200" alt="Muhamad Sofyan AR, pengelola STIFIn Mulia" loading="lazy" /></div><div><span class="eyebrow">Pengelola STIFIn Mulia</span><h2>Muhamad Sofyan AR</h2><p class="lead">Branch Manager STIFIn Genetic Indonesia Cabang Pekalongan yang menjalankan kegiatan utama di Bandung Raya dan terhubung dengan jaringan lintas kota.</p><p>STIFIn Mulia dibangun untuk memperbanyak orang yang merasakan manfaat tes, memperkuat pembelajaran WSL 1, dan menumbuhkan promotor yang aktif melayani—dengan proses yang jelas dan pendampingan berkelanjutan.</p><a class="button secondary" href="/tentang/">Kenali STIFIn Mulia</a></div></div></section>

  <section class="section knowledge"><div class="container"><div class="section-head"><div><span class="eyebrow">Pusat pengetahuan STIFIn Mulia</span><h2>Bukan hanya mengenal tipe, tetapi belajar menjalani hidup dengan lebih sadar</h2><p class="lead">Artikel kami menghubungkan konsep dengan persoalan nyata. Ruang Tafsir Al-Qamar disajikan sebagai kajian dan refleksi tersendiri, bukan sebagai pembuktian ilmiah atas STIFIn.</p></div><a class="text-link" href="/artikel/">Lihat semua artikel →</a></div><div class="article-teasers">{articles.map((article) => <article><small>{article.data.category} · {article.data.readingTime} menit</small><h3><a href={`/artikel/${article.id}/`}>{article.data.title}</a></h3><p>{article.data.description}</p><a class="text-link" href={`/artikel/${article.id}/`}>Baca selengkapnya →</a></article>)}</div></div></section>

  <section class="section network-section"><div class="container network-grid"><div><span class="eyebrow">Tes di kota Anda</span><h2>Di mana pun Anda berada, percakapan bisa dimulai dari sini</h2><p class="lead">Sebutkan kota dan jumlah peserta. Tim STIFIn Mulia membantu mengecek jadwal melalui jaringan yang tersedia tanpa membatasi Anda pada satu wilayah utama.</p><div class="actions"><a class="button" data-wa-intent="beranda-cari-tes" href="/ikut-tes-stifin/#daftar">Cari Tes di Kota Saya</a><a class="button secondary" href="/jaringan-promotor/">Lihat Jangkauan Layanan</a></div></div><div class="coverage"><div><strong>Bandung Raya dan sekitarnya</strong><span>Koordinasi kegiatan utama STIFIn Mulia</span></div><div><strong>Berbagai kota di Indonesia</strong><span>Pencarian melalui jaringan cabang dan promotor</span></div><div><strong>Luar Indonesia</strong><span>Pengecekan koneksi jaringan berdasarkan ketersediaan</span></div></div></div></section>

  <section class="section"><div class="container final-cta"><span class="eyebrow">Mulai dari satu keputusan sederhana</span><h2>Jangan hanya penasaran. Kenali pola diri Anda.</h2><p>Isi data singkat agar tim STIFIn Mulia dapat membantu menyiapkan langkah tes yang paling memungkinkan.</p><div class="actions"><a class="button" data-wa-intent="beranda-final-tes" href="/ikut-tes-stifin/#daftar">Saya Mau Tes STIFIn</a></div></div></section>
</BaseLayout>
<style>
  .hero{position:relative;overflow:hidden;padding:clamp(72px,10vw,130px) 0 105px;background:linear-gradient(120deg,#f7f8f4 0 61%,#e5efe8 61%)}.hero::after{position:absolute;right:-90px;bottom:-190px;width:420px;height:420px;border:74px solid rgba(131,169,71,.09);border-radius:50%;content:''}.hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:1.03fr .97fr;align-items:center;gap:clamp(50px,7vw,90px)}.hero h1{max-width:820px;margin-bottom:25px;font-size:clamp(2.8rem,6.4vw,5.35rem);line-height:1.01;text-wrap:balance}.hero h1 em{color:var(--green-700);font-weight:500}.hero-visual{position:relative;min-height:520px}.hero-visual figure{overflow:hidden;margin:0;background:var(--green-950);box-shadow:var(--shadow)}.hero-visual img{width:100%;height:100%;object-fit:cover}.visual-main{position:absolute;top:0;right:0;width:86%;height:440px;border-radius:120px 24px 24px 24px}.visual-main::after{position:absolute;inset:0;background:linear-gradient(transparent 50%,rgba(3,38,26,.78));content:''}.visual-main figcaption{position:absolute;z-index:1;right:26px;bottom:25px;left:26px;color:white}.visual-main figcaption span,.visual-main figcaption strong{display:block}.visual-main figcaption span{color:#cfdfa8;font-size:.72rem;font-weight:850;letter-spacing:.12em;text-transform:uppercase}.visual-main figcaption strong{font-family:var(--font-display);font-size:1.45rem}.visual-small{position:absolute;z-index:2;bottom:0;left:0;width:44%;height:190px;border:7px solid var(--paper);border-radius:18px}.brand-stamp{position:absolute;z-index:3;right:-5px;bottom:5px;padding:19px 22px;border-radius:16px 0 16px 16px;background:var(--green-950);color:white;box-shadow:var(--shadow)}.brand-stamp small,.brand-stamp strong{display:block}.brand-stamp small{color:#b8cfae;font-size:.7rem;font-weight:800;text-transform:uppercase}.brand-stamp strong{font-family:var(--font-display);line-height:1.2}.movement-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(45px,8vw,100px)}.text-link{color:var(--green-800);font-weight:800}.growth-path{display:grid;grid-template-columns:repeat(4,1fr);gap:2px;background:var(--line);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}.growth-path article{position:relative;padding:30px 25px;background:white}.growth-path article span{display:grid;width:42px;height:42px;place-items:center;border-radius:50%;background:var(--green-100);color:var(--green-800);font-weight:900}.growth-path article small{display:block;margin:28px 0 8px;color:var(--green-700);font-weight:850;text-transform:uppercase;letter-spacing:.08em}.growth-path article p{font-size:.9rem}.wsl{background:linear-gradient(140deg,#edf5ef,#dceade)}.wsl-grid,.founder-grid,.network-grid{display:grid;grid-template-columns:.9fr 1.1fr;align-items:center;gap:clamp(40px,8vw,100px)}.wsl-photo,.portrait{overflow:hidden;border-radius:var(--radius-lg);box-shadow:var(--shadow)}.wsl-photo img,.portrait img{width:100%;min-height:410px;object-fit:cover}.portrait img{object-position:center 30%}.article-teasers{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.article-teasers article{padding:28px;border:1px solid var(--line);border-radius:var(--radius);background:white;box-shadow:var(--shadow-soft)}.article-teasers small{color:var(--green-700);font-weight:800}.article-teasers h3{margin:16px 0}.network-section{background:linear-gradient(145deg,#f7fbf8,#edf7f1)}.network-grid{grid-template-columns:1.15fr .85fr}.coverage{display:grid;gap:12px}.coverage div{padding:24px;border:1px solid var(--line);border-radius:var(--radius-sm);background:white}.coverage strong,.coverage span{display:block}.coverage span{color:var(--muted);font-size:.9rem}.final-cta{padding:clamp(45px,8vw,80px);border:1px solid var(--line);border-radius:var(--radius-lg);background:linear-gradient(135deg,white,#eff5ef);text-align:center;box-shadow:var(--shadow)}.final-cta p{max-width:700px;margin-inline:auto}.final-cta .actions{justify-content:center}@media(max-width:950px){.hero-grid,.movement-grid,.wsl-grid,.founder-grid,.network-grid{grid-template-columns:1fr}.growth-path{grid-template-columns:1fr 1fr}.article-teasers{grid-template-columns:1fr}.hero-visual{min-height:500px}}@media(max-width:620px){.hero{padding-top:58px}.hero h1{font-size:clamp(2.55rem,13vw,4rem)}.hero-visual{min-height:410px}.visual-main{width:94%;height:355px;border-radius:70px 18px 18px 18px}.visual-small{width:46%;height:140px}.brand-stamp{padding:14px}.growth-path{grid-template-columns:1fr}}
</style>
<style>
  .journey-invite{background:var(--green-950);color:#fff}.journey-invite p{color:#c5d9d1}.journey-invite-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(40px,8vw,90px);align-items:center}.journey-preview{display:grid;gap:2px;overflow:hidden;border-radius:20px;background:rgba(255,255,255,.12)}.journey-preview span,.journey-preview strong{padding:20px 24px;background:rgba(255,255,255,.07)}.journey-preview strong{background:var(--amber-500);color:#17241d}@media(max-width:950px){.journey-invite-grid{grid-template-columns:1fr}}
  .decision-invite{border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:#fff}.decision-invite-inner{display:flex;align-items:center;justify-content:space-between;gap:28px}.decision-invite-inner div{display:grid}.decision-invite-inner span{color:var(--green-700);font-size:.76rem;font-weight:900;text-transform:uppercase;letter-spacing:.1em}.decision-invite-inner strong{font-family:var(--font-display);font-size:1.25rem}.decision-invite-inner a{flex:0 0 auto;color:var(--green-800);font-weight:850}@media(max-width:700px){.decision-invite-inner{align-items:flex-start;flex-direction:column}}
</style>
