---
import BaseLayout from '../layouts/BaseLayout.astro';
import { waLink } from '../data/site';
const journeys = [
  { icon: '01', title: 'Ikuti Tes STIFIn', text: 'Kenali kecenderungan diri dan pahami hasilnya melalui sesi konsultasi.', href: '/tes-stifin/', cta: 'Lihat Cara Tes' },
  { icon: '02', title: 'Jadi Promotor STIFIn', text: 'Ikuti pembelajaran, dapatkan alat tes, dan mulai melayani peserta dengan pendampingan.', href: '/jadi-promotor/', cta: 'Lihat Biaya dan Program' },
  { icon: '03', title: 'Adakan Program Bersama', text: 'Buat kegiatan untuk sekolah, kampus, keluarga, komunitas, atau organisasi Anda.', href: '/kerja-sama/', cta: 'Ajukan Program' },
];
---
<BaseLayout>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">Tes, Belajar, dan Bertumbuh</span>
        <h1>Kenali potensi.<br /><em>Tentukan langkah.</em></h1>
        <p class="lead">STIFIn Mulia membantu Anda mengikuti Tes STIFIn, memahami hasilnya, menjadi promotor, dan mengadakan program bersama sekolah, kampus, komunitas, atau lembaga.</p>
        <div class="actions">
          <a class="button" href={waLink('Assalamu’alaikum, saya ingin berkonsultasi dan mendaftar Tes STIFIn.')} target="_blank" rel="noreferrer">Daftar Tes STIFIn</a>
          <a class="button secondary" href="/jadi-promotor/">Jelajahi Peluang Promotor</a>
        </div>
        <div class="trust"><span>Pendaftaran mudah</span><span>Tes dilakukan langsung</span><span>Ada konsultasi hasil</span></div>
      </div>
      <div class="hero-visual" aria-label="Layanan STIFIn Mulia">
        <div class="orbit"><b>Potensi</b><span>Ilmu</span><span>Sistem</span><span>Nilai</span><span>Komunitas</span></div>
        <div class="mini-card"><small>Wilayah utama</small><strong>Bandung Raya<br />dan Sumedang</strong></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><div><span class="eyebrow">Anda ingin mulai dari mana?</span><h2>Pilih layanan sesuai kebutuhan Anda</h2><p class="lead">Informasi tes, promotor, dan kerja sama tersedia dalam halaman yang berbeda agar mudah dipahami.</p></div></div>
      <div class="grid-3">
        {journeys.map((item) => <article class="card"><span class="card-icon">{item.icon}</span><h3>{item.title}</h3><p>{item.text}</p><a class="text-link" href={item.href}>{item.cta} →</a></article>)}
      </div>
    </div>
  </section>

  <section class="section soft">
    <div class="container about-grid">
      <div><span class="eyebrow">Tidak berhenti pada hasil tes</span><h2>Pahami hasilnya, lalu tentukan langkah berikutnya</h2></div>
      <div><p class="lead">Setelah tes, Anda tidak hanya menerima hasil. Kami membantu menjelaskannya dan mendiskusikan penerapannya untuk belajar, keluarga, pekerjaan, atau pengembangan diri.</p><div class="notice">Tes STIFIn bukan pemeriksaan medis atau psikologis. Penjelasan hasil selalu ditempatkan dalam konsep STIFIn.</div></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><div><span class="eyebrow">Cara mengikuti tes</span><h2>Empat langkah yang mudah diikuti</h2></div><a class="button secondary" href="/tes-stifin/">Lihat penjelasan lengkap</a></div>
      <div class="steps"><article class="step"><h3>Hubungi kami</h3><p>Ceritakan kebutuhan dan kota tempat Anda tinggal.</p></article><article class="step"><h3>Pilih jadwal</h3><p>Tentukan waktu dan lokasi tes yang tersedia.</p></article><article class="step"><h3>Datang untuk tes</h3><p>Proses tes dilakukan secara langsung sesuai ketentuan.</p></article><article class="step"><h3>Pahami hasil</h3><p>Ikuti konsultasi hasil dan diskusikan langkah selanjutnya.</p></article></div>
    </div>
  </section>

  <section class="section dark">
    <div class="container founder-grid">
      <div class="portrait"><img src="/images/muhamad-sofyan-ar.webp" width="900" height="1200" alt="Muhamad Sofyan AR, pengelola STIFIn Mulia" loading="lazy" /></div>
      <div><span class="eyebrow">Pengelola STIFIn Mulia</span><h2>Muhamad Sofyan AR</h2><p class="lead">Branch Manager STIFIn Genetic Indonesia Cabang Pekalongan yang tinggal dan menjalankan kegiatan utama di Bandung Raya. Saat ini menempuh studi Ilmu Al-Qur’an dan Tafsir di UIN Bandung.</p><p>STIFIn Mulia tergabung dalam jaringan STIFIn Genetic Indonesia. Layanan dijalankan dengan tiga pegangan: amanah, sistem kerja yang jelas, dan pembinaan yang dapat dilakukan bersama.</p><a class="button secondary" href="/tentang/">Kenali STIFIn Mulia</a></div>
    </div>
  </section>

  <section class="section network-section">
    <div class="container network-grid">
      <div><span class="eyebrow">Jaringan layanan</span><h2>Tinggal di luar Bandung? Kami bantu carikan promotor</h2><p class="lead">STIFIn Mulia terhubung dengan kepala cabang dan promotor di berbagai wilayah Indonesia serta luar negeri. Sampaikan kota Anda melalui WhatsApp. Tim akan memeriksa ketersediaan dan menghubungkan Anda dengan promotor yang sesuai.</p><div class="actions"><a class="button" href={waLink('Assalamu’alaikum, saya ingin Tes STIFIn dan membutuhkan promotor di wilayah: ... Kota/Kabupaten: ... Provinsi/Negara: ...')} target="_blank" rel="noreferrer">Cari Promotor via WhatsApp</a><a class="button secondary" href="/jaringan-promotor/">Lihat Jaringan Layanan</a></div></div>
      <div class="coverage"><div><strong>Indonesia</strong><span>Pencarian berdasarkan kota dan provinsi</span></div><div><strong>Luar negeri</strong><span>Ketersediaan diperiksa melalui jaringan promotor</span></div><div><strong>Satu pintu</strong><span>Semua permintaan masuk melalui STIFIn Mulia</span></div></div>
    </div>
  </section>

  <section class="section soft">
    <div class="container"><div class="section-head"><div><span class="eyebrow">Dokumentasi nyata</span><h2>Kegiatan tes, pembelajaran, dan jaringan</h2><p class="lead">Dokumentasi kegiatan menunjukkan proses layanan dan pembinaan yang telah dijalankan.</p></div></div><div class="gallery"><figure><img src="/images/kegiatan/pelaksanaan-tes.webp" width="1200" height="800" alt="Pelaksanaan Tes STIFIn menggunakan alat pemindai" loading="lazy" /><figcaption>Pelaksanaan tes</figcaption></figure><figure><img src="/images/kegiatan/pembelajaran-promotor.webp" width="1200" height="800" alt="Kegiatan pembelajaran dan pengembangan promotor STIFIn" loading="lazy" /><figcaption>Pembelajaran promotor</figcaption></figure><figure><img src="/images/kegiatan/jaringan-promotor.webp" width="1200" height="800" alt="Pertemuan jaringan promotor dan pengelola STIFIn" loading="lazy" /><figcaption>Jaringan promotor</figcaption></figure><figure><img src="/images/kegiatan/pertemuan-jaringan.webp" width="1200" height="800" alt="Pertemuan pengelola STIFIn dengan jaringan mitra" loading="lazy" /><figcaption>Pertemuan jaringan</figcaption></figure></div></div>
  </section>

  <section class="section">
    <div class="container final-cta"><span class="eyebrow">Mulai dari satu percakapan</span><h2>Apa yang ingin Anda mulai?</h2><p>Kami akan membantu memilih langkah pertama yang sesuai.</p><div class="actions"><a class="button" href={waLink('Assalamu’alaikum, saya ingin berkonsultasi dengan tim STIFIn Mulia.')} target="_blank" rel="noreferrer">Konsultasi via WhatsApp</a><a class="button secondary" href="/kerja-sama/">Ajukan Program Bersama</a></div></div>
  </section>
</BaseLayout>
<style>
  .hero { position: relative; overflow: hidden; padding: clamp(72px, 10vw, 130px) 0 94px; background: radial-gradient(circle at 78% 20%, #d7ecd9 0, transparent 31%), linear-gradient(140deg, #fbfcfa 50%, #eef6f1); }
  .hero::after { position: absolute; right: -10vw; bottom: -40vw; width: 70vw; height: 70vw; border: 1px solid rgba(10,103,87,.13); border-radius: 50%; content: ''; }
  .hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1.12fr .88fr; align-items: center; gap: 70px; }
  h1 { max-width: 760px; margin-bottom: 25px; }
  h1 em { color: var(--green-700); font-family: Georgia, serif; font-weight: 500; }
  .trust { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 34px; color: var(--muted); font-size: .85rem; font-weight: 700; }
  .trust span::before { margin-right: 7px; color: var(--lime-500); content: '●'; }
  .hero-visual { position: relative; display: grid; min-height: 470px; place-items: center; }
  .orbit { position: relative; display: grid; width: min(72vw, 390px); aspect-ratio: 1; place-items: center; border: 1px solid rgba(10,103,87,.22); border-radius: 50%; background: rgba(255,255,255,.62); box-shadow: var(--shadow); }
  .orbit::before { position: absolute; width: 64%; aspect-ratio: 1; border: 1px dashed rgba(10,103,87,.28); border-radius: 50%; content: ''; }
  .orbit b { z-index: 2; display: grid; width: 122px; aspect-ratio: 1; place-items: center; border-radius: 50%; background: var(--green-950); color: white; font-size: 1.2rem; }
  .orbit span { position: absolute; padding: 7px 13px; border: 1px solid var(--line); border-radius: 999px; background: white; color: var(--green-900); font-size: .8rem; font-weight: 800; }
  .orbit span:nth-of-type(1) { top: 13%; left: 12%; }.orbit span:nth-of-type(2) { top: 15%; right: 8%; }.orbit span:nth-of-type(3) { right: 6%; bottom: 16%; }.orbit span:nth-of-type(4) { bottom: 13%; left: 5%; }
  .mini-card { position: absolute; right: -10px; bottom: 20px; padding: 18px 20px; border-radius: 18px; background: var(--amber-500); box-shadow: var(--shadow); }
  .mini-card small, .mini-card strong { display: block; }.mini-card small { margin-bottom: 5px; color: #654100; font-weight: 700; }
  .text-link { color: var(--green-800); font-weight: 800; }
  .about-grid, .founder-grid { display: grid; grid-template-columns: .9fr 1.1fr; align-items: center; gap: clamp(40px, 8vw, 100px); }
  .portrait { min-height: 400px; overflow:hidden; border: 1px solid rgba(255,255,255,.14); border-radius: var(--radius-lg); background: linear-gradient(145deg, #0b6d5c, #052c25); }
  .portrait img{display:block;width:100%;height:100%;min-height:400px;object-fit:cover;object-position:center 30%}
  .founder-grid .button { margin-top: 16px; }
  .network-section{background:linear-gradient(145deg,#f7fbf8,#edf7f1)}.network-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(35px,7vw,90px);align-items:center}.coverage{display:grid;gap:12px}.coverage div{padding:24px;border:1px solid var(--line);border-radius:var(--radius-sm);background:white}.coverage strong,.coverage span{display:block}.coverage strong{margin-bottom:5px;color:var(--green-950);font-size:1.1rem}.coverage span{color:var(--muted);font-size:.9rem}.gallery{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}.gallery figure{position:relative;overflow:hidden;margin:0;border-radius:var(--radius);background:var(--green-950)}.gallery img{display:block;width:100%;aspect-ratio:3/2;object-fit:cover;transition:transform .35s ease}.gallery figure:hover img{transform:scale(1.025)}.gallery figcaption{position:absolute;right:14px;bottom:14px;padding:8px 12px;border-radius:999px;background:rgba(6,60,50,.9);color:white;font-size:.8rem;font-weight:800}
  .final-cta { padding: clamp(45px, 8vw, 80px); border: 1px solid var(--line); border-radius: var(--radius-lg); background: white; text-align: center; box-shadow: var(--shadow); }
  .final-cta .actions { justify-content: center; }
  @media (max-width: 900px) { .hero-grid, .about-grid, .founder-grid,.network-grid { grid-template-columns: 1fr; } .hero-visual { min-height: 380px; } .founder-grid .portrait { min-height: 300px; } }
  @media (max-width: 620px) { .hero { padding-top: 58px; } .hero-visual { min-height: 310px; } .mini-card { right: 0; bottom: -2px; } .trust { gap: 9px 16px; }.gallery{grid-template-columns:1fr} }
</style>
