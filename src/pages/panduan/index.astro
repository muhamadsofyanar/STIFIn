---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { pillars } from '../../data/knowledge-architecture';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Panduan Utama STIFIn Mulia',
  description: 'Panduan pilar tentang STIFIn, tes, keluarga, belajar, profesi, bisnis, promotor, dan Surah Al-Qamar.',
  hasPart: pillars.map((pillar) => ({
    '@type': 'WebPage',
    name: pillar.title,
    description: pillar.keyAnswer,
    url: new URL(`/panduan/${pillar.slug}/`, Astro.site).toString(),
  })),
};
---
<BaseLayout title="Panduan Utama STIFIn Mulia | Belajar dari Fondasi" description="Jelajahi panduan lengkap tentang konsep STIFIn, proses tes, anak dan belajar, keluarga, profesi, bisnis, WSL 1, promotor, dan Ruang Tafsir Al-Qamar." schema={schema}>
  <PageHero eyebrow="Peta pengetahuan STIFIn Mulia" title="Jangan mulai dari artikel acak. Mulailah dari peta besarnya." description="Setiap panduan menghubungkan alasan, konsep, cara menerapkan, istilah penting, bacaan lanjutan, dan langkah yang dapat Anda pilih. Ruang Tafsir Al-Qamar tetap berdiri sebagai kajian tersendiri.">
    <div class="hero-actions"><a class="button" href="#pilih-panduan">Pilih Panduan</a><a class="button secondary" href="/istilah-stifin/">Cari Istilah</a></div>
  </PageHero>

  <section class="section-tight orientation"><div class="container orientation-grid"><div><strong>{pillars.length} panduan pilar</strong><span>Menghubungkan pertanyaan besar dengan artikel yang lebih spesifik.</span></div><div><strong>Jawaban langsung</strong><span>Setiap halaman dibuka dengan ringkasan yang mudah dipahami dan dikutip.</span></div><div><strong>Langkah kontekstual</strong><span>Ajakan mengikuti posisi pembaca: Tes, WSL 1, promotor, atau belajar lebih lanjut.</span></div></div></section>

  <section class="section" id="pilih-panduan"><div class="container"><div class="section-head"><div><span class="eyebrow">Pilih dari kebutuhan Anda</span><h2>Satu pintu masuk untuk setiap pertanyaan besar</h2></div><p>Mulailah dari keadaan yang paling dekat dengan hidup Anda hari ini.</p></div><div class="pillar-grid">{pillars.map((pillar, index) => <a class="pillar-card" href={`/panduan/${pillar.slug}/`}><span>{String(index + 1).padStart(2, '0')} · {pillar.eyebrow}</span><h2>{pillar.title}</h2><p>{pillar.description}</p><strong>Buka panduan lengkap →</strong></a>)}</div></div></section>

  <section class="section-tight route"><div class="container split"><div><span class="eyebrow">Belum tahu mulai dari mana?</span><h2>Mulai dari posisi Anda, bukan dari istilahnya.</h2></div><div><p>Jika belum tes, pahami proses dan tentukan kebutuhan. Jika sudah tes, pilih penerapan dan WSL 1. Jika sudah belajar dan ingin memperluas manfaat, pelajari jalur promotor.</p><div class="actions"><a class="button" href="/langkah-selanjutnya/">Temukan Langkah Saya</a><a class="button secondary" href="/artikel/">Lihat Semua Artikel</a></div></div></div></section>
</BaseLayout>

<style>
  .hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}.orientation{border-block:1px solid var(--line);background:white}.orientation-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line)}.orientation-grid>div{padding:24px;background:white}.orientation-grid strong,.orientation-grid span{display:block}.orientation-grid strong{margin-bottom:7px;color:var(--green-950)}.orientation-grid span{color:var(--muted);font-size:.9rem}.section-head>p{max-width:350px}.pillar-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}.pillar-card{display:flex;min-height:330px;flex-direction:column;padding:clamp(28px,4vw,44px);border:1px solid var(--line);border-radius:var(--radius);background:white;box-shadow:var(--shadow-soft);transition:.2s ease}.pillar-card:nth-child(4n+2),.pillar-card:nth-child(4n+3){background:linear-gradient(145deg,#eaf3ec,#f8f9f5)}.pillar-card:hover{transform:translateY(-5px);border-color:#abc4b4}.pillar-card>span{color:var(--green-800);font-size:.77rem;font-weight:900;letter-spacing:.09em;text-transform:uppercase}.pillar-card h2{margin:48px 0 18px;font-size:clamp(1.7rem,3vw,2.35rem)}.pillar-card p{max-width:620px}.pillar-card strong{margin-top:auto;color:var(--green-800)}.route{background:linear-gradient(145deg,#e5efe7,#f6f7f2)}@media(max-width:760px){.orientation-grid,.pillar-grid{grid-template-columns:1fr}.hero-actions .button{width:100%}.pillar-card{min-height:280px}}
</style>
