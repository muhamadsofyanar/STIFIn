---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Callout from '../components/Callout.astro';
import { waLink } from '../data/site';
---
<BaseLayout title="Kerja Sama Program STIFIn untuk Lembaga | STIFIn Mulia" description="Susun seminar, tes kelompok, atau program lanjutan STIFIn untuk sekolah, kampus, komunitas, dan organisasi bersama STIFIn Mulia.">
  <PageHero eyebrow="Program STIFIn untuk Lembaga" title="Bawa pengalaman mengenal potensi ke sekolah, kampus, komunitas, atau tim Anda" description="Mulai dari seminar inspiratif, Tes STIFIn bersama, hingga program lanjutan yang dirancang sesuai tujuan, peserta, dan budaya lembaga Anda.">
    <div class="actions"><a class="button" data-wa-intent="kerjasama-hero-diskusi" href={waLink('Assalamu’alaikum, kami tertarik menghadirkan program STIFIn. Nama lembaga: ... Kota: ... Perkiraan peserta: ... Tujuan kegiatan: ... Waktu yang diinginkan: ...')} target="_blank" rel="noopener noreferrer">Rancang Program Bersama</a><a class="button secondary" href="#program">Lihat Pilihan Program</a></div>
    <p class="microcopy">Kirim gambaran peserta dan tujuan acara. Tim membantu mengubahnya menjadi format program, alur, dan estimasi biaya.</p>
  </PageHero>

  <section class="section-tight"><div class="container proof-strip"><div><strong>Berangkat dari tujuan</strong><span>Program disusun setelah kebutuhan lembaga dan peserta dipahami.</span></div><div><strong>Alur dan peran jelas</strong><span>Jadwal, teknis, biaya, dan penanggung jawab dibahas sebelum hari kegiatan.</span></div><div><strong>Ada tindak lanjut</strong><span>Format dapat mencakup penjelasan, tes, konsultasi, atau kegiatan lanjutan.</span></div></div></section>

  <section class="section"><div class="container split"><div><span class="eyebrow">Dirancang untuk tujuan Anda</span><h2>Satu konsep, banyak format kegiatan yang dapat dihidupkan</h2><p class="lead">Setiap kelompok memiliki tantangan dan karakter peserta yang berbeda. Karena itu, tema, durasi, metode, dan tindak lanjut disusun agar program terasa relevan.</p></div><ul class="check-list"><li><strong>Bangun kesadaran bersama</strong><br />Mulai dari seminar atau kelas pengantar dengan tema yang dekat dengan peserta.</li><li><strong>Berikan pengalaman personal</strong><br />Lanjutkan dengan tes kelompok dan sesi penjelasan hasil yang terstruktur.</li><li><strong>Ciptakan perubahan berkelanjutan</strong><br />Gabungkan pengantar, tes, pembahasan, konsultasi, dan program tindak lanjut.</li></ul></div></section>

  <section id="program" class="section soft"><div class="container"><div class="section-head"><div><span class="eyebrow">Pilihan program</span><h2>Pilih titik mulai, lalu sesuaikan bersama</h2></div></div><div class="grid-3"><article class="card"><span class="card-icon">A</span><h3>Seminar dan kelas pengenalan</h3><p>Untuk peserta yang perlu memahami konsep awal sebelum memutuskan langkah berikutnya.</p></article><article class="card"><span class="card-icon">B</span><h3>Tes bersama</h3><p>Untuk kelompok yang membutuhkan pelaksanaan tes, penjadwalan, dan penjelasan hasil secara tertata.</p></article><article class="card"><span class="card-icon">C</span><h3>Program lanjutan</h3><p>Untuk lembaga yang ingin menggabungkan seminar, tes, konsultasi, dan tindak lanjut sesuai kebutuhan.</p></article></div></div></section>

  <section class="section"><div class="container program-grid"><div><span class="eyebrow">Gambaran pelaksanaan</span><h2>Apa yang dibahas sebelum kegiatan dimulai</h2><p class="lead">Semakin lengkap informasi awal, semakin tepat rancangan yang dapat disiapkan.</p></div><div class="program-card"><div><strong>Tujuan</strong><span>Masalah atau hasil pembelajaran yang ingin dibantu.</span></div><div><strong>Peserta</strong><span>Jumlah, rentang usia, dan konteks kelompok.</span></div><div><strong>Pelaksanaan</strong><span>Kota, waktu, lokasi, durasi, dan kebutuhan teknis.</span></div><div><strong>Tindak lanjut</strong><span>Penjelasan hasil, konsultasi, atau kegiatan sesudah acara.</span></div></div></div></section>

  <section class="section dark"><div class="container evidence-grid"><div class="evidence-photo"><img src="/images/kegiatan/pertemuan-jaringan.webp" width="1200" height="800" alt="Pertemuan STIFIn Mulia dengan jaringan mitra" loading="lazy" /></div><div><span class="eyebrow">Koordinasi nyata</span><h2>Program yang rapi tidak dimulai pada hari acara</h2><p class="lead">Koordinasi awal membantu kedua pihak memahami tujuan, pembagian tugas, administrasi, teknis peserta, dan cara mengevaluasi kegiatan.</p></div></div></section>

  <section id="alur" class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Cara mengajukan</span><h2>Empat langkah sebelum kegiatan dimulai</h2></div></div><div class="steps"><article class="step"><h3>Kirim konteks</h3><p>Sampaikan profil lembaga, tujuan, kota, jumlah peserta, dan waktu yang diinginkan.</p></article><article class="step"><h3>Bahas rancangan</h3><p>Tim mengusulkan format kegiatan, jadwal, kebutuhan teknis, dan estimasi biaya.</p></article><article class="step"><h3>Sepakati detail</h3><p>Tentukan penanggung jawab, administrasi, tugas setiap pihak, serta jadwal final.</p></article><article class="step"><h3>Jalankan dan evaluasi</h3><p>Laksanakan kegiatan, lalu bahas hasil dan kemungkinan tindak lanjut.</p></article></div></div></section>

  <section class="section soft"><div class="container"><div class="section-head"><div><span class="eyebrow">Lembaga yang dapat mengajukan</span><h2>Sesuaikan pembahasan dengan peserta Anda</h2></div></div><div class="partner-list"><span>Sekolah</span><span>Kampus</span><span>Komunitas</span><span>Lembaga Keluarga</span><span>Organisasi</span><span>Tim Usaha</span></div></div></section>

  <Callout title="Mari hadirkan program STIFIn di lembaga Anda" text="Kirim nama lembaga, kota, jumlah peserta, tujuan, dan perkiraan waktu. Tim akan membantu merancang titik mulai yang paling sesuai." message="Assalamu’alaikum, kami tertarik menghadirkan program STIFIn. Nama lembaga: ... Kota: ... Perkiraan peserta: ... Tujuan kegiatan: ... Waktu yang diinginkan: ..." />
</BaseLayout>
<style>
  .program-grid,.evidence-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(40px,8vw,100px);align-items:center}.program-card{display:grid;grid-template-columns:1fr 1fr;gap:1px;overflow:hidden;border:1px solid var(--line);border-radius:var(--radius);background:var(--line)}.program-card div{padding:24px;background:white}.program-card strong,.program-card span{display:block}.program-card strong{margin-bottom:6px;color:var(--green-950)}.program-card span{color:var(--muted);font-size:.92rem}.evidence-photo{overflow:hidden;border-radius:var(--radius-lg)}.evidence-photo img{width:100%;aspect-ratio:3/2;object-fit:cover}.partner-list{display:flex;flex-wrap:wrap;gap:12px}.partner-list span{padding:13px 18px;border:1px solid #bfd7cd;border-radius:999px;background:white;color:var(--green-900);font-weight:800}@media(max-width:760px){.program-grid,.evidence-grid,.program-card{grid-template-columns:1fr}}
</style>
