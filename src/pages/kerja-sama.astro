---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Callout from '../components/Callout.astro';
---
<BaseLayout title="Kerja Sama Program STIFIn | STIFIn Mulia" description="Kolaborasi edukasi, tes, parenting, pengembangan tim, dan komunitas bersama STIFIn Mulia.">
  <PageHero eyebrow="Kerja Sama" title="Adakan program STIFIn untuk lembaga Anda" description="Sekolah, kampus, komunitas, dan organisasi dapat mengadakan seminar, tes kelompok, atau program lanjutan bersama STIFIn Mulia."><div class="actions"><a class="button" href="#program">Lihat Pilihan Program</a><a class="button secondary" href="#alur">Lihat Cara Pengajuan</a></div></PageHero>
  <section id="program" class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Pilihan program</span><h2>Pilih kegiatan yang sesuai dengan peserta Anda</h2></div></div><div class="grid-3"><article class="card"><span class="card-icon">A</span><h3>Seminar dan Kelas Pengenalan</h3><p>Materi tentang potensi diri, belajar, parenting, karier, atau kerja tim.</p></article><article class="card"><span class="card-icon">B</span><h3>Tes Bersama</h3><p>Tes untuk kelompok dengan jadwal, penanggung jawab kegiatan, dan konsultasi hasil.</p></article><article class="card"><span class="card-icon">C</span><h3>Program Lanjutan</h3><p>Gabungan seminar, tes, konsultasi hasil, dan kegiatan lanjutan sesuai kebutuhan lembaga.</p></article></div></div></section>
  <section class="section soft"><div class="container"><div class="section-head"><div><span class="eyebrow">Peserta program</span><h2>Kegiatan dapat diadakan bersama berbagai lembaga</h2></div></div><div class="partner-list"><span>Sekolah</span><span>Kampus</span><span>Komunitas</span><span>Lembaga Keluarga</span><span>Organisasi</span><span>Tim Usaha</span></div></div></section>
  <section id="alur" class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Cara mengajukan</span><h2>Empat langkah sebelum kegiatan dimulai</h2></div></div><div class="steps"><article class="step"><h3>Ceritakan kebutuhan</h3><p>Sampaikan tujuan, jumlah peserta, kota, dan waktu yang diinginkan.</p></article><article class="step"><h3>Terima rancangan program</h3><p>Kami menyiapkan pilihan kegiatan, jadwal, kebutuhan teknis, dan biaya.</p></article><article class="step"><h3>Sepakati pelaksanaan</h3><p>Tentukan jadwal, penanggung jawab, administrasi, dan tugas setiap pihak.</p></article><article class="step"><h3>Jalankan dan evaluasi</h3><p>Kegiatan dilaksanakan, lalu hasilnya dibahas untuk menentukan tindak lanjut.</p></article></div></div></section>
  <Callout title="Mari susun program yang tepat" text="Sampaikan profil lembaga, jumlah peserta, kota, dan tujuan program. Tim akan menyiapkan pembicaraan awal." message="Assalamu’alaikum, kami ingin mendiskusikan kerja sama dengan STIFIn Mulia. Nama lembaga: ... Kota: ... Kebutuhan: ..." />
</BaseLayout>
<style>.partner-list{display:flex;flex-wrap:wrap;gap:12px}.partner-list span{padding:13px 18px;border:1px solid #bfd7cd;border-radius:999px;background:white;color:var(--green-900);font-weight:800}</style>
