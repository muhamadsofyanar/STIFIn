---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Callout from '../components/Callout.astro';
---
<BaseLayout title="Kerja Sama Program STIFIn | STIFIn Mulia" description="Kolaborasi edukasi, tes, parenting, pengembangan tim, dan komunitas bersama STIFIn Mulia.">
  <PageHero eyebrow="Kemitraan" title="Program yang disusun sesuai kebutuhan lembaga Anda" description="Kami membuka kolaborasi dengan sekolah, kampus, komunitas, organisasi, dan lembaga yang ingin mengembangkan potensi manusia secara terarah."><div class="actions"><a class="button" href="#program">Lihat Pilihan Program</a><a class="button secondary" href="#alur">Cara Berkolaborasi</a></div></PageHero>
  <section id="program" class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Pilihan program</span><h2>Dapat dimulai dari edukasi hingga layanan berkelanjutan</h2></div></div><div class="grid-3"><article class="card"><span class="card-icon">A</span><h3>Seminar dan Sharing</h3><p>Materi pengenalan potensi, belajar, parenting, karier, atau kerja tim.</p></article><article class="card"><span class="card-icon">B</span><h3>Tes Kelompok</h3><p>Pelaksanaan tes terjadwal dengan administrasi, PIC, dan konsultasi hasil.</p></article><article class="card"><span class="card-icon">C</span><h3>Program Bertahap</h3><p>Rangkaian edukasi, tes, tindak lanjut, serta evaluasi sesuai kebutuhan mitra.</p></article></div></div></section>
  <section class="section soft"><div class="container"><div class="section-head"><div><span class="eyebrow">Mitra potensial</span><h2>Konteks program yang kami layani</h2></div></div><div class="partner-list"><span>Sekolah</span><span>Kampus</span><span>Komunitas</span><span>Lembaga Keluarga</span><span>Organisasi</span><span>Tim Usaha</span></div></div></section>
  <section id="alur" class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Cara berkolaborasi</span><h2>Empat langkah sebelum pelaksanaan</h2></div></div><div class="steps"><article class="step"><h3>Diskusi kebutuhan</h3><p>Tentukan masalah, peserta, wilayah, dan hasil yang diharapkan.</p></article><article class="step"><h3>Rancangan program</h3><p>Kami menyiapkan lingkup kegiatan, peran, waktu, dan kebutuhan teknis.</p></article><article class="step"><h3>Persetujuan</h3><p>Kedua pihak mengunci jadwal, administrasi, PIC, serta indikator kegiatan.</p></article><article class="step"><h3>Pelaksanaan dan evaluasi</h3><p>Program dijalankan, didokumentasikan, dan ditinjau untuk tindak lanjut.</p></article></div></div></section>
  <Callout title="Mari susun program yang tepat" text="Sampaikan profil lembaga, jumlah peserta, kota, dan tujuan program. Tim akan menyiapkan pembicaraan awal." message="Assalamu’alaikum, kami ingin mendiskusikan kerja sama dengan STIFIn Mulia. Nama lembaga: ... Kota: ... Kebutuhan: ..." />
</BaseLayout>
<style>.partner-list{display:flex;flex-wrap:wrap;gap:12px}.partner-list span{padding:13px 18px;border:1px solid #bfd7cd;border-radius:999px;background:white;color:var(--green-900);font-weight:800}</style>
