---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import JourneyEngine from '../components/JourneyEngine.astro';
const articles = await getCollection('articles', ({ data }) => !data.draft);
const schema = {
  '@context': 'https://schema.org', '@type': 'WebPage',
  name: 'Temukan Langkah Anda bersama STIFIn Mulia',
  description: 'Jawab empat pertanyaan singkat untuk memperoleh jalur belajar, rekomendasi artikel, dan langkah STIFIn yang relevan.',
  url: new URL('/perjalanan/', Astro.site).toString(),
  isPartOf: { '@id': new URL('/#website', Astro.site).toString() },
};
---
<BaseLayout title="Temukan Langkah Anda | STIFIn Mulia" description="Mulai dari kebutuhan Anda. Jawab empat pertanyaan singkat untuk menemukan bacaan dan langkah STIFIn yang lebih relevan." schema={schema}>
  <PageHero eyebrow="Perjalanan personal STIFIn Mulia" title="Mulai dari situasi Anda—bukan dari istilah yang harus dihafal." description="Jawab empat pertanyaan singkat. Kami merapikan bacaan, alasan, dan langkah berikutnya agar Anda tidak perlu menjelajahi semuanya sendirian." />
  <section class="section-tight trust"><div class="container proof-strip"><div><strong>Hanya empat pertanyaan</strong><span>Tidak ada jawaban benar atau salah.</span></div><div><strong>Hasil langsung terlihat</strong><span>Dapatkan bacaan dan langkah yang relevan.</span></div><div><strong>Anda tetap memutuskan</strong><span>Tim hadir ketika Anda ingin dibantu.</span></div></div></section>
  <section class="section engine-section"><div class="container"><JourneyEngine articles={articles} /></div></section>
  <section class="section privacy"><div class="container privacy-grid"><div><span class="eyebrow">Percakapan yang menghargai Anda</span><h2>Jawaban dipakai untuk memperjelas bantuan, bukan untuk memberi label.</h2></div><div><p class="lead">Data kontak baru dikirim setelah Anda mengisi formulir dan memberikan persetujuan. Rekomendasi awal dapat dilihat tanpa memasukkan nomor WhatsApp.</p><a class="text-link" href="/privasi/">Baca kebijakan privasi →</a></div></div></section>
</BaseLayout>
<style>.trust{background:#fff;border-bottom:1px solid var(--line)}.engine-section{background:linear-gradient(145deg,#e8f1ea,#f8faf6)}.privacy-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(35px,8vw,90px)}.text-link{color:var(--green-800);font-weight:850}@media(max-width:760px){.privacy-grid{grid-template-columns:1fr}}</style>

