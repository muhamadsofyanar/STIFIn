---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { decisionFaqs, decisionPaths } from '../data/decision-center';
import { waLink } from '../data/site';
const pageUrl = new URL('/apakah-tes-stifin-cocok-untuk-saya/', Astro.site).toString();
const schema = [
  {
    '@context': 'https://schema.org', '@type': 'WebPage', name: 'Apakah Tes STIFIn Cocok untuk Saya?',
    description: 'Panduan menilai kecocokan Tes STIFIn, membedakan tes, penjelasan hasil, WSL 1, dan jalur promotor.',
    url: pageUrl, isPartOf: { '@id': new URL('/#website', Astro.site).toString() },
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: decisionFaqs.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })),
  },
];
const consultMessage = 'Assalamu’alaikum, saya sudah membaca panduan “Apakah Tes STIFIn Cocok untuk Saya?”. Situasi yang ingin saya bahas: ... Kota/kabupaten: ... Saya ingin dibantu memilih langkah yang paling sesuai.';
---
<BaseLayout title="Apakah Tes STIFIn Cocok untuk Saya? | STIFIn Mulia" description="Nilai kebutuhan dan kesiapan Anda. Pahami perbedaan Tes STIFIn, penjelasan hasil, WSL 1, serta jalur promotor sebelum memutuskan." schema={schema}>
  <PageHero eyebrow="Pusat keputusan calon peserta" title="Apakah Tes STIFIn cocok untuk saya?" description="Jawabannya tidak harus langsung ‘ya’. Kenali apa yang sedang Anda cari, apa yang diberikan setiap tahap, dan langkah paling ringan yang dapat Anda mulai sekarang." />

  <section class="section-tight orientation"><div class="container proof-strip"><div><strong>Mulai tanpa tekanan</strong><span>Belajar dahulu tetap merupakan langkah yang baik.</span></div><div><strong>Bedakan setiap tahap</strong><span>Tes, penjelasan hasil, dan WSL 1 mempunyai fungsi berbeda.</span></div><div><strong>Putuskan dengan konteks</strong><span>Bawa kebutuhan nyata, bukan sekadar rasa penasaran.</span></div></div></section>

  <section class="section fit-section"><div class="container fit-grid"><div><span class="eyebrow">Tes dapat relevan bila</span><h2>Anda mencari peta awal untuk memahami pola, lalu siap mengujinya dalam kehidupan.</h2><p class="lead">Tes STIFIn layak dipertimbangkan ketika Anda ingin mempunyai bahasa awal untuk membahas diri, anak, pasangan, belajar, profesi, atau tim—tanpa menjadikannya satu-satunya dasar keputusan.</p><ul class="fit-list positive"><li>Anda mempunyai pertanyaan yang cukup nyata untuk dibahas.</li><li>Anda siap menerima penjelasan, bukan hanya nama hasil.</li><li>Anda bersedia mengamati penerapan dan melakukan penyesuaian.</li><li>Anda memahami bahwa lingkungan, latihan, dan pilihan tetap berpengaruh.</li></ul></div><div class="not-fit"><span class="eyebrow">Berhenti sejenak bila</span><h3>Anda sedang mencari kepastian mutlak atau pengganti bantuan profesional.</h3><ul class="fit-list"><li>Mengharapkan diagnosis medis atau psikologis.</li><li>Ingin hasil tes menentukan jurusan, profesi, atau pasangan secara otomatis.</li><li>Mengharapkan perubahan tanpa percakapan, latihan, dan tindakan.</li><li>Mencari jaminan penghasilan dari jalur promotor.</li></ul><p>Jika kebutuhan Anda berkaitan dengan kesehatan, perkembangan, krisis keluarga, atau kondisi psikologis, libatkan tenaga profesional yang sesuai.</p></div></div></section>

  <section class="section soft paths"><div class="container"><div class="section-head"><div><span class="eyebrow">Mulai dari posisi Anda sekarang</span><h2>Lima kondisi, lima pintu masuk yang berbeda.</h2><p class="lead">Tidak semua orang perlu langsung mengikuti tes. Pilih kondisi yang paling menggambarkan Anda hari ini.</p></div></div><div class="path-list">{decisionPaths.map((path) => <article id={path.id}><span class="path-number">{path.number}</span><div class="path-copy"><small>{path.label}</small><h3>{path.title}</h3><p>{path.text}</p><ul>{path.signs.map((sign) => <li>{sign}</li>)}</ul></div><a class="button secondary" href={path.href}>{path.action}</a></article>)}</div></div></section>

  <section class="section comparison"><div class="container"><div class="section-head"><div><span class="eyebrow">Jangan tertukar</span><h2>Perbedaan belajar, tes, penjelasan hasil, WSL 1, dan promotor.</h2></div></div><div class="table-wrap" tabindex="0" aria-label="Tabel perbandingan tahapan STIFIn"><table><thead><tr><th>Tahap</th><th>Tujuan utama</th><th>Cocok untuk</th><th>Hasil yang dibawa pulang</th><th>Langkah berikutnya</th></tr></thead><tbody>
    <tr><th>Belajar mandiri</th><td>Mengenal bahasa dan penerapan dasar.</td><td>Orang yang masih mengeksplorasi.</td><td>Pertanyaan yang lebih jelas dan pemahaman awal.</td><td>Konsultasi atau tes bila sudah siap.</td></tr>
    <tr><th>Tes STIFIn</th><td>Memperoleh hasil Mesin Kecerdasan dan personaliti genetik dalam sistem STIFIn.</td><td>Orang yang ingin mengenali hasil pribadinya.</td><td>Hasil tes untuk dibahas lebih lanjut.</td><td>Penjelasan hasil dan penerapan awal.</td></tr>
    <tr><th>Penjelasan hasil</th><td>Menghubungkan hasil pribadi dengan kebutuhan nyata.</td><td>Peserta yang baru selesai tes.</td><td>Makna dasar hasil dan pilihan langkah yang dapat dicoba.</td><td>Praktik mandiri atau WSL 1.</td></tr>
    <tr><th>WSL 1</th><td>Memahami fondasi dan hubungan dalam konsep secara lebih utuh.</td><td>Peserta tes yang ingin belajar lebih dalam.</td><td>Kerangka belajar yang lebih terstruktur.</td><td>Penerapan lanjutan atau jalur promotor.</td></tr>
    <tr><th>Promotor</th><td>Belajar mengedukasi, menghubungkan, dan melayani peserta.</td><td>Orang yang siap menjalankan aktivitas secara konsisten.</td><td>Jalur pembelajaran, pelayanan, dan pengembangan kegiatan.</td><td>Membangun peserta dan layanan sesuai ketentuan.</td></tr>
  </tbody></table></div><p class="table-note">Harga, fasilitas, persyaratan, dan ketentuan jaringan dapat berubah. Konfirmasikan informasi terbaru sebelum mengambil keputusan.</p></div></section>

  <section class="section objections"><div class="container objection-grid"><div><span class="eyebrow">Pertanyaan yang wajar</span><h2>Yakin bukan berarti tidak boleh bertanya.</h2><p class="lead">Keputusan yang baik lahir dari informasi yang cukup. Buka pertanyaan yang paling dekat dengan keraguan Anda.</p><a class="button" href={waLink(consultMessage)} target="_blank" rel="noopener noreferrer" data-wa-intent="pusat-keputusan-konsultasi">Bahas Situasi Saya</a></div><div class="faq-list">{decisionFaqs.map((item, index) => <details open={index === 0}><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div></div></section>

  <section class="section final-decision"><div class="container decision-card"><div><span class="eyebrow">Masih belum yakin?</span><h2>Biarkan kebutuhan Anda yang menentukan pintu masuknya.</h2><p>Tidak perlu menghafal istilah. Jawab empat pertanyaan singkat, lihat rekomendasi, lalu putuskan apakah ingin belajar sendiri atau berbicara dengan tim.</p></div><div class="actions"><a class="button" href="/perjalanan/">Temukan Langkah Saya</a><a class="button secondary" href="/artikel/">Belajar Dahulu</a></div></div></section>
</BaseLayout>

<style>
  .orientation{background:#fff;border-bottom:1px solid var(--line)}.fit-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(35px,7vw,85px);align-items:start}.fit-list{display:grid;gap:10px;margin:28px 0 0;padding:0;list-style:none}.fit-list li{position:relative;padding:15px 16px 15px 48px;border:1px solid var(--line);border-radius:12px;background:#fff;color:var(--muted)}.fit-list li::before{position:absolute;top:15px;left:16px;display:grid;width:22px;height:22px;place-items:center;border-radius:50%;background:#f2e8d0;color:#8a6110;content:'!';font-size:.75rem;font-weight:900}.positive li::before{background:var(--green-100);color:var(--green-800);content:'✓'}.not-fit{padding:clamp(28px,4vw,42px);border:1px solid #dccfac;border-radius:var(--radius);background:var(--cream);box-shadow:var(--shadow-soft)}.not-fit h3{font-family:var(--font-display);font-size:1.65rem}.not-fit p{margin:22px 0 0;font-size:.9rem}.path-list{display:grid;gap:12px}.path-list article{display:grid;grid-template-columns:70px 1fr auto;gap:24px;align-items:start;padding:28px;border:1px solid var(--line);border-radius:var(--radius);background:#fff;box-shadow:var(--shadow-soft)}.path-number{display:grid;width:52px;height:52px;place-items:center;border-radius:50%;background:var(--green-950);color:#fff;font-weight:900}.path-copy small{color:var(--green-700);font-weight:850}.path-copy h3{margin:7px 0 10px;font-family:var(--font-display);font-size:1.45rem}.path-copy p{margin-bottom:10px}.path-copy ul{display:flex;flex-wrap:wrap;gap:7px;margin:0;padding:0;list-style:none}.path-copy li{padding:6px 9px;border-radius:999px;background:var(--green-100);color:var(--green-900);font-size:.72rem}.table-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:var(--radius);background:#fff;box-shadow:var(--shadow-soft)}table{width:100%;min-width:920px;border-collapse:collapse;text-align:left}th,td{padding:19px;border-bottom:1px solid var(--line);vertical-align:top}thead th{background:var(--green-950);color:#fff;font-size:.78rem;letter-spacing:.04em}tbody th{color:var(--green-900);font-family:var(--font-display);font-size:1.1rem}tbody td{color:var(--muted);font-size:.88rem}tbody tr:last-child th,tbody tr:last-child td{border-bottom:0}.table-note{margin:14px 0 0;font-size:.8rem}.objections{background:linear-gradient(145deg,#edf5ef,#f8faf6)}.objection-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:clamp(40px,8vw,100px);align-items:start}.faq-list{display:grid;gap:10px}.faq-list details{border:1px solid var(--line);border-radius:14px;background:#fff;box-shadow:var(--shadow-soft)}.faq-list summary{padding:19px 48px 19px 20px;color:var(--green-950);font-weight:850;cursor:pointer}.faq-list p{margin:0;padding:0 20px 20px}.decision-card{display:flex;align-items:center;justify-content:space-between;gap:40px;padding:clamp(35px,6vw,65px);border-radius:var(--radius-lg);background:var(--green-950);color:#fff;box-shadow:var(--shadow)}.decision-card>div:first-child{max-width:760px}.decision-card p{color:#c5d9d1}.decision-card .actions{flex:0 0 auto;flex-direction:column}.decision-card .button.secondary{border-color:rgba(255,255,255,.24);background:transparent;color:#fff}@media(max-width:850px){.fit-grid,.objection-grid{grid-template-columns:1fr}.path-list article{grid-template-columns:60px 1fr}.path-list article>.button{grid-column:2;width:fit-content}.decision-card{align-items:flex-start;flex-direction:column}.decision-card .actions{width:100%}}@media(max-width:560px){.path-list article{grid-template-columns:1fr}.path-list article>.button{grid-column:1;width:100%}.decision-card .actions .button{width:100%}}
</style>
