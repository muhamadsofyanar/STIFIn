---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Callout from '../components/Callout.astro';
import { site } from '../data/site';
import { networkGeneratedAt, networkLocations, networkSummary } from '../data/network';

const regions = ['Sumatera', 'Jawa', 'Kalimantan', 'Sulawesi', 'Bali dan Nusa Tenggara', 'Maluku dan Papua', 'Luar Indonesia'];
const updatedAt = networkGeneratedAt ? new Date(networkGeneratedAt) : null;
const updatedLabel = updatedAt?.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Jakarta' });
const ageDays = updatedAt ? Math.floor((Date.now() - updatedAt.getTime()) / 86400000) : null;
const isStale = ageDays !== null && ageDays > 45;
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Jaringan Promotor STIFIn',
  url: new URL('/jaringan-promotor/', Astro.site).toString(),
  description: 'Pencarian wilayah layanan dan promotor Tes STIFIn melalui STIFIn Mulia.',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: networkLocations.length,
    itemListElement: networkLocations.map((location, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: location.province ? `${location.city}, ${location.province}` : location.city,
      url: new URL(`/promotor/${location.slug}/`, Astro.site).toString(),
    })),
  },
};
---
<BaseLayout title="Tes STIFIn di Kota Anda | STIFIn Mulia" description="Cari jadwal Tes STIFIn di kota Anda. STIFIn Mulia membantu menghubungkan peserta dengan layanan yang tersedia melalui jaringan STIFIn." schema={collectionSchema}>
  <PageHero eyebrow="Tes STIFIn di Berbagai Kota" title="Mau Tes STIFIn di kota Anda? Kami bantu hubungkan dengan layanan terdekat" description="Cukup kirim nama kota, provinsi, dan jumlah peserta. Tim STIFIn Mulia akan membantu mengecek jadwal serta layanan yang dapat dijangkau melalui jaringan STIFIn."><div class="actions"><a class="button" href="#cari">Cari Tes di Kota Saya</a><a class="button secondary" href="/tes-stifin/">Lihat Manfaat Tes</a></div><p class="microcopy">Anda tetap berkomunikasi melalui satu kontak STIFIn Mulia sampai arah layanan berikutnya jelas.</p></PageHero>

  <section class="section-tight"><div class="container proof-strip"><div><strong>Cukup sebutkan kota</strong><span>Tidak perlu mencari banyak kontak promotor satu per satu.</span></div><div><strong>Dibantu menemukan jadwal</strong><span>Tim mencocokkan kota, jumlah peserta, dan pilihan waktu.</span></div><div><strong>Tetap satu pintu</strong><span>Percakapan dimulai melalui WhatsApp STIFIn Mulia.</span></div></div></section>

  <section id="cari" class="section"><div class="container search-grid"><div><span class="eyebrow">Mulai dari kota Anda</span><h2>Di mana Anda ingin mengikuti Tes STIFIn?</h2><p class="lead">Isi data singkat di samping. Pesan akan tersusun otomatis sehingga tim dapat langsung membantu mencari jalur layanan yang sesuai.</p><ul class="check-list"><li>Tes untuk diri sendiri, anak, pasangan, atau keluarga.</li><li>Tes bersama untuk sekolah, komunitas, dan organisasi.</li><li>Pencarian layanan di Indonesia maupun luar Indonesia.</li></ul></div><form id="network-form" class="network-form" data-wa-number={site.whatsapp}><label>Nama Anda<input id="network-name" name="name" autocomplete="name" required placeholder="Contoh: Aisyah" /></label><label>Kota atau kabupaten tempat tes<input id="network-city" name="city" autocomplete="address-level2" required placeholder="Contoh: Balikpapan" /></label><label>Provinsi<input id="network-province" name="province" autocomplete="address-level1" required placeholder="Contoh: Kalimantan Timur" /></label><label>Negara<input id="network-country" name="country" autocomplete="country-name" value="Indonesia" required /></label><label>Saya ingin<select id="network-need" name="need"><option>Tes STIFIn untuk diri sendiri</option><option>Tes STIFIn bersama keluarga</option><option>Tes kelompok atau lembaga</option><option>Mengenal peluang jadi promotor</option></select></label><button class="button" type="submit">Cari Jadwal via WhatsApp</button><small>Setelah WhatsApp terbuka, periksa pesannya lalu tekan kirim.</small></form></div></section>

  {networkLocations.length > 0 ? <section class="section soft"><div class="container"><div class="section-head"><div><span class="eyebrow">Jaringan layanan</span><h2>Kota yang sudah terhubung dalam sistem</h2><p class="lead">Sistem mencatat {networkSummary.promoters} promotor aktif pada {networkSummary.locations} wilayah.</p>{updatedLabel && <p class:list={{ freshness: true, stale: isStale }}>Pembaruan data: {updatedLabel}{isStale ? ' — tim sedang menyiapkan pembaruan berikutnya' : ''}</p>}</div></div><label class="location-search">Temukan kota atau provinsi<input id="location-search" type="search" placeholder="Ketik nama kota atau provinsi" autocomplete="off" /></label><p id="location-result" class="result-count" aria-live="polite"></p><div id="location-grid" class="location-grid">{networkLocations.map((location) => <a data-search={`${location.city} ${location.province}`.toLocaleLowerCase('id')} href={`/promotor/${location.slug}/`}><span>{location.province || 'Wilayah layanan STIFIn'}</span><strong>{location.city}</strong><small>{location.promoters} promotor aktif · {location.branches} jaringan cabang</small></a>)}</div></div></section> : <section class="section soft"><div class="container empty-network"><span class="eyebrow">Pencarian tetap berjalan</span><h2>Belum ada daftar kota? Tim tetap dapat membantu</h2><p class="lead">Kirim kota melalui formulir. Tim STIFIn Mulia akan menelusuri jaringan yang tersedia dan mengabarkan langkah berikutnya.</p></div></section>}

  <section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Jangkauan yang terus tumbuh</span><h2>Dari kota Anda, kami bantu mencari koneksinya</h2><p class="lead">Walaupun sebuah kota belum tampil dalam daftar, jaringan cabang dan promotor tetap dapat ditelusuri oleh tim.</p></div></div><div class="region-grid">{regions.map((region) => <div>{region}</div>)}</div></div></section>

  <Callout title="Siap mencari jadwal Tes STIFIn di kota Anda?" text="Kirim nama kota dan jumlah peserta. Tim STIFIn Mulia akan membantu menelusuri layanan yang paling memungkinkan." message="Assalamu’alaikum, saya mau Tes STIFIn di kota saya. Nama: ... Kota/Kabupaten: ... Provinsi/Negara: ... Jumlah peserta: ..." />
</BaseLayout>
<script>
  const form = document.querySelector<HTMLFormElement>('#network-form');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const number = form.dataset.waNumber;
    const name = (document.querySelector<HTMLInputElement>('#network-name')?.value || '').trim();
    const city = (document.querySelector<HTMLInputElement>('#network-city')?.value || '').trim();
    const province = (document.querySelector<HTMLInputElement>('#network-province')?.value || '').trim();
    const country = (document.querySelector<HTMLInputElement>('#network-country')?.value || '').trim();
    const need = document.querySelector<HTMLSelectElement>('#network-need')?.value || 'Tes STIFIn';
    const message = `Assalamu’alaikum, saya ingin mencari layanan STIFIn di kota saya. Nama: ${name}. Kota/Kabupaten: ${city}. Provinsi: ${province}. Negara: ${country}. Saya ingin: ${need}. Sumber halaman: ${window.location.pathname}`;
    const trackedWindow = window as typeof window & { dataLayer?: Array<Record<string, unknown>> };
    trackedWindow.dataLayer?.push({ event: 'whatsapp_form_submit', intent: need, page_path: window.location.pathname });
    window.open(`https://wa.me/${number}?text=${encodeURIComponent(message)}`, '_blank', 'noopener,noreferrer');
  });

  const search = document.querySelector<HTMLInputElement>('#location-search');
  const cards = [...document.querySelectorAll<HTMLElement>('#location-grid [data-search]')];
  const result = document.querySelector<HTMLElement>('#location-result');
  const updateResult = () => {
    const query = (search?.value || '').trim().toLocaleLowerCase('id');
    let visible = 0;
    cards.forEach((card) => {
      const matches = !query || (card.dataset.search || '').includes(query);
      card.hidden = !matches;
      if (matches) visible += 1;
    });
    if (result) result.textContent = query ? `${visible} wilayah ditemukan` : `${cards.length} wilayah tersedia`;
  };
  search?.addEventListener('input', updateResult);
  updateResult();
</script>
<style>
  .search-grid{display:grid;grid-template-columns:.92fr 1.08fr;gap:clamp(35px,7vw,90px);align-items:start}.network-form{position:relative;display:grid;gap:16px;padding:clamp(24px,4vw,38px);border:1px solid #c9dbce;border-radius:var(--radius);background:linear-gradient(145deg,white,#f1f6f1);box-shadow:var(--shadow)}.network-form::before{position:absolute;top:0;left:34px;width:90px;height:4px;border-radius:0 0 5px 5px;background:var(--lime-500);content:''}.network-form label,.location-search{display:grid;gap:7px;color:var(--green-950);font-size:.9rem;font-weight:800}.network-form input,.network-form select,.location-search input{width:100%;min-height:50px;padding:11px 13px;border:1px solid #bfd2ca;border-radius:10px;background:white;color:var(--ink);font:inherit;transition:border-color .2s ease,box-shadow .2s ease}.network-form input:focus,.network-form select:focus,.location-search input:focus{border-color:var(--green-700);outline:0;box-shadow:0 0 0 4px rgba(13,133,89,.11)}.network-form small{color:var(--muted)}.region-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.region-grid div{position:relative;overflow:hidden;padding:22px;border:1px solid var(--line);border-radius:var(--radius-sm);background:white;color:var(--green-900);font-weight:850;box-shadow:var(--shadow-soft)}.region-grid div::after{position:absolute;right:-18px;bottom:-18px;width:55px;height:55px;border-radius:50%;background:var(--green-100);content:''}.location-search{max-width:560px}.result-count,.freshness{margin:12px 0 22px;font-size:.9rem}.freshness.stale{color:#8a5410;font-weight:800}.location-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.location-grid a{display:grid;gap:5px;padding:22px;border:1px solid var(--line);border-radius:var(--radius-sm);background:white;box-shadow:var(--shadow-soft);transition:transform .2s ease,border-color .2s ease}.location-grid a:hover{transform:translateY(-3px);border-color:#b6cbbb}.location-grid a[hidden]{display:none}.location-grid span,.location-grid small{color:var(--muted);font-size:.82rem}.location-grid strong{color:var(--green-950);font-family:var(--font-display);font-size:1.28rem}.empty-network{max-width:800px}@media(max-width:850px){.search-grid{grid-template-columns:1fr}.region-grid,.location-grid{grid-template-columns:1fr 1fr}}@media(max-width:540px){.region-grid,.location-grid{grid-template-columns:1fr}}
</style>
