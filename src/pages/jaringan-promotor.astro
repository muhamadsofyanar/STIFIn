---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Callout from '../components/Callout.astro';
import { site } from '../data/site';
import { networkLocations } from '../data/network';
const regions = ['Sumatera', 'Jawa', 'Kalimantan', 'Sulawesi', 'Bali dan Nusa Tenggara', 'Maluku dan Papua', 'Luar Indonesia'];
---
<BaseLayout title="Cari Promotor STIFIn di Indonesia | STIFIn Mulia" description="Cari promotor Tes STIFIn berdasarkan kota dan provinsi. STIFIn Mulia membantu menghubungkan calon peserta dengan promotor yang tersedia melalui WhatsApp.">
  <PageHero eyebrow="Jaringan Promotor" title="Cari promotor Tes STIFIn di kota Anda" description="Sampaikan kota, kabupaten, provinsi, atau negara tempat Anda tinggal. STIFIn Mulia akan memeriksa jaringan dan membantu menghubungkan Anda dengan promotor yang tersedia."><div class="actions"><a class="button" href="#cari">Cari Berdasarkan Wilayah</a><a class="button secondary" href="/tes-stifin/">Pelajari Proses Tes</a></div></PageHero>

  <section id="cari" class="section"><div class="container search-grid"><div><span class="eyebrow">Pencarian satu pintu</span><h2>Tidak perlu mencari nomor promotor sendiri</h2><p class="lead">Permintaan Anda masuk melalui WhatsApp STIFIn Mulia. Tim akan memeriksa ketersediaan promotor, lalu membantu proses penghubungan.</p><div class="notice">Nomor pribadi promotor tidak ditampilkan pada website. Cara ini membantu menjaga data pribadi dan memastikan calon peserta menerima kontak yang sudah diperiksa.</div></div><form id="network-form" class="network-form" data-wa-number={site.whatsapp}><label>Kota atau kabupaten<input id="network-city" name="city" required placeholder="Contoh: Balikpapan" /></label><label>Provinsi atau negara<input id="network-province" name="province" required placeholder="Contoh: Kalimantan Timur" /></label><label>Kebutuhan<select id="network-need" name="need"><option>Tes STIFIn pribadi</option><option>Tes STIFIn keluarga</option><option>Tes kelompok atau lembaga</option><option>Menjadi promotor</option></select></label><button class="button" type="submit">Kirim Permintaan via WhatsApp</button></form></div></section>

  <section class="section soft"><div class="container"><div class="section-head"><div><span class="eyebrow">Cakupan pencarian</span><h2>Jaringan wilayah yang dapat diperiksa</h2><p class="lead">Ketersediaan promotor berbeda pada setiap kota dan jadwal. Tim akan melakukan konfirmasi sebelum memberikan kontak.</p></div></div><div class="region-grid">{regions.map((region) => <div>{region}</div>)}</div></div></section>

  {networkLocations.length > 0 && <section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Data jaringan aktif</span><h2>Wilayah yang tercatat dari sistem</h2><p class="lead">Data menampilkan jumlah promotor aktif tanpa membuka nomor telepon atau data pribadi.</p></div></div><div class="location-grid">{networkLocations.map((location) => <a href={`/promotor/${location.slug}/`}><span>{location.province}</span><strong>{location.city}</strong><small>{location.promoters} promotor aktif</small></a>)}</div></div></section>}

  <Callout title="Belum menemukan kota Anda?" text="Tetap kirimkan wilayah Anda. Tim akan memeriksa jaringan kepala cabang dan promotor yang tersedia." message="Assalamu’alaikum, saya ingin mencari promotor STIFIn. Kota/Kabupaten: ... Provinsi/Negara: ... Kebutuhan: ..." />
</BaseLayout>
<script>
  const form = document.querySelector<HTMLFormElement>('#network-form');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const number = form.dataset.waNumber;
    const city = (document.querySelector<HTMLInputElement>('#network-city')?.value || '').trim();
    const province = (document.querySelector<HTMLInputElement>('#network-province')?.value || '').trim();
    const need = document.querySelector<HTMLSelectElement>('#network-need')?.value || 'Tes STIFIn';
    const message = `Assalamu’alaikum, saya ingin mencari promotor STIFIn. Kota/Kabupaten: ${city}. Provinsi/Negara: ${province}. Kebutuhan: ${need}.`;
    window.open(`https://wa.me/${number}?text=${encodeURIComponent(message)}`, '_blank', 'noopener,noreferrer');
  });
</script>
<style>
  .search-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(35px,7vw,90px);align-items:start}.network-form{display:grid;gap:16px;padding:28px;border:1px solid var(--line);border-radius:var(--radius);background:white;box-shadow:var(--shadow)}.network-form label{display:grid;gap:7px;color:var(--green-950);font-size:.9rem;font-weight:800}.network-form input,.network-form select{width:100%;min-height:48px;padding:11px 13px;border:1px solid #bfd2ca;border-radius:12px;background:white;color:var(--ink);font:inherit}.region-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.region-grid div{padding:20px;border:1px solid var(--line);border-radius:var(--radius-sm);background:white;color:var(--green-900);font-weight:850}.location-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.location-grid a{display:grid;gap:5px;padding:22px;border:1px solid var(--line);border-radius:var(--radius-sm);background:white}.location-grid span,.location-grid small{color:var(--muted);font-size:.82rem}.location-grid strong{color:var(--green-950);font-size:1.15rem}@media(max-width:850px){.search-grid{grid-template-columns:1fr}.region-grid,.location-grid{grid-template-columns:1fr 1fr}}@media(max-width:540px){.region-grid,.location-grid{grid-template-columns:1fr}}
</style>
