---
import CampaignLayout from '../layouts/CampaignLayout.astro';
import { site } from '../data/site';
---
<CampaignLayout title="Terima Kasih | Minat WSL 1 STIFIn" description="Data minat WSL 1 Anda sudah diterima oleh STIFIn Mulia." pixelEvent="Lead">
  <section class="thanks"><div class="campaign-container thanks-grid"><div><span class="success-mark">✓</span><span class="campaign-kicker">Minat WSL 1 sudah dicatat</span><h1>Terima kasih. Lanjutkan percakapan agar tim dapat mencarikan kelas yang sesuai.</h1><p class="lead">Tekan tombol WhatsApp untuk mengirim ringkasan data Anda. Tim akan mengecek status tes, tujuan belajar, jadwal, dan informasi biaya.</p><a id="continue-wa" class="thanks-button" data-wa={site.whatsapp} href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer">Lanjutkan ke WhatsApp</a><p class="small-note">WhatsApp pusat STIFIn Mulia: {site.phoneDisplay}</p></div><aside><strong>Langkah berikutnya</strong><ol><li>Tim memeriksa hasil tes dan tujuan belajar Anda.</li><li>Pilihan jadwal serta format WSL 1 disampaikan.</li><li>Anda menerima informasi biaya sebelum memutuskan.</li><li>Setelah WSL 1, Anda dapat menerapkan hasil atau mengeksplorasi jalur promotor.</li></ol><a href="/wsl-1/">Baca kembali manfaat WSL 1</a></aside></div></section>
  <script>
    const button = document.querySelector<HTMLAnchorElement>('#continue-wa');
    let lead: Record<string,string> = {};
    try { lead = JSON.parse(sessionStorage.getItem('stifinWslLead') || '{}'); } catch {}
    const message = ['Assalamu’alaikum, saya sudah mengisi form minat WSL 1 di stifinmulia.com.',`Nama: ${lead.name || '...'}`,`Kota: ${lead.city || '...'}`,`Hasil Tes STIFIn: ${lead.stifin_result || '...'}`,`Tujuan belajar: ${lead.learning_goal || '...'}`,`Pertanyaan utama: ${lead.main_question || '...'}`,`Sumber: ${lead.utm_source || 'website'} / ${lead.utm_campaign || '-'}`,'Mohon informasi jadwal WSL 1 yang tersedia.'].join('\n');
    if (button) button.href = `https://wa.me/${button.dataset.wa || ''}?text=${encodeURIComponent(message)}`;
  </script>
</CampaignLayout>
<style>.thanks{min-height:76vh;padding:clamp(65px,10vw,125px) 0;background:radial-gradient(circle at 82% 10%,rgba(131,169,71,.18),transparent 25rem),#f7f8f4}.thanks-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(40px,8vw,95px);align-items:center}.success-mark{display:grid;width:60px;height:60px;margin-bottom:25px;place-items:center;border-radius:50%;background:var(--green-950);color:white;font-size:1.55rem;font-weight:900}.campaign-kicker{color:var(--green-700);font-size:.74rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase}.thanks h1{max-width:760px;font-size:clamp(2.5rem,5.8vw,4.7rem);line-height:1.03;text-wrap:balance}.thanks-button{display:inline-flex;min-height:56px;align-items:center;justify-content:center;margin-top:22px;padding:13px 22px;border-radius:12px;background:var(--green-950);color:white;font-weight:850;box-shadow:var(--shadow-soft)}.small-note{margin-top:11px;font-size:.8rem}.thanks aside{padding:clamp(26px,4vw,42px);border:1px solid var(--line);border-radius:22px;background:white;box-shadow:var(--shadow)}.thanks aside>strong{font-family:var(--font-display);font-size:1.5rem}.thanks ol{padding-left:21px}.thanks li{margin:14px 0;color:var(--muted)}.thanks aside a{color:var(--green-800);font-weight:800;text-decoration:underline}@media(max-width:800px){.thanks-grid{grid-template-columns:1fr}}</style>
