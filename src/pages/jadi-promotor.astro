---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Callout from '../components/Callout.astro';
import { waLink } from '../data/site';
---
<BaseLayout title="Biaya dan Cara Jadi Promotor STIFIn | STIFIn Mulia" description="Lihat biaya, fasilitas, tahapan belajar, alat tes, dan pendampingan untuk menjadi Promotor STIFIn bersama STIFIn Mulia.">
  <PageHero eyebrow="Jadi Promotor STIFIn" title="Belajar, miliki alat tes, lalu mulai melayani peserta" description="Program ini membantu Anda memahami konsep STIFIn, mengikuti pembelajaran resmi, memperoleh ID dan alat tes, serta memulai kegiatan dengan pendampingan."><div class="actions"><a class="button" href={waLink('Assalamu’alaikum, saya ingin mendaftar program Promotor STIFIn. Nama: ... Kota: ...')} target="_blank" rel="noreferrer">Daftar Jadi Promotor</a><a class="button secondary" href="#biaya">Lihat Biaya Program</a></div></PageHero>

  <section id="biaya" class="section price-section"><div class="container"><div class="section-head"><div><span class="eyebrow">Biaya ditampilkan terbuka</span><h2>Pilih cara pembayaran yang sesuai</h2><p class="lead">Biaya ditampilkan langsung agar Anda dapat mempertimbangkannya sejak awal.</p></div></div><div class="pricing"><article class="price-card featured"><span class="price-label">Bayar penuh</span><h3>Program Promotor STIFIn</h3><div class="price">Rp8.000.000</div><p>Satu kali pembayaran untuk mengikuti rangkaian program.</p><a class="button" href={waLink('Assalamu’alaikum, saya ingin mendaftar Program Promotor STIFIn dengan pembayaran penuh Rp8.000.000. Nama: ... Kota: ...')} target="_blank" rel="noreferrer">Pilih Bayar Penuh</a></article><article class="price-card"><span class="price-label">Pembayaran bertahap</span><h3>Program Promotor STIFIn</h3><div class="price">Rp10.000.000</div><p>Uang muka Rp5.000.000, lalu 5 kali pembayaran masing-masing Rp1.000.000.</p><a class="button secondary" href={waLink('Assalamu’alaikum, saya ingin mendaftar Program Promotor STIFIn dengan pembayaran bertahap. Nama: ... Kota: ...')} target="_blank" rel="noreferrer">Pilih Pembayaran Bertahap</a></article></div><div class="price-note"><strong>Catatan:</strong> Angka di atas mengikuti sumber program yang diberikan. Biaya, jadwal, alat, serta ketentuan pendaftaran akan dikonfirmasi kembali sesuai kebijakan resmi terbaru sebelum pembayaran.</div></div></section>

  <section class="section soft"><div class="container"><div class="section-head"><div><span class="eyebrow">Yang Anda dapatkan</span><h2>Bukan hanya alat tes</h2><p class="lead">Anda mengikuti proses belajar sampai siap menjalankan layanan sesuai ketentuan.</p></div></div><div class="included"><article><span>01</span><div><h3>WSL 1</h3><p>Empat sesi pembelajaran dasar untuk memahami fondasi konsep dan peran promotor.</p></div></article><article><span>02</span><div><h3>WSL 2 dan praktik</h3><p>Dua belas sesi lanjutan untuk memperkuat pemahaman, komunikasi, dan praktik layanan.</p></div></article><article><span>03</span><div><h3>ID dan alat tes</h3><p>Proses ID serta alat tes dilakukan setelah persyaratan resmi dan administrasi terpenuhi.</p></div></article><article><span>04</span><div><h3>Pendampingan 30 hari</h3><p>Anda didampingi untuk mulai memperkenalkan layanan, mendapatkan peserta, dan menjalankan tes pertama.</p></div></article><article><span>05</span><div><h3>Komunitas dan jaringan</h3><p>Belajar bersama promotor lain dan membangun kegiatan di kota Anda.</p></div></article><article><span>06</span><div><h3>Sistem kerja</h3><p>Mendapatkan panduan untuk mencari peserta, menindaklanjuti calon peserta, dan mencatat kegiatan.</p></div></article></div></div></section>

  <section id="cocok" class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Siapa yang cocok?</span><h2>Untuk orang yang siap belajar dan melayani</h2></div></div><div class="grid-3"><article class="card"><span class="card-icon">01</span><h3>Pendidik dan pembina</h3><p>Guru, dosen, trainer, konsultan, atau pengelola komunitas yang sering mendampingi orang lain.</p></article><article class="card"><span class="card-icon">02</span><h3>Orang tua aktif</h3><p>Orang tua yang tertarik pada pendidikan keluarga dan ingin membagikan manfaat kepada lingkungannya.</p></article><article class="card"><span class="card-icon">03</span><h3>Profesional dan pengusaha</h3><p>Orang yang ingin membangun layanan dengan kegiatan, target, dan jaringan yang jelas.</p></article></div></div></section>

  <section id="proses" class="section soft"><div class="container"><div class="section-head"><div><span class="eyebrow">Cara bergabung</span><h2>Empat langkah sampai mulai menjalankan layanan</h2><p class="lead">Pembelajaran dan pendampingan dapat diikuti secara online. Tes kepada peserta tetap dilakukan secara langsung.</p></div></div><div class="steps"><article class="step"><h3>Daftar dan konsultasi</h3><p>Sampaikan nama, kota, pekerjaan, dan alasan ingin menjadi promotor.</p></article><article class="step"><h3>Ikuti sesi penjelasan</h3><p>Pahami tugas promotor, biaya program, cara kerja, dan ketentuannya.</p></article><article class="step"><h3>Ikuti WSL 1 dan WSL 2</h3><p>Selesaikan pembelajaran dasar, lanjutan, serta praktik yang diwajibkan.</p></article><article class="step"><h3>Mulai dengan pendampingan</h3><p>Terima ID dan alat sesuai proses, lalu jalankan rencana kegiatan 30 hari pertama.</p></article></div></div></section>

  <section class="section"><div class="container two-col"><div><span class="eyebrow">Cara kami membina</span><h2>Anda tidak dilepas setelah selesai belajar</h2><p class="lead">Pendampingan diarahkan pada kegiatan nyata: mengenalkan layanan, mencari peserta, mengatur jadwal tes, menjelaskan proses, dan melakukan tindak lanjut.</p></div><div class="principles"><div><b>Paham materinya</b><p>Mampu menjelaskan dengan bahasa yang benar dan mudah dipahami.</p></div><div><b>Tertib menjalankan proses</b><p>Mencatat calon peserta, jadwal, hasil kegiatan, dan tindak lanjut.</p></div><div><b>Jujur dalam menawarkan</b><p>Tidak menjanjikan hasil atau penghasilan tertentu.</p></div><div><b>Bertumbuh bersama</b><p>Belajar membangun kegiatan dan jaringan secara bertahap.</p></div></div></div></section>
  <Callout title="Siap mendaftar atau masih ingin bertanya?" text="Hubungi kami secara langsung. Kami akan menjelaskan biaya, jadwal pembelajaran, alat tes, dan ketentuan terbaru sebelum Anda memutuskan." message="Assalamu’alaikum, saya ingin bertanya tentang Program Promotor STIFIn. Nama: ... Kota: ... Pertanyaan: ..." />
</BaseLayout>
<style>
  .price-section{background:var(--green-950);color:white}.price-section .lead{color:#c4d9d2}.pricing{display:grid;grid-template-columns:1fr 1fr;gap:20px}.price-card{padding:clamp(28px,5vw,46px);border:1px solid rgba(255,255,255,.16);border-radius:var(--radius);background:#0a4a3e}.price-card.featured{border-color:var(--amber-500);background:white;color:var(--ink)}.price-card.featured p{color:var(--muted)}.price-label{display:inline-flex;margin-bottom:24px;padding:7px 12px;border-radius:999px;background:var(--amber-500);color:#503400;font-size:.78rem;font-weight:850;text-transform:uppercase}.price{margin:17px 0 12px;font-size:clamp(2.2rem,5vw,3.7rem);font-weight:900;letter-spacing:-.05em}.price-card p{min-height:58px;color:#c4d9d2}.price-card .button{margin-top:10px;width:100%}.price-note{margin-top:20px;padding:18px 20px;border:1px solid rgba(255,255,255,.13);border-radius:var(--radius-sm);color:#c4d9d2;font-size:.9rem}.included{display:grid;grid-template-columns:1fr 1fr;gap:14px}.included article{display:flex;gap:18px;padding:25px;border:1px solid var(--line);border-radius:var(--radius-sm);background:white}.included article>span{display:grid;flex:0 0 42px;height:42px;place-items:center;border-radius:12px;background:var(--green-100);color:var(--green-800);font-size:.8rem;font-weight:900}.included h3{margin:3px 0 8px}.included p{margin:0}.two-col{display:grid;grid-template-columns:1fr 1fr;gap:clamp(40px,8vw,110px);align-items:start}.principles{display:grid;grid-template-columns:1fr 1fr;gap:14px}.principles div{padding:22px;border:1px solid var(--line);border-radius:var(--radius-sm);background:white}.principles p{margin:5px 0 0}@media(max-width:760px){.pricing,.included,.two-col,.principles{grid-template-columns:1fr}.price-card p{min-height:auto}}
</style>
