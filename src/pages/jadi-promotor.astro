---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Callout from '../components/Callout.astro';
import { waLink } from '../data/site';
---
<BaseLayout title="Biaya dan Cara Jadi Promotor STIFIn | STIFIn Mulia" description="Lihat kecocokan, biaya, fasilitas, tahap belajar, alat tes, dan pendampingan untuk menjadi Promotor STIFIn bersama STIFIn Mulia.">
  <PageHero eyebrow="Program Promotor STIFIn" title="Ingin membawa layanan STIFIn ke lingkungan Anda—dan siap mempelajarinya dengan tertib?" description="Program ini ditujukan bagi calon promotor yang siap belajar, mengikuti proses resmi, melayani peserta secara langsung, dan membangun kegiatan secara bertahap dengan pendampingan.">
    <div class="actions"><a class="button" data-wa-intent="promotor-hero-konsultasi" href={waLink('Assalamu’alaikum, saya ingin mengecek kecocokan Program Promotor STIFIn. Nama: ... Kota: ... Pekerjaan/kegiatan saat ini: ... Alasan tertarik: ...')} target="_blank" rel="noopener noreferrer">Cek Kecocokan Program</a><a class="button secondary" href="#isi-program">Lihat Isi Program</a></div>
    <p class="microcopy">Percakapan awal tidak mengikat. Biaya, jadwal, alat, dan ketentuan terbaru dijelaskan sebelum Anda mendaftar.</p>
  </PageHero>

  <section class="section-tight"><div class="container proof-strip"><div><strong>Pembelajaran bertahap</strong><span>Fondasi, materi lanjutan, dan praktik dijalani sebelum mulai melayani.</span></div><div><strong>ID dan alat tes</strong><span>Diproses setelah persyaratan resmi serta administrasi terpenuhi.</span></div><div><strong>Pendampingan awal</strong><span>Ada arahan untuk menyusun kegiatan dan menjalankan layanan pertama.</span></div></div></section>

  <section id="cocok" class="section"><div class="container split"><div><span class="eyebrow">Saring sejak awal</span><h2>Program ini cocok bila Anda siap belajar sekaligus melayani</h2><p class="lead">Menjadi promotor bukan sekadar memiliki alat. Ada materi yang perlu dipahami, proses yang perlu dijalankan, dan peserta yang perlu dilayani dengan bertanggung jawab.</p></div><ul class="check-list"><li><strong>Pendidik atau pembina</strong><br />Sering mendampingi siswa, orang tua, peserta kelas, atau komunitas.</li><li><strong>Orang tua yang aktif di lingkungan</strong><br />Ingin membawa kegiatan pengenalan diri dan keluarga secara terarah.</li><li><strong>Profesional atau pengusaha</strong><br />Siap mengelola jadwal, tindak lanjut, dan jaringan secara konsisten.</li><li><strong>Belum cocok bila mencari hasil instan</strong><br />Program tidak menjanjikan penghasilan tertentu dan tetap membutuhkan usaha nyata.</li></ul></div></section>

  <section class="section soft"><div class="container"><div class="section-head"><div><span class="eyebrow">Gambaran setelah belajar</span><h2>Yang dibangun bukan hanya pengetahuan</h2><p class="lead">Setiap bagian program diarahkan pada kemampuan yang akan dipakai saat bertemu calon peserta dan menjalankan layanan.</p></div></div><div class="grid-3"><article class="card"><span class="card-icon">01</span><h3>Lebih siap menjelaskan</h3><p>Materi dasar dan lanjutan membantu Anda menerangkan proses dengan bahasa yang mudah dipahami.</p></article><article class="card"><span class="card-icon">02</span><h3>Lebih tertib melayani</h3><p>Sistem kerja membantu Anda mencatat calon peserta, mengatur jadwal, dan melakukan tindak lanjut.</p></article><article class="card"><span class="card-icon">03</span><h3>Tidak mulai sendirian</h3><p>Pendampingan dan komunitas memberi tempat untuk bertanya saat mulai menjalankan kegiatan.</p></article></div></div></section>

  <section id="isi-program" class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Isi program</span><h2>Apa yang Anda ikuti dan terima</h2><p class="lead">Rincian akhir tetap dikonfirmasi kembali agar sesuai kebijakan resmi yang berlaku saat pendaftaran.</p></div></div><div class="included"><article><span>01</span><div><h3>WSL 1</h3><p>Empat sesi pembelajaran dasar untuk memahami fondasi konsep dan peran promotor.</p></div></article><article><span>02</span><div><h3>WSL 2 dan praktik</h3><p>Dua belas sesi lanjutan untuk memperkuat pemahaman, komunikasi, dan praktik layanan.</p></div></article><article><span>03</span><div><h3>ID dan alat tes</h3><p>Proses ID serta alat tes dilakukan setelah persyaratan resmi dan administrasi terpenuhi.</p></div></article><article><span>04</span><div><h3>Pendampingan 30 hari</h3><p>Arahan untuk mengenalkan layanan, memperoleh calon peserta, dan menyiapkan tes pertama.</p></div></article><article><span>05</span><div><h3>Komunitas dan jaringan</h3><p>Ruang belajar bersama promotor lain dan membangun kegiatan di wilayah Anda.</p></div></article><article><span>06</span><div><h3>Sistem kerja</h3><p>Panduan untuk mencari peserta, menindaklanjuti permintaan, dan mencatat kegiatan.</p></div></article></div></div></section>

  <section id="proses" class="section soft"><div class="container"><div class="section-head"><div><span class="eyebrow">Cara bergabung</span><h2>Empat langkah sampai mulai menjalankan layanan</h2><p class="lead">Pembelajaran dan pendampingan dapat diikuti secara online. Tes kepada peserta tetap dilakukan secara langsung.</p></div></div><div class="steps"><article class="step"><h3>Cek kecocokan</h3><p>Sampaikan kota, aktivitas saat ini, tujuan, dan kesiapan waktu Anda.</p></article><article class="step"><h3>Pahami program</h3><p>Pelajari tugas promotor, biaya, jadwal, cara kerja, dan ketentuan resminya.</p></article><article class="step"><h3>Ikuti pembelajaran</h3><p>Selesaikan WSL 1, WSL 2, serta praktik yang diwajibkan.</p></article><article class="step"><h3>Mulai didampingi</h3><p>Setelah proses ID dan alat selesai, jalankan rencana kegiatan 30 hari pertama.</p></article></div></div></section>

  <section id="biaya" class="section price-section"><div class="container"><div class="section-head"><div><span class="eyebrow">Biaya terbuka sejak awal</span><h2>Dua pilihan pembayaran</h2><p class="lead">Pilih setelah Anda memahami isi program dan menerima konfirmasi ketentuan terbaru.</p></div></div><div class="pricing"><article class="price-card featured"><span class="price-label">Total lebih rendah</span><h3>Bayar penuh</h3><div class="price">Rp8.000.000</div><p>Satu kali pembayaran untuk mengikuti rangkaian program.</p><a class="button" href={waLink('Assalamu’alaikum, saya ingin meminta konfirmasi terbaru untuk Program Promotor STIFIn dengan pembayaran penuh. Nama: ... Kota: ...')} target="_blank" rel="noopener noreferrer">Minta Konfirmasi Terbaru</a></article><article class="price-card"><span class="price-label">Pembayaran bertahap</span><h3>Cicilan program</h3><div class="price">Rp10.000.000</div><p>Uang muka Rp5.000.000, lalu 5 kali pembayaran masing-masing Rp1.000.000.</p><a class="button secondary" href={waLink('Assalamu’alaikum, saya ingin meminta konfirmasi terbaru untuk Program Promotor STIFIn dengan pembayaran bertahap. Nama: ... Kota: ...')} target="_blank" rel="noopener noreferrer">Tanyakan Skema Bertahap</a></article></div><div class="price-note"><strong>Penting:</strong> Angka mengikuti sumber program yang diberikan untuk pengembangan website. Biaya, jadwal, alat, isi program, dan ketentuan pendaftaran wajib dikonfirmasi kembali sebelum pembayaran.</div></div></section>

  <section class="section"><div class="container split"><div><span class="eyebrow">Cara kami membina</span><h2>Kejujuran lebih penting daripada janji berlebihan</h2><p class="lead">Kami tidak menjanjikan penghasilan tertentu. Pendampingan diarahkan pada kemampuan memahami materi, melayani peserta, menata kegiatan, dan bertumbuh secara bertahap.</p></div><ul class="check-list"><li>Paham materi sebelum menjelaskannya kepada peserta.</li><li>Tertib mencatat calon peserta, jadwal, dan tindak lanjut.</li><li>Menawarkan layanan tanpa klaim hasil atau penghasilan pasti.</li><li>Mau mengevaluasi kegiatan dan terus belajar bersama jaringan.</li></ul></div></section>

  <Callout title="Masih menimbang apakah program ini sesuai?" text="Kirim profil singkat dan alasan Anda tertarik. Tim akan menjelaskan program secara terbuka agar Anda dapat memutuskan dengan tenang." message="Assalamu’alaikum, saya ingin mengecek kecocokan Program Promotor STIFIn. Nama: ... Kota: ... Pekerjaan/kegiatan saat ini: ... Alasan tertarik: ... Pertanyaan: ..." />
</BaseLayout>
<style>
  .included{display:grid;grid-template-columns:1fr 1fr;gap:14px}.included article{position:relative;display:flex;gap:18px;padding:25px;border:1px solid var(--line);border-radius:var(--radius-sm);background:white;box-shadow:var(--shadow-soft);transition:transform .2s ease,border-color .2s ease}.included article:hover{transform:translateY(-3px);border-color:#b8cdbf}.included article:nth-child(3n+2){background:var(--cream)}.included article>span{display:grid;flex:0 0 42px;height:42px;place-items:center;border-radius:12px;background:var(--green-100);color:var(--green-800);font-size:.8rem;font-weight:900}.included h3{margin:3px 0 8px}.included p{margin:0}.price-section{position:relative;overflow:hidden;background:linear-gradient(135deg,var(--green-950),#07583a);color:white}.price-section::after{position:absolute;right:-150px;bottom:-210px;width:500px;height:500px;border:80px solid rgba(255,255,255,.04);border-radius:50%;content:''}.price-section .container{position:relative;z-index:1}.price-section .lead{color:#c4d9d2}.pricing{display:grid;grid-template-columns:1fr 1fr;gap:20px}.price-card{padding:clamp(28px,5vw,46px);border:1px solid rgba(255,255,255,.16);border-radius:var(--radius);background:rgba(1,35,23,.34);backdrop-filter:blur(8px)}.price-card.featured{border-color:#cfe0ad;background:white;color:var(--ink);box-shadow:var(--shadow)}.price-card.featured p{color:var(--muted)}.price-label{display:inline-flex;margin-bottom:24px;padding:7px 12px;border-radius:8px;background:#dce9bd;color:var(--green-950);font-size:.74rem;font-weight:850;letter-spacing:.06em;text-transform:uppercase}.price{margin:17px 0 12px;font-family:var(--font-display);font-size:clamp(2.2rem,5vw,3.7rem);font-weight:700;letter-spacing:-.05em}.price-card p{min-height:58px;color:#c4d9d2}.price-card .button{width:100%;margin-top:10px}.price-note{margin-top:20px;padding:18px 20px;border:1px solid rgba(255,255,255,.13);border-radius:var(--radius-sm);color:#c4d9d2;font-size:.9rem}@media(max-width:760px){.pricing,.included{grid-template-columns:1fr}.price-card p{min-height:auto}}
</style>
