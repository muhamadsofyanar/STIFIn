---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Callout from '../components/Callout.astro';
---
<BaseLayout title="Jadi Promotor STIFIn | STIFIn Mulia" description="Pelajari jalur calon promotor, pembinaan, aktivasi, dan pengembangan kepemimpinan bersama STIFIn Mulia.">
  <PageHero eyebrow="Jalur Promotor" title="Bangun layanan, kompetensi, dan jaringan yang bertumbuh" description="Jalur promotor dirancang untuk orang yang siap belajar, melayani, mengikuti standar, dan bergerak dengan pendampingan."><div class="actions"><a class="button" href="#proses">Lihat Proses Bergabung</a><a class="button secondary" href="#cocok">Apakah cocok untuk saya?</a></div></PageHero>
  <section id="cocok" class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Karakter yang dicari</span><h2>Bukan hanya ingin bergabung, tetapi siap bertumbuh</h2></div></div><div class="grid-3"><article class="card"><span class="card-icon">01</span><h3>Mau belajar</h3><p>Terbuka mempelajari konsep, cara komunikasi, layanan, dan aturan resmi.</p></article><article class="card"><span class="card-icon">02</span><h3>Siap melayani</h3><p>Menempatkan kebutuhan peserta, integritas data, dan kualitas tindak lanjut sebagai prioritas.</p></article><article class="card"><span class="card-icon">03</span><h3>Konsisten bergerak</h3><p>Bersedia menjalankan aktivitas, mencatat progres, dan mengikuti pembinaan.</p></article></div></div></section>
  <section id="proses" class="section soft"><div class="container"><div class="section-head"><div><span class="eyebrow">Proses bertahap</span><h2>Dari ketertarikan menuju aktivasi</h2><p class="lead">Sebagian besar proses berlangsung online agar dapat diikuti dari berbagai kota.</p></div></div><div class="steps"><article class="step"><h3>Konsultasi peluang</h3><p>Kenali peran, tanggung jawab, dan kesesuaiannya dengan tujuan Anda.</p></article><article class="step"><h3>Opportunity sharing</h3><p>Pelajari ekosistem, cara kerja, dan tahapan resmi yang berlaku.</p></article><article class="step"><h3>Pembelajaran dan alat</h3><p>Ikuti kegiatan pembelajaran serta proses administratif yang ditetapkan.</p></article><article class="step"><h3>Aktivasi 30 hari</h3><p>Mulai dengan target sederhana, pendampingan, dan evaluasi progres.</p></article></div></div></section>
  <section class="section"><div class="container two-col"><div><span class="eyebrow">Yang dibangun</span><h2>Promotor profesional dan berintegritas</h2><p class="lead">STIFIn Mulia mengembangkan promotor yang aktif, tertib data, mampu berkomunikasi, dan bertumbuh menjadi pemimpin lokal.</p></div><div class="principles"><div><b>Ilmu</b><p>Memahami materi dan batas komunikasi.</p></div><div><b>Sistem</b><p>Menggunakan alur kerja, data, dan tindak lanjut.</p></div><div><b>Nilai</b><p>Menjaga amanah, adab, serta kualitas pelayanan.</p></div><div><b>Kepemimpinan</b><p>Mampu membina dan menggerakkan lingkungan.</p></div></div></div></section>
  <Callout title="Kenali jalur promotor lebih dahulu" text="Mulai melalui percakapan singkat. Kami akan menjelaskan proses, komitmen, dan ketentuan yang sedang berlaku." message="Assalamu’alaikum, saya tertarik mempelajari peluang menjadi Promotor STIFIn bersama STIFIn Mulia. Kota saya: ..." />
</BaseLayout>
<style>
  .two-col{display:grid;grid-template-columns:1fr 1fr;gap:clamp(40px,8vw,110px);align-items:start}.principles{display:grid;grid-template-columns:1fr 1fr;gap:14px}.principles div{padding:22px;border:1px solid var(--line);border-radius:var(--radius-sm);background:white}.principles p{margin:5px 0 0}@media(max-width:760px){.two-col,.principles{grid-template-columns:1fr}}
</style>
