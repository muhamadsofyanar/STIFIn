---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import OfferDecisionEngine from '../components/OfferDecisionEngine.astro';
import { offers } from '../data/offers';

const questions = [
  ['Apakah saya harus langsung menentukan paket?', 'Tidak. Gunakan asisten pemilihan untuk memperoleh rekomendasi awal, lalu diskusikan kota, waktu, jumlah peserta, dan kebutuhan sebelum mengonfirmasi.'],
  ['Mengapa biaya tidak ditampilkan sebagai satu angka?', 'Biaya resmi dikonfirmasi berdasarkan jenis layanan, jumlah peserta, lokasi, jadwal, dan ketentuan yang berlaku. Dengan begitu, Anda tidak menerima angka lama atau penawaran yang tidak sesuai konteks.'],
  ['Apakah konsultasi awal membuat saya wajib mendaftar?', 'Tidak. Percakapan awal dipakai untuk memperjelas kebutuhan dan pilihan yang tersedia. Anda tetap memutuskan setelah menerima informasi yang diperlukan.'],
  ['Apakah Tes STIFIn dapat dilakukan secara daring?', 'Konsultasi dan koordinasi dapat dilakukan dari jarak jauh, tetapi proses tes dilaksanakan dengan pertemuan langsung sesuai jadwal dan lokasi yang disepakati.'],
  ['Kalau sudah pernah tes, sebaiknya memilih apa?', 'Bila hasil belum dipahami, mulailah dari penjelasan hasil. Bila ingin mendalami bahasa dasar STIFIn, pertimbangkan WSL 1. Jalur promotor dipelajari setelah posisi dan kesiapan Anda diperiksa.'],
  ['Bagaimana jika belum ada jadwal di kota saya?', 'Tim akan memeriksa jaringan dan pilihan yang tersedia. Permintaan Anda tidak dianggap sebagai janji bahwa promotor atau jadwal pasti tersedia di setiap wilayah.'],
  ['Apakah hasil tes menentukan sekolah, pasangan, atau profesi?', 'Tidak. Hasil digunakan sebagai salah satu peta pengenalan diri dan bahan berdiskusi, bukan vonis atau satu-satunya dasar untuk keputusan besar.'],
  ['Apa yang terjadi setelah formulir dikirim?', 'WhatsApp akan terbuka dengan ringkasan kebutuhan Anda. Tim kemudian memeriksa informasi, meminta detail bila diperlukan, dan menyampaikan pilihan jadwal, lokasi, biaya resmi, serta langkah berikutnya.'],
];
const schema = [
  {
    '@context': 'https://schema.org', '@type': 'WebPage',
    name: 'Pilih Layanan STIFIn Mulia',
    description: 'Bandingkan layanan Tes STIFIn individual, keluarga, kelompok, WSL 1, dan jalur promotor lalu minta rekomendasi sesuai kebutuhan.',
    url: new URL('/pilih-layanan/', Astro.site).toString(),
  },
  {
    '@context': 'https://schema.org', '@type': 'ItemList',
    name: 'Pilihan layanan STIFIn Mulia',
    itemListElement: offers.map((offer, index) => ({ '@type': 'ListItem', position: index + 1, item: { '@type': 'Service', name: offer.label, description: offer.promise, provider: { '@id': new URL('/#organization', Astro.site).toString() } } })),
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: questions.map(([question, answer]) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })),
  },
];
---
<BaseLayout title="Pilih Layanan STIFIn | STIFIn Mulia" description="Belum yakin harus mulai dari Tes STIFIn, program keluarga, WSL 1, atau promotor? Bandingkan pilihan dan dapatkan rekomendasi awal." schema={schema}>
  <PageHero eyebrow="Mulai dari kebutuhan, bukan nama paket" title="Pilih langkah yang sesuai dengan posisi Anda hari ini." description="Anda tidak harus memahami seluruh jalur STIFIn sekaligus. Bandingkan pilihan, jawab tiga pertanyaan, lalu minta tim menyiapkan langkah yang tersedia di kota Anda." />

  <section class="section-tight trust"><div class="container proof-strip"><div><strong>Rekomendasi sebelum kontak</strong><span>Lihat pilihan tanpa memasukkan nomor WhatsApp.</span></div><div><strong>Informasi tidak dikarang</strong><span>Biaya dan jadwal dikonfirmasi berdasarkan kondisi nyata.</span></div><div><strong>Keputusan tetap milik Anda</strong><span>Percakapan awal tidak membuat Anda wajib mendaftar.</span></div></div></section>

  <section class="section offers-section"><div class="container"><div class="section-head"><div><span class="eyebrow">Lima pintu layanan</span><h2>Tujuan berbeda membutuhkan langkah awal yang berbeda.</h2><p class="lead">Setiap layanan dijelaskan dari siapa yang cocok, apa yang dijalani, dan apa yang dapat dibawa pulang—bukan sekadar nama program.</p></div></div><div class="offer-grid">{offers.map((offer, index) => <article class:list={{featured:index===0}}><div class="offer-number">{String(index+1).padStart(2,'0')}</div><small>{offer.kicker}</small><h3>{offer.label}</h3><p>{offer.promise}</p><div class="fit"><strong>Cocok ketika</strong><span>{offer.fit}</span></div><strong>Yang disiapkan</strong><ul>{offer.includes.map((item)=><li>{item}</li>)}</ul><div class="outcome"><strong>Yang ingin dicapai</strong><p>{offer.outcome}</p></div><div class="offer-actions"><a class="button secondary" href={`/pilih-layanan/?layanan=${offer.id}#pilihkan`}>Pilih Layanan Ini</a><a href={offer.detailHref}>{offer.detailLabel} →</a></div></article>)}</div></div></section>

  <section class="section engine-section" id="pilihkan"><div class="container"><OfferDecisionEngine /></div></section>

  <section class="section next-process"><div class="container"><div class="section-head"><div><span class="eyebrow">Setelah Anda mengirim permintaan</span><h2>Tidak langsung disuruh membayar. Kebutuhan diperiksa lebih dahulu.</h2></div></div><div class="process-grid"><article><span>01</span><h3>Ringkasan diterima</h3><p>Nama, kota, jumlah peserta, waktu, dan kebutuhan terbawa ke WhatsApp pusat.</p></article><article><span>02</span><h3>Tim memeriksa</h3><p>Tim mengecek kelengkapan kebutuhan, jaringan, serta pilihan pelaksanaan yang mungkin.</p></article><article><span>03</span><h3>Pilihan dijelaskan</h3><p>Anda memperoleh informasi jadwal, lokasi, biaya resmi, persiapan, dan ketentuan terbaru.</p></article><article><span>04</span><h3>Anda mengonfirmasi</h3><p>Keputusan dibuat setelah informasinya jelas. Jadwal baru diproses sesuai kesepakatan.</p></article></div></div></section>

  <section class="section objection-section"><div class="container objection-grid"><div><span class="eyebrow">Jawaban sebelum memutuskan</span><h2>Ragu boleh. Informasinya harus tetap jelas.</h2><p class="lead">Pertanyaan ini disiapkan agar Anda memahami proses, bukan agar merasa didesak mengambil keputusan.</p><a class="text-link" href="/bukti/">Periksa Pusat Bukti →</a></div><div class="faq-list">{questions.map(([question,answer])=><details><summary>{question}</summary><p>{answer}</p></details>)}</div></div></section>

  <section class="section"><div class="container closing"><span class="eyebrow">Masih belum yakin?</span><h2>Gunakan Temukan Langkah Saya untuk memahami kebutuhan lebih dahulu.</h2><p>Jika pilihan layanan terasa terlalu cepat, jawab empat pertanyaan tentang situasi, audiens, kesiapan, dan waktu mulai. Anda akan memperoleh bacaan serta bukti yang lebih kontekstual.</p><div class="actions"><a class="button" href="/perjalanan/">Temukan Langkah Saya</a><a class="button secondary" href="/apakah-tes-stifin-cocok-untuk-saya/">Buka Pusat Keputusan</a></div></div></section>
</BaseLayout>

<style>
  .trust{border-bottom:1px solid var(--line);background:#fff}.offers-section{background:#f8faf6}.offer-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}.offer-grid article{position:relative;display:flex;min-height:100%;flex-direction:column;padding:clamp(25px,4vw,38px);overflow:hidden;border:1px solid var(--line);border-radius:20px;background:#fff;box-shadow:var(--shadow-soft)}.offer-grid article:last-child{grid-column:1/-1}.offer-grid article.featured{background:linear-gradient(145deg,#fff,#edf4ea);border-color:#b9cdbf}.offer-number{position:absolute;top:20px;right:24px;color:#d8e5dc;font-family:var(--font-display);font-size:3.2rem;font-weight:800}.offer-grid small{position:relative;color:var(--green-700);font-weight:900;text-transform:uppercase;letter-spacing:.1em}.offer-grid h3{position:relative;margin:15px 0;font-size:1.65rem}.fit,.outcome{margin:20px 0;padding:18px;border-radius:13px;background:var(--cream)}.fit strong,.fit span,.outcome strong{display:block}.fit span{margin-top:5px;color:var(--muted);font-size:.86rem}.offer-grid ul{padding-left:20px}.offer-grid li{margin:8px 0;color:var(--muted);font-size:.88rem}.outcome p{margin:6px 0 0;font-size:.86rem}.offer-actions{display:flex;flex-wrap:wrap;align-items:center;gap:15px;margin-top:auto;padding-top:12px}.offer-actions>a:not(.button),.text-link{color:var(--green-800);font-weight:850}.engine-section{background:linear-gradient(145deg,#e3eee6,#f4f8f4)}.next-process{background:var(--green-950);color:#fff}.next-process .eyebrow{color:#a8c36f}.process-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:2px;overflow:hidden;border-radius:18px;background:rgba(255,255,255,.12)}.process-grid article{padding:27px;background:rgba(255,255,255,.06)}.process-grid span{color:var(--amber-500);font-weight:900}.process-grid p{color:#c4d9d1;font-size:.86rem}.objection-section{background:#f8faf6}.objection-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(35px,7vw,90px);align-items:start}.faq-list{display:grid;gap:10px}.faq-list details{padding:20px 22px;border:1px solid var(--line);border-radius:13px;background:#fff}.faq-list summary{color:var(--green-950);font-family:var(--font-display);font-weight:700;cursor:pointer}.faq-list p{margin:13px 0 0}.closing{max-width:900px;text-align:center}.closing p{max-width:720px;margin-inline:auto}.closing .actions{justify-content:center}@media(max-width:900px){.process-grid{grid-template-columns:1fr 1fr}.objection-grid{grid-template-columns:1fr}}@media(max-width:680px){.offer-grid{grid-template-columns:1fr}.offer-grid article:last-child{grid-column:auto}.process-grid{grid-template-columns:1fr}.offer-actions>*{width:100%;text-align:center}}
</style>
