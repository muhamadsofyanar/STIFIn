---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Callout from '../components/Callout.astro';
const faqs = [
  ['Apa hubungan STIFIn Mulia dengan STIFIn dan SGI?', 'STIFIn Mulia dikelola oleh Muhamad Sofyan AR, Branch Manager STIFIn Genetic Indonesia Cabang Pekalongan. STIFIn Mulia tergabung dalam jaringan STIFIn Genetic Indonesia dan menjalankan layanan berdasarkan ketentuan resmi yang berlaku. Hubungan tersebut merupakan jaringan kerja dan layanan, bukan hubungan atasan dan bawahan.'],
  ['Apakah Tes STIFIn dapat dilakukan dari jarak jauh?', 'Pendaftaran dan konsultasi dapat dilakukan dari jarak jauh. Proses tes dilakukan dengan bertemu langsung.'],
  ['Apakah hasil tes menentukan masa depan seseorang?', 'Tidak. Hasil digunakan sebagai bahan mengenali kecenderungan dalam konsep STIFIn. Hasil tidak menjamin prestasi, karier, relasi, atau keberhasilan tertentu.'],
  ['Apakah tes ini merupakan pemeriksaan psikologi atau medis?', 'Tidak. Tes STIFIn tidak diposisikan sebagai diagnosis medis, psikologis, atau pengganti pemeriksaan profesional.'],
  ['Di wilayah mana layanan tersedia?', 'Fokus utama berada di Bandung Raya dan Sumedang. Wilayah lain dapat dilayani sesuai ketersediaan promotor, jadwal kegiatan, dan ketentuan resmi.'],
  ['Apakah sekolah atau komunitas dapat mengadakan tes kelompok?', 'Bisa. Program kelompok dimulai dari diskusi kebutuhan, jumlah peserta, lokasi, jadwal, PIC, dan bentuk konsultasi hasil.'],
  ['Bagaimana cara menjadi promotor?', 'Mulai dengan membaca biaya dan isi program, lalu hubungi kami untuk mengikuti sesi penjelasan. Setelah itu, Anda dapat mendaftar dan mengikuti pembelajaran resmi.'],
];
---
<BaseLayout title="FAQ | STIFIn Mulia" description="Jawaban atas pertanyaan umum tentang tes, promotor, wilayah layanan, dan kerja sama STIFIn Mulia.">
  <PageHero eyebrow="Pertanyaan Umum" title="Hal yang perlu diketahui sebelum mendaftar" description="Temukan jawaban singkat tentang tes, program promotor, wilayah layanan, dan kerja sama."></PageHero>
  <section class="section"><div class="container faq-list">{faqs.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div></section>
  <Callout title="Belum menemukan jawaban?" text="Sampaikan pertanyaan Anda melalui WhatsApp. Tim akan membantu menjawabnya." message="Assalamu’alaikum, saya memiliki pertanyaan tentang layanan STIFIn Mulia: ..." />
</BaseLayout>
<style>.faq-list{display:grid;max-width:920px;gap:12px}.faq-list details{padding:22px 24px;border:1px solid var(--line);border-radius:var(--radius-sm);background:white;box-shadow:var(--shadow-soft)}.faq-list details[open]{border-color:#b4cabc;background:linear-gradient(145deg,white,#f0f6f1)}.faq-list summary{position:relative;padding-right:32px;color:var(--green-950);font-family:var(--font-display);font-size:1.17rem;font-weight:700;cursor:pointer}.faq-list summary::after{position:absolute;right:0;content:'+';font-family:var(--font-body);font-size:1.35rem}.faq-list details[open] summary::after{content:'–'}.faq-list p{margin:15px 0 0}</style>
