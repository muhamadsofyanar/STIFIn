---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Callout from '../components/Callout.astro';
import SourceReactions from '../components/SourceReactions.astro';
---
<BaseLayout title="Tes STIFIn dan Penjelasan Hasil | STIFIn Mulia" description="Ikuti Tes STIFIn, temukan Mesin Kecerdasan Anda, dan pahami penerapannya untuk belajar, karier, keluarga, dan pengembangan diri.">
  <PageHero eyebrow="Kenali Mesin Kecerdasan Anda" title="Satu tes untuk memahami cara alami Anda belajar, bekerja, dan berelasi" description="Melalui pemindaian sepuluh sidik jari, Tes STIFIn membantu Anda mengenali Mesin Kecerdasan dan personaliti genetik. Setelah tes, hasil dijelaskan agar mudah diterapkan dalam keseharian.">
    <div class="actions">
      <a class="button" href="/ikut-tes-stifin/#daftar">Saya Mau Tes STIFIn</a>
      <a class="button secondary" href="#sebelum-daftar">Lihat Manfaatnya</a>
    </div>
    <p class="microcopy">Sebutkan kota dan jumlah peserta. Tim membantu mencocokkan jadwal, lokasi, serta biaya tes.</p>
  </PageHero>

  <section class="section-tight"><div class="container proof-strip"><div><strong>Proses cepat dan langsung</strong><span>Pemindaian dilakukan pada sepuluh ujung jari.</span></div><div><strong>Hasil yang personal</strong><span>Kenali Mesin Kecerdasan dan personaliti genetik Anda.</span></div><div><strong>Penjelasan yang aplikatif</strong><span>Temukan kaitannya dengan area hidup yang ingin Anda kembangkan.</span></div></div></section>

  <section id="sebelum-daftar" class="section"><div class="container split"><div><span class="eyebrow">Manfaat yang terasa dekat</span><h2>Lebih mudah memahami diri ketika Anda tahu pola alaminya</h2><p class="lead">Hasil tes memberi bahasa yang lebih sederhana untuk membaca kekuatan, cara merespons, dan lingkungan yang membantu Anda berkembang.</p></div><ul class="check-list"><li><strong>Belajar dengan pendekatan yang lebih pas</strong><br />Kenali cara masuk ke materi, menjaga semangat, dan mengembangkan kebiasaan belajar.</li><li><strong>Berkomunikasi tanpa terus saling menebak</strong><br />Pahami perbedaan cara diri, anak, pasangan, atau rekan menangkap pesan.</li><li><strong>Mengarahkan karier dan pengembangan diri</strong><br />Lihat kecenderungan yang dapat dipertimbangkan saat memilih peran dan cara kerja.</li></ul></div></section>

  <SourceReactions />

  <section class="section soft"><div class="container experience-grid"><div class="experience-photo"><img src="/images/kegiatan/pelaksanaan-tes.webp" width="1200" height="800" alt="Pelaksanaan Tes STIFIn menggunakan alat pemindai" loading="lazy" /></div><div><span class="eyebrow">Pengalaman tes Anda</span><h2>Datang untuk tes, pulang dengan pemahaman baru</h2><p class="lead">Anda mengikuti proses pemindaian secara langsung, menerima hasil, lalu mendapatkan penjelasan tentang karakter, kekuatan, tantangan, dan kemungkinan penerapannya.</p><div class="notice"><strong>Agar hasilnya makin bermanfaat:</strong> pilih satu area yang paling ingin Anda pahami—belajar, keluarga, profesi, bisnis, atau relasi.</div></div></div></section>

  <section id="alur" class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Cara mengikuti tes</span><h2>Dari memilih jadwal hingga memahami hasil</h2></div></div><div class="steps"><article class="step"><h3>Kirim kota Anda</h3><p>Sampaikan nama, kota, dan jumlah peserta melalui WhatsApp.</p></article><article class="step"><h3>Pilih waktu tes</h3><p>Tim membantu mencocokkan jadwal, lokasi, dan biaya.</p></article><article class="step"><h3>Ikuti pemindaian</h3><p>Sepuluh ujung jari dipindai secara langsung menggunakan alat tes.</p></article><article class="step"><h3>Kenali hasil Anda</h3><p>Dengarkan penjelasan dan pilih penerapan yang ingin didalami.</p></article></div></div></section>

  <section class="section soft"><div class="container"><div class="section-head"><div><span class="eyebrow">Untuk siapa?</span><h2>Pilih konteks yang paling dekat dengan Anda</h2></div></div><div class="grid-3"><article class="card"><span class="card-icon">01</span><h3>Diri dan karier</h3><p>Untuk yang ingin membahas cara belajar, cara bekerja, kebiasaan, dan arah pengembangan diri.</p></article><article class="card"><span class="card-icon">02</span><h3>Keluarga dan pengasuhan</h3><p>Untuk orang tua atau pasangan yang ingin memahami perbedaan kecenderungan dan cara berkomunikasi.</p></article><article class="card"><span class="card-icon">03</span><h3>Pendidikan dan tim</h3><p>Untuk peserta, pendidik, komunitas, atau organisasi yang membutuhkan pembahasan dalam kelompok.</p></article></div></div></section>

  <section id="faq" class="section"><div class="container faq"><div><span class="eyebrow">Pertanyaan sebelum tes</span><h2>Supaya Anda datang dengan lebih siap</h2></div><div><details open><summary>Apa yang saya dapat setelah tes?</summary><p>Anda menerima hasil Mesin Kecerdasan dan personaliti genetik, disertai penjelasan agar lebih mudah dipahami dan diterapkan.</p></details><details><summary>Bisakah tes dilakukan secara online?</summary><p>Pendaftaran dapat dilakukan dari mana saja. Pemindaian sidik jari dilakukan dengan bertemu langsung agar proses tes dapat dijalankan dengan alat yang tersedia.</p></details><details><summary>Apakah bisa tes bersama keluarga atau kelompok?</summary><p>Bisa. Kirim jumlah peserta dan kota Anda agar tim dapat membantu menyiapkan jadwal yang lebih efisien.</p></details></div></div></section>

  <Callout title="Siap menemukan Mesin Kecerdasan Anda?" text="Kirim nama, kota, dan jumlah peserta. Tim akan membantu memilih jadwal Tes STIFIn yang tersedia." message="Assalamu’alaikum, saya mau Tes STIFIn. Nama: ... Kota: ... Jumlah peserta: ..." />
</BaseLayout>
<style>
  .experience-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(36px,7vw,86px);align-items:center}.experience-photo{position:relative;overflow:hidden;border-radius:90px 22px 22px 22px;box-shadow:var(--shadow)}.experience-photo::after{position:absolute;inset:0;border:1px solid rgba(255,255,255,.3);border-radius:inherit;content:''}.experience-photo img{width:100%;aspect-ratio:3/2;object-fit:cover}.faq{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(40px,8vw,110px);align-items:start}.faq details{margin-bottom:12px;padding:20px 22px;border:1px solid var(--line);border-radius:var(--radius-sm);background:white;box-shadow:var(--shadow-soft)}.faq summary{color:var(--green-950);font-weight:800;cursor:pointer}.faq details[open]{border-color:#b6cbbd}.faq details p{margin:13px 0 0}@media(max-width:760px){.experience-grid,.faq{grid-template-columns:1fr}.experience-photo{border-radius:55px 18px 18px 18px}}
</style>
