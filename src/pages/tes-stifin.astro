---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Callout from '../components/Callout.astro';
---
<BaseLayout title="Tes STIFIn Bandung dan Sekitarnya | STIFIn Mulia" description="Informasi, alur pendaftaran, pelaksanaan, dan konsultasi hasil Tes STIFIn bersama STIFIn Mulia di Bandung Raya dan Sumedang.">
  <PageHero eyebrow="Tes STIFIn" title="Kenali kecenderungan diri dengan proses yang jelas" description="Mulai dengan konsultasi singkat, lakukan tes secara langsung, lalu pahami hasilnya melalui sesi konsultasi yang terarah."><div class="actions"><a class="button" href="#alur">Lihat Alur Tes</a><a class="button secondary" href="#faq">Baca Pertanyaan Umum</a></div></PageHero>
  <section class="section"><div class="container two-col"><div><span class="eyebrow">Sebelum mendaftar</span><h2>Apa yang Anda peroleh?</h2></div><div class="grid-list"><article><b>Proses tes langsung</b><p>Tes dilakukan secara offline atau fisik sesuai ketentuan layanan yang berlaku.</p></article><article><b>Konsultasi hasil</b><p>Hasil tidak hanya dikirim. Anda memperoleh penjelasan agar dapat memahami konteksnya.</p></article><article><b>Arah tindak lanjut</b><p>Diskusi difokuskan pada kebutuhan belajar, keluarga, karier, atau pengembangan diri.</p></article></div></div></section>
  <section id="alur" class="section soft"><div class="container"><div class="section-head"><div><span class="eyebrow">Alur layanan</span><h2>Dari konsultasi hingga tindak lanjut</h2></div></div><div class="steps"><article class="step"><h3>Konsultasi awal</h3><p>Sampaikan tujuan dan kota tempat tinggal.</p></article><article class="step"><h3>Konfirmasi jadwal</h3><p>Pilih waktu, lokasi, dan lengkapi administrasi.</p></article><article class="step"><h3>Tes offline</h3><p>Datang sesuai jadwal untuk proses pengambilan data.</p></article><article class="step"><h3>Konsultasi hasil</h3><p>Pelajari hasil dan susun langkah pengembangan.</p></article></div></div></section>
  <section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Relevan untuk</span><h2>Beragam kebutuhan pengembangan</h2></div></div><div class="grid-3"><article class="card"><span class="card-icon">A</span><h3>Individu dan Karier</h3><p>Mendukung refleksi tentang pola belajar, cara bekerja, dan arah pengembangan diri.</p></article><article class="card"><span class="card-icon">B</span><h3>Keluarga dan Parenting</h3><p>Membantu membuka percakapan mengenai perbedaan kecenderungan antaranggota keluarga.</p></article><article class="card"><span class="card-icon">C</span><h3>Pendidikan dan Tim</h3><p>Menjadi bahan edukasi dalam program sekolah, kampus, komunitas, dan organisasi.</p></article></div></div></section>
  <section id="faq" class="section soft"><div class="container faq"><div><span class="eyebrow">Pertanyaan penting</span><h2>Pahami batas layanan</h2></div><div><details open><summary>Apakah Tes STIFIn merupakan diagnosis psikologis?</summary><p>Tidak. Tes STIFIn tidak diposisikan sebagai diagnosis medis atau psikologis.</p></details><details><summary>Apakah hasil tes menjamin keberhasilan?</summary><p>Tidak. Hasil menjadi bahan mengenali kecenderungan dalam konsep STIFIn. Keputusan, latihan, lingkungan, dan banyak faktor lain tetap berperan.</p></details><details><summary>Bisakah tes dilakukan secara online?</summary><p>Konsultasi dan administrasi dapat dilakukan online. Proses tes tetap dilakukan secara langsung.</p></details></div></div></section>
  <Callout title="Siap menentukan jadwal tes?" text="Kirim kota, jumlah peserta, dan kebutuhan utama Anda. Tim akan membantu memeriksa jadwal yang tersedia." message="Assalamu’alaikum, saya ingin mendaftar Tes STIFIn. Kota saya: ... Jumlah peserta: ..." />
</BaseLayout>
<style>
  .two-col, .faq { display:grid; grid-template-columns:.85fr 1.15fr; gap:clamp(40px,8vw,110px); }
  .grid-list article { padding:24px 0; border-bottom:1px solid var(--line); }.grid-list b{font-size:1.1rem}.grid-list p{margin:6px 0 0}
  details { padding:22px 0; border-bottom:1px solid var(--line); } summary { color:var(--green-950); font-weight:800; cursor:pointer; } details p{margin:13px 0 0}
  @media(max-width:760px){.two-col,.faq{grid-template-columns:1fr}}
</style>
