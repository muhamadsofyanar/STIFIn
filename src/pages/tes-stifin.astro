---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Callout from '../components/Callout.astro';
import { waLink } from '../data/site';
---
<BaseLayout title="Tes STIFIn Bandung dan Sekitarnya | STIFIn Mulia" description="Daftar Tes STIFIn tatap muka di Bandung Raya dan Sumedang, lengkap dengan penjelasan hasil dan konsultasi kebutuhan Anda.">
  <PageHero eyebrow="Tes STIFIn · Bandung Raya & Sumedang" title="Bukan sekadar menerima hasil—pahami cara menggunakannya dalam keseharian" description="Tes dilakukan secara langsung. Setelahnya, hasil dijelaskan dalam konsep STIFIn dan dapat didiskusikan untuk kebutuhan belajar, keluarga, pekerjaan, atau pengembangan diri.">
    <div class="actions">
      <a class="button" data-wa-intent="tes-hero-daftar" href={waLink('Assalamu’alaikum, saya ingin mengecek jadwal Tes STIFIn. Nama: ... Kota: ... Jumlah peserta: ... Kebutuhan utama: ...')} target="_blank" rel="noopener noreferrer">Cek Jadwal via WhatsApp</a>
      <a class="button secondary" href="#sebelum-daftar">Cek Apakah Sesuai</a>
    </div>
    <p class="microcopy">Sampaikan kota dan jumlah peserta. Tim akan mengonfirmasi jadwal, lokasi, biaya, dan proses sebelum Anda memutuskan.</p>
  </PageHero>

  <section class="section-tight"><div class="container proof-strip"><div><strong>Tes tatap muka</strong><span>Pelaksanaan dilakukan langsung sesuai jadwal dan lokasi yang disepakati.</span></div><div><strong>Hasil dijelaskan</strong><span>Anda dibantu memahami hasil dalam kerangka konsep STIFIn.</span></div><div><strong>Bisa didiskusikan</strong><span>Bawa kebutuhan nyata yang ingin Anda bahas saat konsultasi.</span></div></div></section>

  <section id="sebelum-daftar" class="section"><div class="container split"><div><span class="eyebrow">Sering terjadi</span><h2>Hasil baru berguna ketika terhubung dengan kebutuhan nyata</h2><p class="lead">Karena itu, kami tidak berhenti pada penyampaian tipe. Konsultasi diarahkan pada situasi yang memang sedang Anda hadapi.</p></div><ul class="check-list"><li><strong>Bingung memilih cara belajar?</strong><br />Bahas kecenderungan yang dapat dijadikan bahan mencoba strategi belajar.</li><li><strong>Komunikasi keluarga sering tidak nyambung?</strong><br />Gunakan hasil sebagai bahan percakapan, bukan sebagai label untuk menghakimi.</li><li><strong>Sedang menimbang arah kerja atau pengembangan diri?</strong><br />Diskusikan pilihan dan kebiasaan yang relevan dengan kondisi Anda.</li></ul></div></section>

  <section class="section soft"><div class="container experience-grid"><div class="experience-photo"><img src="/images/kegiatan/pelaksanaan-tes.webp" width="1200" height="800" alt="Pelaksanaan Tes STIFIn menggunakan alat pemindai" loading="lazy" /></div><div><span class="eyebrow">Yang akan Anda jalani</span><h2>Prosesnya jelas dari awal</h2><p class="lead">Sebelum tes, Anda mengetahui lokasi, jadwal, biaya, dan apa yang perlu disiapkan. Setelah tes, Anda mendapat penjelasan hasil serta ruang untuk bertanya.</p><div class="notice">Tes STIFIn bukan diagnosis medis atau psikologis, bukan penentu mutlak masa depan, dan tidak menggantikan pemeriksaan profesional.</div></div></div></section>

  <section id="alur" class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Cara mengikuti tes</span><h2>Empat langkah, tanpa menebak proses berikutnya</h2></div></div><div class="steps"><article class="step"><h3>Kirim kebutuhan</h3><p>Sampaikan nama, kota, jumlah peserta, dan hal utama yang ingin dibahas.</p></article><article class="step"><h3>Terima konfirmasi</h3><p>Tim menjelaskan jadwal, lokasi, biaya, serta persiapan sebelum tes.</p></article><article class="step"><h3>Datang untuk tes</h3><p>Ikuti pelaksanaan secara langsung pada waktu dan tempat yang disepakati.</p></article><article class="step"><h3>Pahami hasil</h3><p>Ikuti penjelasan dan diskusikan langkah yang dapat dicoba setelahnya.</p></article></div></div></section>

  <section class="section soft"><div class="container"><div class="section-head"><div><span class="eyebrow">Untuk siapa?</span><h2>Pilih konteks yang paling dekat dengan Anda</h2></div></div><div class="grid-3"><article class="card"><span class="card-icon">01</span><h3>Diri dan karier</h3><p>Untuk yang ingin membahas cara belajar, cara bekerja, kebiasaan, dan arah pengembangan diri.</p></article><article class="card"><span class="card-icon">02</span><h3>Keluarga dan pengasuhan</h3><p>Untuk orang tua atau pasangan yang ingin memahami perbedaan kecenderungan dan cara berkomunikasi.</p></article><article class="card"><span class="card-icon">03</span><h3>Pendidikan dan tim</h3><p>Untuk peserta, pendidik, komunitas, atau organisasi yang membutuhkan pembahasan dalam kelompok.</p></article></div></div></section>

  <section id="faq" class="section"><div class="container faq"><div><span class="eyebrow">Sebelum menghubungi kami</span><h2>Pastikan harapan Anda tepat</h2></div><div><details open><summary>Apakah hasil tes menjamin keberhasilan?</summary><p>Tidak. Hasil menjadi bahan mengenali kecenderungan dalam konsep STIFIn. Keputusan, latihan, lingkungan, dan banyak faktor lain tetap berperan.</p></details><details><summary>Bisakah tes dilakukan dari jarak jauh?</summary><p>Pendaftaran dan percakapan awal dapat dilakukan dari jarak jauh. Proses tes tetap dilakukan dengan bertemu langsung.</p></details><details><summary>Apakah saya langsung harus membayar setelah menghubungi WhatsApp?</summary><p>Tidak. Tim akan lebih dulu menjelaskan jadwal, lokasi, biaya, dan proses. Anda dapat mempertimbangkannya sebelum mengonfirmasi pendaftaran.</p></details></div></div></section>

  <Callout title="Ingin mengecek jadwal yang tersedia?" text="Kirim kota, jumlah peserta, dan kebutuhan utama. Tim akan menjawab dengan informasi yang perlu Anda pertimbangkan sebelum mendaftar." message="Assalamu’alaikum, saya ingin mengecek jadwal Tes STIFIn. Nama: ... Kota: ... Jumlah peserta: ... Kebutuhan utama: ..." />
</BaseLayout>
<style>
  .experience-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(36px,7vw,86px);align-items:center}.experience-photo{overflow:hidden;border-radius:var(--radius-lg);box-shadow:var(--shadow)}.experience-photo img{width:100%;aspect-ratio:3/2;object-fit:cover}.faq{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(40px,8vw,110px)}details{padding:22px 0;border-bottom:1px solid var(--line)}summary{color:var(--green-950);font-weight:800;cursor:pointer}details p{margin:13px 0 0}@media(max-width:760px){.experience-grid,.faq{grid-template-columns:1fr}}
</style>
