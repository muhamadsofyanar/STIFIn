---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Callout from '../components/Callout.astro';
---
<BaseLayout title="Tes STIFIn Bandung dan Sekitarnya | STIFIn Mulia" description="Informasi, alur pendaftaran, pelaksanaan, dan konsultasi hasil Tes STIFIn bersama STIFIn Mulia di Bandung Raya dan Sumedang.">
  <PageHero eyebrow="Tes STIFIn" title="Ikuti tes, pahami hasilnya, lalu tentukan langkah" description="Mulai dengan menghubungi kami, pilih jadwal tes, datang ke lokasi, kemudian ikuti konsultasi hasil."><div class="actions"><a class="button" href="#alur">Lihat Cara Mengikuti Tes</a><a class="button secondary" href="#faq">Baca Pertanyaan Umum</a></div></PageHero>
  <section class="section"><div class="container two-col"><div><span class="eyebrow">Yang Anda dapatkan</span><h2>Tes disertai penjelasan hasil</h2></div><div class="grid-list"><article><b>Tes dilakukan langsung</b><p>Peserta datang ke lokasi yang disepakati untuk menjalani proses tes.</p></article><article><b>Hasil dijelaskan</b><p>Anda tidak hanya menerima hasil. Kami membantu menjelaskan maknanya dalam konsep STIFIn.</p></article><article><b>Bisa langsung didiskusikan</b><p>Konsultasi dapat membahas kebutuhan belajar, keluarga, pekerjaan, atau pengembangan diri.</p></article></div></div></section>
  <section id="alur" class="section soft"><div class="container"><div class="section-head"><div><span class="eyebrow">Cara mengikuti tes</span><h2>Empat langkah dari pendaftaran sampai konsultasi</h2></div></div><div class="steps"><article class="step"><h3>Hubungi kami</h3><p>Sampaikan nama, kota, jumlah peserta, dan kebutuhan Anda.</p></article><article class="step"><h3>Pilih jadwal</h3><p>Tentukan waktu dan lokasi, lalu selesaikan administrasi.</p></article><article class="step"><h3>Datang untuk tes</h3><p>Ikuti proses tes secara langsung sesuai jadwal.</p></article><article class="step"><h3>Ikuti konsultasi hasil</h3><p>Pahami hasil dan diskusikan langkah yang dapat dicoba.</p></article></div></div></section>
  <section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Dapat digunakan untuk</span><h2>Membahas kebutuhan diri, keluarga, dan pendidikan</h2></div></div><div class="grid-3"><article class="card"><span class="card-icon">A</span><h3>Diri dan Karier</h3><p>Membantu membahas cara belajar, cara bekerja, dan langkah pengembangan diri.</p></article><article class="card"><span class="card-icon">B</span><h3>Keluarga dan Pengasuhan</h3><p>Membantu keluarga membicarakan perbedaan kecenderungan setiap anggotanya.</p></article><article class="card"><span class="card-icon">C</span><h3>Pendidikan dan Tim</h3><p>Dapat menjadi bahan pembelajaran di sekolah, kampus, komunitas, dan organisasi.</p></article></div></div></section>
  <section id="faq" class="section soft"><div class="container faq"><div><span class="eyebrow">Pertanyaan penting</span><h2>Pahami batas layanan</h2></div><div><details open><summary>Apakah Tes STIFIn merupakan diagnosis psikologis?</summary><p>Tidak. Tes STIFIn tidak diposisikan sebagai diagnosis medis atau psikologis.</p></details><details><summary>Apakah hasil tes menjamin keberhasilan?</summary><p>Tidak. Hasil menjadi bahan mengenali kecenderungan dalam konsep STIFIn. Keputusan, latihan, lingkungan, dan banyak faktor lain tetap berperan.</p></details><details><summary>Bisakah tes dilakukan dari jarak jauh?</summary><p>Pendaftaran dan konsultasi dapat dilakukan dari jarak jauh. Proses tes tetap dilakukan dengan bertemu langsung.</p></details></div></div></section>
  <Callout title="Siap menentukan jadwal tes?" text="Kirim kota, jumlah peserta, dan kebutuhan utama Anda. Tim akan membantu memeriksa jadwal yang tersedia." message="Assalamu’alaikum, saya ingin mendaftar Tes STIFIn. Kota saya: ... Jumlah peserta: ..." />
</BaseLayout>
<style>
  .two-col, .faq { display:grid; grid-template-columns:.85fr 1.15fr; gap:clamp(40px,8vw,110px); }
  .grid-list article { padding:24px 0; border-bottom:1px solid var(--line); }.grid-list b{font-size:1.1rem}.grid-list p{margin:6px 0 0}
  details { padding:22px 0; border-bottom:1px solid var(--line); } summary { color:var(--green-950); font-weight:800; cursor:pointer; } details p{margin:13px 0 0}
  @media(max-width:760px){.two-col,.faq{grid-template-columns:1fr}}
</style>
