---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Callout from '../components/Callout.astro';
import CentralProof from '../components/CentralProof.astro';
---
<BaseLayout title="WSL 1 STIFIn | Dari Hasil Tes Menjadi Pemahaman" description="Pelajari fondasi STIFIn melalui WSL 1 agar hasil tes dapat diterapkan dalam keluarga, belajar, pekerjaan, dan perjalanan menjadi promotor.">
  <PageHero eyebrow="Lanjutan setelah Tes STIFIn" title="Sudah tahu hasilnya? Sekarang pahami cara membacanya." description="WSL 1 membantu Anda keluar dari kebiasaan menghafal tipe. Anda belajar melihat pola, memahami perbedaan, dan menghubungkan konsep STIFIn dengan situasi yang benar-benar Anda alami."><div class="actions"><a class="button" href="/ikut-wsl-1/#daftar">Saya Tertarik WSL 1</a></div></PageHero>

  <section class="section-tight"><div class="container proof-strip"><div><strong>Untuk peserta tes</strong><span>Memperdalam arti hasil dan cara menggunakannya.</span></div><div><strong>Untuk keluarga dan profesional</strong><span>Belajar membaca perbedaan tanpa cepat menghakimi.</span></div><div><strong>Fondasi calon promotor</strong><span>Membangun pemahaman sebelum melayani orang lain.</span></div></div></section>

  <section class="section"><div class="container split"><div><span class="eyebrow">Mengapa WSL 1 penting</span><h2>Hasil tes memberi nama. Pembelajaran memberi makna.</h2><p class="lead">Mengetahui diri sebagai Sensing, Thinking, Intuiting, Feeling, atau Insting baru merupakan pintu masuk. Tanpa pemahaman, hasil mudah berubah menjadi label: “Saya memang begini” atau “Dia memang begitu.”</p><p>WSL 1 mengajak Anda melihat konsep sebagai bahasa untuk bertumbuh. Anda belajar menempatkan kekuatan, tantangan, cara berkomunikasi, dan kebutuhan pengembangan dalam gambaran yang lebih utuh.</p></div><div class="quote"><small>Perubahan yang dicari</small><strong>Dari “saya tipe apa?” menjadi “langkah apa yang paling tepat untuk saya latih?”</strong></div></div></section>

  <section class="section soft"><div class="container"><div class="section-head"><div><span class="eyebrow">Yang akan Anda bangun</span><h2>Tiga kemampuan dasar setelah mengikuti WSL 1</h2></div></div><div class="grid-3"><article class="card"><span class="card-icon">01</span><h3>Membaca diri dengan lebih jernih</h3><p>Kenali cara alami Anda menerima informasi, menentukan prioritas, dan merespons keadaan tanpa menjadikan hasil tes sebagai alasan untuk berhenti berkembang.</p></article><article class="card"><span class="card-icon">02</span><h3>Memahami orang yang berbeda</h3><p>Pelajari mengapa pendekatan yang berhasil pada diri sendiri belum tentu cocok untuk anak, pasangan, rekan kerja, atau pelanggan.</p></article><article class="card"><span class="card-icon">03</span><h3>Menerjemahkan konsep menjadi tindakan</h3><p>Pilih satu konteks nyata—belajar, keluarga, pekerjaan, bisnis, atau relasi—lalu susun percobaan kecil yang dapat diamati hasilnya.</p></article></div></div></section>

  <section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Urutan yang disarankan</span><h2>Jangan melompat. Bangun fondasinya satu per satu.</h2></div></div><div class="steps"><article class="step"><h3>Ikuti tes</h3><p>Dapatkan hasil personaliti genetik Anda melalui proses tes langsung.</p></article><article class="step"><h3>Bahas hasil</h3><p>Hubungkan hasil dengan pertanyaan yang paling dekat dengan kehidupan Anda.</p></article><article class="step"><h3>Ikuti WSL 1</h3><p>Bangun pemahaman dasar tentang pola diri dan perbedaan antarmanusia.</p></article><article class="step"><h3>Terapkan dan bagikan</h3><p>Praktikkan lebih dahulu; lanjutkan jalur promotor bila Anda ingin memperluas manfaat.</p></article></div></div></section>

  <section class="section dark"><div class="container bridge"><div><span class="eyebrow">Ingin menjadi promotor?</span><h2>Promotor yang kuat tidak hanya menjual tes. Ia mampu menjelaskan manfaat dengan bertanggung jawab.</h2></div><div><p class="lead">WSL 1 menjadi fondasi penting untuk membangun bahasa, keyakinan, dan cara melayani. Setelah memahami konsep serta mengalami penerapannya, Anda dapat mempelajari sistem promotor, pendampingan, dan peluang pengembangannya.</p><a class="button secondary" href="/jadi-promotor/">Pelajari Jalur Promotor</a></div></div></section>

  <section class="section"><div class="container faq"><span class="eyebrow">Pertanyaan yang sering muncul</span><details open><summary>Apakah harus sudah tes sebelum mengikuti WSL 1?</summary><p>WSL 1 dirancang sebagai pendalaman setelah Anda memiliki hasil tes, sehingga contoh dan latihan dapat langsung dihubungkan dengan diri sendiri.</p></details><details><summary>Apakah setelah WSL 1 otomatis menjadi promotor?</summary><p>Tidak otomatis. WSL 1 membangun fondasi pemahaman. Jalur promotor memiliki proses, persyaratan, dan pendampingan tersendiri yang dijelaskan sebelum Anda memutuskan.</p></details><details><summary>Apakah WSL 1 hanya untuk calon promotor?</summary><p>Tidak. Peserta tes, orang tua, pasangan, pendidik, profesional, dan pemimpin tim dapat menggunakannya untuk memahami konsep secara lebih utuh.</p></details></div></section>

  <Callout title="Siap melanjutkan dari hasil menuju pemahaman?" text="Kirim hasil tes, kota, dan tujuan belajar Anda. Tim STIFIn Mulia akan membantu mengecek agenda WSL 1 yang tersedia." message="Assalamu’alaikum, saya ingin mengikuti WSL 1. Nama: ... Kota: ... Hasil Tes STIFIn: ... Tujuan saya belajar: ..." />
  <CentralProof mode="wsl" />
</BaseLayout>
<style>.quote{padding:clamp(30px,5vw,52px);border-radius:var(--radius-lg);background:var(--green-950);color:white;box-shadow:var(--shadow)}.quote small,.quote strong{display:block}.quote small{margin-bottom:24px;color:#cfe0ae;font-weight:800;text-transform:uppercase;letter-spacing:.1em}.quote strong{font-family:var(--font-display);font-size:clamp(1.6rem,3vw,2.5rem);line-height:1.25}.bridge{display:grid;grid-template-columns:1fr 1fr;gap:clamp(40px,8vw,100px);align-items:start}.faq{max-width:900px}.faq details{padding:22px 0;border-bottom:1px solid var(--line)}.faq summary{cursor:pointer;color:var(--green-950);font-size:1.1rem;font-weight:850}.faq details p{padding-top:12px}@media(max-width:800px){.bridge{grid-template-columns:1fr}}</style>
