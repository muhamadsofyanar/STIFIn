---
import CampaignLayout from '../layouts/CampaignLayout.astro';
import { site } from '../data/site';
---
<CampaignLayout title="Terima Kasih | Minat Promotor STIFIn" description="Data minat menjadi Promotor STIFIn sudah diterima oleh STIFIn Mulia." pixelEvent="Lead">
  <section class="thanks"><div class="campaign-container thanks-grid"><div><span class="success-mark">✓</span><span class="campaign-kicker">Peta awal Anda sudah diterima</span><h1>Terima kasih. Tim akan membantu menilai langkah awal yang paling masuk akal.</h1><p class="lead">Tekan tombol WhatsApp untuk mengirim ringkasan profesi, jaringan, status belajar, dan kesiapan Anda. Konsultasi awal tidak mewajibkan langsung bergabung.</p><a id="continue-wa" class="thanks-button" data-wa={site.whatsapp} href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer">Konsultasi melalui WhatsApp</a><p class="small-note">WhatsApp pusat STIFIn Mulia: {site.phoneDisplay}</p></div><aside><strong>Apa yang akan dibahas?</strong><ol><li>Tujuan dan alasan Anda ingin menjadi promotor.</li><li>Status Tes STIFIn serta WSL 1.</li><li>Jaringan dan potensi pasar terdekat.</li><li>Program belajar, fasilitas, investasi, dan pendampingan.</li></ol><a href="/jadi-promotor/">Baca rincian peluang promotor</a></aside></div></section>
  <script>
    const button = document.querySelector<HTMLAnchorElement>('#continue-wa');
    let lead: Record<string,string> = {};
    try { lead = JSON.parse(sessionStorage.getItem('stifinPromotorLead') || '{}'); } catch {}
    const message = ['Assalamu’alaikum, saya sudah mengisi form calon Promotor STIFIn di stifinmulia.com.',`Nama: ${lead.name || '...'}`,`Kota: ${lead.city || '...'}`,`Pekerjaan: ${lead.profession || '...'}`,`Status tes: ${lead.stifin_status || '...'}`,`Status WSL 1: ${lead.wsl_status || '...'}`,`Jaringan: ${lead.network || '...'}`,`Tujuan: ${lead.promoter_goal || '...'}`,`Kesiapan: ${lead.promoter_readiness || '...'}`,`Sumber: ${lead.utm_source || 'website'} / ${lead.utm_campaign || '-'}`,'Mohon dibantu menjelaskan jalur promotor yang sesuai.'].join('\n');
    if (button) button.href = `https://wa.me/${button.dataset.wa || ''}?text=${encodeURIComponent(message)}`;
  </script>
</CampaignLayout>
<style>.thanks{min-height:76vh;padding:clamp(65px,10vw,125px) 0;background:radial-gradient(circle at 82% 10%,rgba(215,169,63,.18),transparent 25rem),#f7f8f4}.thanks-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(40px,8vw,95px);align-items:center}.success-mark{display:grid;width:60px;height:60px;margin-bottom:25px;place-items:center;border-radius:50%;background:var(--green-950);color:white;font-size:1.55rem;font-weight:900}.campaign-kicker{color:var(--green-700);font-size:.74rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase}.thanks h1{max-width:760px;font-size:clamp(2.5rem,5.8vw,4.7rem);line-height:1.03;text-wrap:balance}.thanks-button{display:inline-flex;min-height:56px;align-items:center;justify-content:center;margin-top:22px;padding:13px 22px;border-radius:12px;background:var(--green-950);color:white;font-weight:850;box-shadow:var(--shadow-soft)}.small-note{margin-top:11px;font-size:.8rem}.thanks aside{padding:clamp(26px,4vw,42px);border:1px solid var(--line);border-radius:22px;background:white;box-shadow:var(--shadow)}.thanks aside>strong{font-family:var(--font-display);font-size:1.5rem}.thanks ol{padding-left:21px}.thanks li{margin:14px 0;color:var(--muted)}.thanks aside a{color:var(--green-800);font-weight:800;text-decoration:underline}@media(max-width:800px){.thanks-grid{grid-template-columns:1fr}}</style>
