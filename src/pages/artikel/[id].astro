---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Callout from '../../components/Callout.astro';
export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((article) => ({ params: { id: article.id }, props: { article } }));
}
const { article } = Astro.props;
const { Content } = await render(article);
const related = (await getCollection('articles', ({ data }) => !data.draft))
  .filter((entry) => entry.id !== article.id)
  .sort((a, b) => Number(b.data.category === article.data.category) - Number(a.data.category === article.data.category))
  .slice(0, 3);
const updated = (article.data.updatedAt || article.data.publishedAt).toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'});
const articleUrl = new URL(`/artikel/${article.id}/`, Astro.site).toString();
const isTafsir = article.data.category === 'Tafsir Al-Qamar';
const conversionByCategory: Record<string, { title: string; text: string; message: string }> = {
  'Mengenal STIFIn': { title: 'Ingin mengenal pola diri Anda secara langsung?', text: 'Sampaikan kota dan kebutuhan Anda. Tim membantu menjelaskan proses, jadwal, serta biaya Tes STIFIn sebelum Anda memutuskan.', message: 'Assalamu’alaikum, saya membaca artikel STIFIn Mulia dan ingin mengetahui jadwal Tes STIFIn. Kota: ... Kebutuhan utama: ...' },
  'Keluarga dan Parenting': { title: 'Bawa pertanyaan keluarga Anda ke percakapan yang lebih personal', text: 'Ceritakan situasi anak, pasangan, atau keluarga yang ingin dipahami. Tim membantu memilih langkah tes dan pembelajaran yang relevan.', message: 'Assalamu’alaikum, saya ingin memahami kebutuhan keluarga melalui STIFIn. Situasi yang ingin saya bahas: ... Kota: ...' },
  'Belajar dan Pendidikan': { title: 'Temukan pintu belajar yang lebih mudah diuji', text: 'Sampaikan usia peserta dan tantangan belajar yang sedang dihadapi. Tim membantu menjelaskan proses Tes STIFIn dan pilihan jadwal.', message: 'Assalamu’alaikum, saya ingin membahas cara belajar melalui STIFIn. Usia peserta: ... Tantangan belajar: ... Kota: ...' },
  'Karier dan Profesi': { title: 'Ubah pemahaman menjadi langkah profesi yang terukur', text: 'Mulai dari Tes STIFIn atau petakan peluang menjadi promotor sesuai posisi dan kesiapan Anda sekarang.', message: 'Assalamu’alaikum, saya membaca artikel karier di STIFIn Mulia. Saya ingin membahas: ... Pekerjaan saat ini: ... Kota: ...' },
  'Bisnis dan Kepemimpinan': { title: 'Susun langkah layanan dan pertumbuhan Anda', text: 'Ceritakan usaha, tim, komunitas, atau peluang promotor yang ingin dikembangkan. Tim membantu memetakan langkah awalnya.', message: 'Assalamu’alaikum, saya membaca artikel bisnis/promotor STIFIn Mulia. Saya ingin membahas: ... Kota: ...' },
  'Finansial dan Rezeki': { title: 'Mulai dari peta diri, lalu bangun sistem yang nyata', text: 'Diskusikan jalur tes, pembelajaran, atau peluang promotor tanpa janji hasil instan.', message: 'Assalamu’alaikum, saya membaca artikel finansial STIFIn Mulia dan ingin membahas langkah yang sesuai untuk saya: ...' },
};
const conversion = conversionByCategory[article.data.category] || conversionByCategory['Mengenal STIFIn'];
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.data.title,
  description: article.data.description,
  abstract: article.data.keyAnswer,
  datePublished: article.data.publishedAt.toISOString(),
  dateModified: (article.data.updatedAt || article.data.publishedAt).toISOString(),
  mainEntityOfPage: articleUrl,
  author: { '@type': 'Organization', name: 'Tim Edukasi STIFIn Mulia', url: new URL('/tentang/', Astro.site).toString() },
  publisher: { '@id': new URL('/#organization', Astro.site).toString() },
};
---
<BaseLayout title={`${article.data.title} | STIFIn Mulia`} description={article.data.description} schema={articleSchema} ogType="article">
  <article>
    <header class="article-hero"><div class="container"><a class="back" href="/artikel/">← Kembali ke pusat edukasi</a><span class="eyebrow">{article.data.category}</span><h1>{article.data.title}</h1><p class="lead">{article.data.description}</p><div class="meta"><span>{article.data.readingTime} menit baca</span><span>Diperbarui {updated}</span><span>Tim Edukasi STIFIn Mulia</span></div></div></header>
    <div class="container article-body"><div class="prose"><div class="audience"><strong>Panduan ini untuk:</strong> {article.data.audience}</div><div class="key-answer"><span>Inti pembahasan</span><p>{article.data.keyAnswer}</p></div><Content /></div><aside><strong>Supaya manfaatnya terasa</strong><p>Pilih satu gagasan yang paling dekat dengan situasi Anda, lalu praktikkan satu langkah kecil dan amati perubahannya.</p><hr/><strong>Lanjutkan dengan pendampingan</strong><p>Bawa hasil tes dan pertanyaan Anda ke sesi penjelasan agar penerapannya lebih personal untuk belajar, keluarga, pekerjaan, atau relasi.</p></aside></div>
  </article>
  <section class="related"><div class="container"><span class="eyebrow">Lanjutkan belajar</span><h2>Bacaan yang saling melengkapi</h2><div class="related-grid">{related.map((entry) => <a href={`/artikel/${entry.id}/`}><small>{entry.data.category}</small><strong>{entry.data.title}</strong><span>{entry.data.readingTime} menit baca →</span></a>)}</div></div></section>
  <Callout title={isTafsir ? 'Lanjutkan membaca dengan tertib dan bertahap' : conversion.title} text={isTafsir ? 'Jelajahi rangkaian Ruang Tafsir Al-Qamar dan catat satu pelajaran yang ingin Anda jaga dalam tindakan.' : conversion.text} message={isTafsir ? 'Assalamu’alaikum, saya membaca Ruang Tafsir Al-Qamar dan ingin bertanya tentang: ...' : conversion.message} />
</BaseLayout>
<style>
  .article-hero{position:relative;overflow:hidden;padding:clamp(72px,9vw,118px) 0;border-bottom:1px solid var(--line);background:linear-gradient(115deg,#f7f8f4 0 72%,#e4eee7 72%)}.article-hero::after{position:absolute;right:-120px;bottom:-230px;width:500px;height:500px;border:70px solid rgba(131,169,71,.08);border-radius:50%;content:''}.article-hero .container{position:relative;z-index:1}.article-hero h1{max-width:1030px;margin-bottom:22px;font-size:clamp(2.5rem,6vw,4.8rem);line-height:1.03;text-wrap:balance}.back{display:block;margin-bottom:34px;color:var(--green-800);font-weight:800}.meta{display:flex;flex-wrap:wrap;gap:10px 22px;margin-top:25px;color:var(--muted);font-size:.88rem}.meta span:not(:last-child)::after{margin-left:22px;content:'•';color:var(--lime-500)}.article-body{display:grid;grid-template-columns:minmax(0,760px) 290px;gap:70px;align-items:start;padding-top:70px;padding-bottom:50px}.audience{margin-bottom:18px;padding:16px 18px;border-radius:var(--radius-sm);background:var(--green-100);color:var(--green-950)}.key-answer{margin-bottom:42px;padding:26px;border-left:4px solid var(--lime-500);border-radius:0 var(--radius-sm) var(--radius-sm) 0;background:var(--cream);box-shadow:var(--shadow-soft)}.key-answer span{display:block;margin-bottom:8px;color:var(--green-800);font-size:.78rem;font-weight:850;letter-spacing:.1em;text-transform:uppercase}.key-answer p{margin:0;color:var(--ink);font-family:var(--font-display);font-size:1.22rem;font-weight:700;line-height:1.45}.article-body aside{position:sticky;top:105px;padding:24px;border:1px solid #c8d8cc;border-radius:var(--radius-sm);background:linear-gradient(145deg,#f4f1e8,#eef4ef);box-shadow:var(--shadow-soft)}.article-body aside p{margin:8px 0 0;font-size:.88rem}.article-body aside hr{margin:20px 0;border:0;border-top:1px solid #d8d8c8}.prose :global(p){font-size:1.05rem}.prose :global(h2){scroll-margin-top:100px}.prose :global(blockquote){margin:30px 0;padding:18px 22px;border-left:4px solid var(--lime-500);background:var(--cream)}.prose :global(a){color:var(--green-800);text-decoration:underline}.related{padding:70px 0;background:linear-gradient(145deg,#eaf3ec,#e1ede4)}.related h2{max-width:680px}.related-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:34px}.related-grid a{display:flex;min-height:210px;flex-direction:column;padding:24px;border:1px solid var(--line);border-radius:var(--radius);background:white;box-shadow:var(--shadow-soft);transition:transform .2s ease,border-color .2s ease}.related-grid a:hover{transform:translateY(-4px);border-color:#b4cabc}.related-grid small{color:var(--muted)}.related-grid strong{margin:18px 0;font-family:var(--font-display);font-size:1.25rem;line-height:1.3}.related-grid span{margin-top:auto;color:var(--green-800);font-weight:800}@media(max-width:850px){.article-body{grid-template-columns:1fr;gap:35px}.article-body aside{position:static}.meta span::after{display:none}.related-grid{grid-template-columns:1fr}}
</style>
