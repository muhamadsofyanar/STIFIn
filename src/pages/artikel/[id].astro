---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Callout from '../../components/Callout.astro';
export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((article) => ({ params: { id: article.id }, props: { article } }));
}
const { article } = Astro.props;
const { Content } = await render(article);
const published = article.data.publishedAt.toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'});
const articleUrl = new URL(`/artikel/${article.id}/`, Astro.site).toString();
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.data.title,
  description: article.data.description,
  datePublished: article.data.publishedAt.toISOString(),
  dateModified: (article.data.updatedAt || article.data.publishedAt).toISOString(),
  mainEntityOfPage: articleUrl,
  author: { '@type': 'Organization', name: 'Tim Edukasi STIFIn Mulia' },
  publisher: { '@id': new URL('/#organization', Astro.site).toString() },
};
---
<BaseLayout title={`${article.data.title} | STIFIn Mulia`} description={article.data.description} schema={articleSchema}>
  <article>
    <header class="article-hero"><div class="container"><a class="back" href="/artikel/">← Kembali ke artikel</a><span class="eyebrow">{article.data.category}</span><h1>{article.data.title}</h1><p class="lead">{article.data.description}</p><div class="meta">Diterbitkan {published} · Tim Edukasi STIFIn Mulia</div></div></header>
    <div class="container article-body"><div class="prose"><Content /></div><aside><strong>Catatan penting</strong><p>Isi artikel menjelaskan penerapan dalam konsep STIFIn. Artikel bukan diagnosis medis atau psikologis dan tidak menjanjikan hasil tertentu.</p></aside></div>
  </article>
  <Callout title="Ingin membahasnya untuk kebutuhan Anda?" text="Tanyakan tentang tes, pembelajaran, atau program bersama tim STIFIn Mulia." message="Assalamu’alaikum, saya membaca artikel di stifinmulia.com dan ingin berkonsultasi tentang: ..." />
</BaseLayout>
<style>
  .article-hero{padding:clamp(65px,9vw,110px) 0;background:linear-gradient(145deg,#fbfcfa,#eaf4ef)}.article-hero h1{max-width:900px;margin-bottom:22px;font-size:clamp(2.3rem,6vw,4.5rem)}.back{display:block;margin-bottom:34px;color:var(--green-800);font-weight:800}.meta{margin-top:25px;color:var(--muted);font-size:.88rem}.article-body{display:grid;grid-template-columns:minmax(0,760px) 290px;gap:70px;align-items:start;padding-top:70px;padding-bottom:50px}.article-body aside{position:sticky;top:100px;padding:22px;border:1px solid var(--line);border-radius:var(--radius-sm);background:#fff7e8}.article-body aside p{margin:8px 0 0;font-size:.88rem}.prose :global(p){font-size:1.05rem}.prose :global(blockquote){margin:30px 0;padding:18px 22px;border-left:4px solid var(--amber-500);background:#fff7e8}.prose :global(a){color:var(--green-800);text-decoration:underline}@media(max-width:850px){.article-body{grid-template-columns:1fr;gap:35px}.article-body aside{position:static}}
</style>
