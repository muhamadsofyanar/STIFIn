---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { pillars } from '../../data/knowledge-architecture';
const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort((a,b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const featured = articles.filter((article) => article.data.featured);
const categories = [...new Set(articles.map((article) => article.data.category))];
const themes = [
  { name: 'Mulai dari sini', description: 'Kenali cara kerja Tes STIFIn dan manfaat yang dapat Anda terapkan.', category: 'Mengenal STIFIn' },
  { name: 'Keluarga', description: 'Bangun komunikasi dan pengasuhan tanpa memberi label.', category: 'Keluarga dan Parenting' },
  { name: 'Belajar', description: 'Uji strategi belajar yang dapat diamati dan dievaluasi.', category: 'Belajar dan Pendidikan' },
  { name: 'Karier', description: 'Gabungkan refleksi diri dengan kompetensi dan realitas peluang.', category: 'Karier dan Profesi' },
  { name: 'Organisasi', description: 'Perjelas peran, kepemimpinan, dan sistem kerja tim.', category: 'Bisnis dan Kepemimpinan' },
  { name: 'Finansial', description: 'Hubungkan potensi, ikhtiar, profesi, dan sistem pengelolaan rezeki.', category: 'Finansial dan Rezeki' },
  { name: 'Ruang Tafsir', description: 'Pelajari Surah Al-Qamar melalui kajian yang berdiri sebagai ruang keilmuan tersendiri.', category: 'Tafsir Al-Qamar' },
];
---
<BaseLayout title="Pusat Pengetahuan | STIFIn Mulia" description="Artikel mendalam tentang konsep dan penerapan STIFIn serta Ruang Tafsir Al-Qamar dari STIFIn Mulia.">
  <PageHero eyebrow="Pusat pengetahuan STIFIn Mulia" title="Dari mengenal pola menuju hidup yang lebih sadar" description="Temukan artikel mendalam tentang tes, keluarga, belajar, profesi, bisnis, finansial, kepemimpinan, dan Ruang Tafsir Al-Qamar—dengan konteks, contoh, penerapan, serta langkah lanjutan yang jelas."></PageHero>
  <section class="section-tight trust"><div class="container trust-grid"><strong>Dua ruang, satu semangat belajar</strong><p>Artikel STIFIn mengolah konsep dan materi pembelajaran menjadi panduan praktis. Ruang Tafsir Al-Qamar berdiri sebagai kajian Al-Qur’an tersendiri; ia tidak digunakan untuk mengklaim bahwa ayat Al-Qur’an membuktikan konsep STIFIn.</p></div></section>
  <section class="section guide-map"><div class="container"><div class="section-head"><div><span class="eyebrow">Mulai dari peta besar</span><h2>Panduan utama sebelum memilih artikel</h2></div><a class="read" href="/panduan/">Lihat semua panduan →</a></div><div class="guide-grid">{pillars.slice(0, 6).map((pillar) => <a href={`/panduan/${pillar.slug}/`}><small>{pillar.eyebrow}</small><strong>{pillar.title}</strong><span>Buka panduan →</span></a>)}</div></div></section>
  <section class="section themes"><div class="container"><div class="section-head"><div><span class="eyebrow">Pilih tujuan belajar</span><h2>Mulai dari perubahan yang ingin Anda wujudkan</h2></div><a class="read" href="/mulai/">Belum tahu harus mulai dari mana? →</a></div><div class="theme-grid">{themes.map((theme) => { const count = articles.filter((article) => article.data.category === theme.category).length; return <a class="theme-card" href={`/artikel/?tema=${encodeURIComponent(theme.category)}`}><span>{String(count).padStart(2,'0')} artikel</span><h3>{theme.name}</h3><p>{theme.description}</p></a>; })}</div></div></section>
  {featured.length > 0 && <section class="section-tight"><div class="container"><div class="section-head"><div><span class="eyebrow">Pilihan editor</span><h2>Fondasi sebelum melangkah lebih jauh</h2></div></div><div class="featured-grid">{featured.map((article) => <article class="featured-card"><small>{article.data.category} · {article.data.readingTime} menit baca</small><h3><a href={`/artikel/${article.id}/`}>{article.data.title}</a></h3><p>{article.data.description}</p><a class="read" href={`/artikel/${article.id}/`}>Mulai membaca →</a></article>)}</div></div></section>}
  <section class="section article-library"><div class="container"><div class="section-head"><div><span class="eyebrow">Semua panduan</span><h2>{articles.length} artikel untuk belajar, menerapkan, dan bertumbuh</h2></div><a class="read" href="/istilah-stifin/">Buka kamus istilah →</a></div><div class="library-tools"><label><span>Cari artikel</span><input id="article-search" type="search" placeholder="Ketik masalah, kebutuhan, atau istilah…" autocomplete="off" /></label><div class="category-filters" role="group" aria-label="Saring berdasarkan tema"><button class="active" type="button" data-filter="all">Semua</button>{categories.map((category) => <button type="button" data-filter={category}>{category}</button>)}</div><p id="article-result" aria-live="polite">Menampilkan {articles.length} artikel</p></div><div class="articles" id="article-list">{articles.map((article) => <article class="article-card" data-category={article.data.category} data-search={`${article.data.title} ${article.data.description} ${article.data.audience} ${article.data.category}`.toLowerCase()}><div class="thumb"><span>{article.data.category}</span></div><div><small>{article.data.readingTime} menit baca · Untuk {article.data.audience.toLowerCase()}</small><h2><a href={`/artikel/${article.id}/`}>{article.data.title}</a></h2><p>{article.data.description}</p><a class="read" href={`/artikel/${article.id}/`}>Baca panduan lengkap →</a></div></article>)}</div><div class="no-results" id="article-empty" hidden><strong>Belum menemukan bacaan yang cocok.</strong><p>Coba kata yang lebih singkat, pilih tema lain, atau mulai dari situasi yang sedang Anda hadapi.</p><a class="button" href="/mulai/">Mulai dari Kebutuhan Saya</a></div></div></section>
  <script>
    const input = document.querySelector<HTMLInputElement>('#article-search');
    const cards = [...document.querySelectorAll<HTMLElement>('.article-card[data-search]')];
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const result = document.querySelector<HTMLElement>('#article-result');
    const empty = document.querySelector<HTMLElement>('#article-empty');
    const params = new URLSearchParams(window.location.search);
    let category = params.get('tema') || 'all';
    if (input && params.get('q')) input.value = params.get('q') || '';
    const apply = () => {
      const query = input?.value.trim().toLowerCase() || '';
      let visible = 0;
      cards.forEach((card) => { const show = (category === 'all' || card.dataset.category === category) && (!query || card.dataset.search?.includes(query)); card.hidden = !show; if (show) visible += 1; });
      buttons.forEach((button) => button.classList.toggle('active', button.dataset.filter === category));
      if (result) result.textContent = `Menampilkan ${visible} artikel`;
      if (empty) empty.hidden = visible > 0;
    };
    if (!buttons.some((button) => button.dataset.filter === category)) category = 'all';
    buttons.forEach((button) => button.addEventListener('click', () => { category = button.dataset.filter || 'all'; apply(); history.replaceState({}, '', category === 'all' ? '/artikel/' : `/artikel/?tema=${encodeURIComponent(category)}`); }));
    input?.addEventListener('input', apply);
    apply();
  </script>
</BaseLayout>
<style>
  .trust{border-block:1px solid var(--line);background:white}.trust-grid{display:grid;grid-template-columns:.35fr 1fr;gap:40px;align-items:start}.trust p{margin:0}.guide-map{padding-bottom:30px}.guide-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.guide-grid a{display:flex;min-height:190px;flex-direction:column;padding:24px;border:1px solid var(--line);border-radius:var(--radius);background:white;box-shadow:var(--shadow-soft)}.guide-grid small{color:var(--green-800);font-weight:800}.guide-grid strong{margin:22px 0;font-family:var(--font-display);font-size:1.25rem;line-height:1.3}.guide-grid span{margin-top:auto;color:var(--green-800);font-size:.85rem;font-weight:800}.themes{padding-bottom:48px}.theme-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:14px}.theme-card{position:relative;overflow:hidden;padding:24px;border:1px solid var(--line);border-radius:var(--radius);background:white;box-shadow:var(--shadow-soft);transition:transform .2s ease,border-color .2s ease}.theme-card::after{position:absolute;right:-24px;bottom:-24px;width:70px;height:70px;border-radius:50%;background:var(--green-100);content:''}.theme-card:hover{transform:translateY(-4px);border-color:var(--green-700)}.theme-card span,.featured-card small,.article-card small{color:var(--muted);font-size:.78rem}.theme-card h3{margin:24px 0 8px}.theme-card p{margin:0;font-size:.88rem}.featured-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.featured-card{padding:30px;border:1px solid var(--line);border-radius:var(--radius);background:white;color:var(--ink);box-shadow:var(--shadow-soft)}.featured-card:first-child{grid-column:span 2;min-height:280px;padding:clamp(32px,5vw,52px);background:linear-gradient(135deg,var(--green-950),#08603f);color:white}.featured-card:nth-child(3){background:var(--cream)}.featured-card h3{margin:16px 0;font-family:var(--font-display);font-size:1.55rem}.featured-card:first-child h3{max-width:680px;font-size:clamp(1.9rem,4vw,3rem)}.featured-card p{color:var(--muted)}.featured-card:first-child p{max-width:680px;color:#c3d9d1}.article-library{background:linear-gradient(180deg,#f7f8f4,#eef5ef)}.library-tools{margin-bottom:30px;padding:24px;border:1px solid var(--line);border-radius:var(--radius);background:#fff;box-shadow:var(--shadow-soft)}.library-tools label{display:grid;gap:7px}.library-tools label span{color:var(--green-800);font-size:.78rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase}.library-tools input{width:100%;padding:15px 17px;border:1px solid #baccc0;border-radius:12px}.category-filters{display:flex;gap:8px;overflow-x:auto;margin-top:15px;padding-bottom:5px}.category-filters button{flex:0 0 auto;padding:8px 12px;border:1px solid var(--line);border-radius:999px;background:#fff;color:var(--green-900);font-size:.78rem;font-weight:800}.category-filters button.active{background:var(--green-950);color:#fff}.library-tools>p{margin:12px 0 0;font-size:.82rem}.articles{display:grid;grid-template-columns:1fr 1fr;gap:22px}.article-card{overflow:hidden;border:1px solid var(--line);border-radius:var(--radius);background:white;box-shadow:var(--shadow-soft);transition:transform .2s ease,border-color .2s ease}.article-card[hidden]{display:none}.article-card:hover{transform:translateY(-4px);border-color:#b6cbbb}.article-card>div:last-child{padding:27px}.thumb{display:flex;min-height:190px;align-items:end;padding:22px;background:radial-gradient(circle at 80% 20%,rgba(207,224,174,.75),transparent 27%),linear-gradient(145deg,var(--green-950),var(--green-700))}.article-card:nth-child(3n+2) .thumb{background:radial-gradient(circle at 18% 18%,rgba(255,255,255,.2),transparent 22%),linear-gradient(140deg,#3e5633,#83a947)}.article-card:nth-child(3n+3) .thumb{background:radial-gradient(circle at 76% 22%,rgba(215,169,63,.25),transparent 24%),linear-gradient(140deg,#172f26,#526b61)}.thumb span{padding:7px 11px;border-radius:8px;background:rgba(255,255,255,.93);color:var(--green-900);font-size:.75rem;font-weight:800}.article-card h2{margin:12px 0;font-size:1.55rem}.article-card p{font-size:.94rem}.no-results{padding:55px;border:1px dashed var(--line);border-radius:var(--radius);background:#fff;text-align:center}.no-results strong{font-family:var(--font-display);font-size:1.5rem}.no-results p{max-width:600px;margin:10px auto 22px}.read{color:var(--green-800);font-weight:800}.featured-card:first-child .read{color:#d9edb5}@media(max-width:980px){.guide-grid,.theme-grid{grid-template-columns:repeat(2,1fr)}.featured-grid{grid-template-columns:1fr 1fr}.featured-card:first-child{grid-column:span 2}}@media(max-width:700px){.trust-grid,.guide-grid,.articles,.featured-grid,.theme-grid{grid-template-columns:1fr}.featured-card:first-child{grid-column:auto}.thumb{min-height:150px}}
</style>
