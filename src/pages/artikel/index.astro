---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort((a,b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const featured = articles.filter((article) => article.data.featured);
const themes = [
  { name: 'Mulai dari sini', description: 'Pahami fungsi dan batas Tes STIFIn sebelum menerapkannya.', category: 'Mengenal STIFIn' },
  { name: 'Keluarga', description: 'Bangun komunikasi dan pengasuhan tanpa memberi label.', category: 'Keluarga dan Parenting' },
  { name: 'Belajar', description: 'Uji strategi belajar yang dapat diamati dan dievaluasi.', category: 'Belajar dan Pendidikan' },
  { name: 'Karier', description: 'Gabungkan refleksi diri dengan kompetensi dan realitas peluang.', category: 'Karier dan Profesi' },
  { name: 'Organisasi', description: 'Perjelas peran, kepemimpinan, dan sistem kerja tim.', category: 'Bisnis dan Kepemimpinan' },
];
---
<BaseLayout title="Artikel Edukasi | STIFIn Mulia" description="Artikel edukasi tentang konsep STIFIn, belajar, keluarga, karier, bisnis, dan kepemimpinan.">
  <PageHero eyebrow="Pusat Edukasi" title="Bukan sekadar tahu tipe. Temukan langkah yang bisa diuji." description="Panduan panjang tentang STIFIn, keluarga, belajar, karier, bisnis, dan kepemimpinan—ditulis untuk membantu Anda memahami konteks, menerapkan secara bertahap, dan mengenali batasnya."></PageHero>
  <section class="section-tight trust"><div class="container trust-grid"><strong>Standar editorial STIFIn Mulia</strong><p>Kami merangkum materi jaringan dan sumber internal dengan bahasa baru. Setiap artikel membedakan konsep, penerapan praktis, dan batas penggunaan. Tidak ada diagnosis, ramalan, atau janji hasil.</p></div></section>
  <section class="section themes"><div class="container"><div class="section-head"><div><span class="eyebrow">Pilih kebutuhan</span><h2>Mulai dari persoalan yang sedang Anda hadapi</h2></div></div><div class="theme-grid">{themes.map((theme) => { const count = articles.filter((article) => article.data.category === theme.category).length; return <a class="theme-card" href={`#${theme.category.toLowerCase().replaceAll(' ', '-').replaceAll('&','dan')}`}><span>{String(count).padStart(2,'0')} artikel</span><h3>{theme.name}</h3><p>{theme.description}</p></a>; })}</div></div></section>
  {featured.length > 0 && <section class="section-tight"><div class="container"><div class="section-head"><div><span class="eyebrow">Pilihan editor</span><h2>Fondasi sebelum melangkah lebih jauh</h2></div></div><div class="featured-grid">{featured.map((article) => <article class="featured-card"><small>{article.data.category} · {article.data.readingTime} menit baca</small><h3><a href={`/artikel/${article.id}/`}>{article.data.title}</a></h3><p>{article.data.description}</p><a class="read" href={`/artikel/${article.id}/`}>Mulai membaca →</a></article>)}</div></div></section>}
  <section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Semua panduan</span><h2>Delapan artikel pilar untuk penerapan yang lebih matang</h2></div></div><div class="articles">{articles.map((article) => <article class="article-card" id={article.data.category.toLowerCase().replaceAll(' ', '-').replaceAll('&','dan')}><div class="thumb"><span>{article.data.category}</span></div><div><small>{article.data.readingTime} menit baca · Untuk {article.data.audience.toLowerCase()}</small><h2><a href={`/artikel/${article.id}/`}>{article.data.title}</a></h2><p>{article.data.description}</p><a class="read" href={`/artikel/${article.id}/`}>Baca panduan lengkap →</a></div></article>)}</div></div></section>
</BaseLayout>
<style>
  .trust{border-block:1px solid var(--line);background:white}.trust-grid{display:grid;grid-template-columns:.35fr 1fr;gap:40px;align-items:start}.trust p{margin:0}.themes{padding-bottom:48px}.theme-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:14px}.theme-card{padding:24px;border:1px solid var(--line);border-radius:var(--radius);background:white;transition:transform .2s ease,border-color .2s ease}.theme-card:hover{transform:translateY(-3px);border-color:var(--green-700)}.theme-card span,.featured-card small,.article-card small{color:var(--muted);font-size:.78rem}.theme-card h3{margin:24px 0 8px}.theme-card p{margin:0;font-size:.88rem}.featured-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.featured-card{padding:28px;border-radius:var(--radius);background:var(--green-950);color:white}.featured-card h3{margin:16px 0;font-size:1.45rem}.featured-card p{color:#c3d9d1}.articles{display:grid;grid-template-columns:1fr 1fr;gap:22px}.article-card{overflow:hidden;border:1px solid var(--line);border-radius:var(--radius);background:white;scroll-margin-top:110px}.article-card>div:last-child{padding:25px}.thumb{display:flex;min-height:190px;align-items:end;padding:22px;background:radial-gradient(circle at 80% 20%,#a8d15e,transparent 25%),linear-gradient(145deg,var(--green-950),var(--green-700))}.thumb span{padding:7px 11px;border-radius:999px;background:rgba(255,255,255,.93);color:var(--green-900);font-size:.75rem;font-weight:800}.article-card h2{margin:12px 0;font-size:1.5rem}.article-card p{font-size:.94rem}.read{color:var(--green-800);font-weight:800}.featured-card .read{color:#d9edb5}@media(max-width:980px){.theme-grid{grid-template-columns:repeat(2,1fr)}.featured-grid{grid-template-columns:1fr 1fr}}@media(max-width:700px){.trust-grid,.articles,.featured-grid,.theme-grid{grid-template-columns:1fr}.thumb{min-height:150px}}
</style>
