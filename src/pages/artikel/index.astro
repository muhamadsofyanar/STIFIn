---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort((a,b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<BaseLayout title="Artikel Edukasi | STIFIn Mulia" description="Artikel edukasi tentang konsep STIFIn, belajar, keluarga, karier, bisnis, dan kepemimpinan.">
  <PageHero eyebrow="Pusat Edukasi" title="Pengetahuan yang membantu Anda mengambil langkah" description="Artikel disusun dengan bahasa yang jelas, batas klaim yang bertanggung jawab, dan fokus pada penerapan yang relevan."></PageHero>
  <section class="section"><div class="container"><div class="filters" aria-label="Kategori artikel"><span>Semua</span><span>Mengenal STIFIn</span><span>Keluarga</span><span>Pendidikan</span><span>Karier</span><span>Kepemimpinan</span></div><div class="articles">{articles.map((article) => <article class="article-card"><div class="thumb"><span>{article.data.category}</span></div><div><small>{article.data.category} · {article.data.publishedAt.toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'})}</small><h2><a href={`/artikel/${article.id}/`}>{article.data.title}</a></h2><p>{article.data.description}</p><a class="read" href={`/artikel/${article.id}/`}>Baca artikel →</a></div></article>)}</div></div></section>
</BaseLayout>
<style>
  .filters{display:flex;gap:8px;margin-bottom:35px;overflow:auto;padding-bottom:8px}.filters span{flex:0 0 auto;padding:9px 14px;border:1px solid var(--line);border-radius:999px;background:white;color:var(--green-900);font-size:.82rem;font-weight:750}.articles{display:grid;grid-template-columns:1fr 1fr;gap:22px}.article-card{overflow:hidden;border:1px solid var(--line);border-radius:var(--radius);background:white}.article-card>div:last-child{padding:25px}.thumb{display:flex;min-height:210px;align-items:end;padding:22px;background:radial-gradient(circle at 80% 20%,#a8d15e,transparent 25%),linear-gradient(145deg,var(--green-950),var(--green-700))}.thumb span{padding:7px 11px;border-radius:999px;background:rgba(255,255,255,.93);color:var(--green-900);font-size:.75rem;font-weight:800}.article-card small{color:var(--muted)}.article-card h2{margin:12px 0;font-size:1.5rem}.article-card p{font-size:.94rem}.read{color:var(--green-800);font-weight:800}@media(max-width:700px){.articles{grid-template-columns:1fr}.thumb{min-height:170px}}
</style>
