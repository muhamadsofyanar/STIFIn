---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort((a,b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const featured = articles.filter((article) => article.data.featured);
const themes = [
  { name: 'Mulai dari sini', description: 'Kenali cara kerja Tes STIFIn dan manfaat yang dapat Anda terapkan.', category: 'Mengenal STIFIn' },
  { name: 'Keluarga', description: 'Bangun komunikasi dan pengasuhan tanpa memberi label.', category: 'Keluarga dan Parenting' },
  { name: 'Belajar', description: 'Uji strategi belajar yang dapat diamati dan dievaluasi.', category: 'Belajar dan Pendidikan' },
  { name: 'Karier', description: 'Gabungkan refleksi diri dengan kompetensi dan realitas peluang.', category: 'Karier dan Profesi' },
  { name: 'Organisasi', description: 'Perjelas peran, kepemimpinan, dan sistem kerja tim.', category: 'Bisnis dan Kepemimpinan' },
];
---
<BaseLayout title="Artikel Edukasi | STIFIn Mulia" description="Artikel edukasi tentang konsep STIFIn, belajar, keluarga, karier, bisnis, dan kepemimpinan.">
  <PageHero eyebrow="Belajar STIFIn" title="Dari mengenali tipe menuju perubahan yang terasa" description="Temukan panduan tentang keluarga, belajar, karier, bisnis, dan kepemimpinan—lengkap dengan penjelasan konsep, contoh situasi, serta langkah yang dapat langsung dicoba."></PageHero>
  <section class="section-tight trust"><div class="container trust-grid"><strong>Cara kami menyusun panduan</strong><p>Materi jaringan dan sumber internal diolah menjadi penjelasan yang lebih ringan, kontekstual, dan aplikatif agar Anda mudah menghubungkannya dengan kehidupan sehari-hari.</p></div></section>
  <section class="section themes"><div class="container"><div class="section-head"><div><span class="eyebrow">Pilih tujuan belajar</span><h2>Mulai dari perubahan yang ingin Anda wujudkan</h2></div></div><div class="theme-grid">{themes.map((theme) => { const count = articles.filter((article) => article.data.category === theme.category).length; return <a class="theme-card" href={`#${theme.category.toLowerCase().replaceAll(' ', '-').replaceAll('&','dan')}`}><span>{String(count).padStart(2,'0')} artikel</span><h3>{theme.name}</h3><p>{theme.description}</p></a>; })}</div></div></section>
  {featured.length > 0 && <section class="section-tight"><div class="container"><div class="section-head"><div><span class="eyebrow">Pilihan editor</span><h2>Fondasi sebelum melangkah lebih jauh</h2></div></div><div class="featured-grid">{featured.map((article) => <article class="featured-card"><small>{article.data.category} · {article.data.readingTime} menit baca</small><h3><a href={`/artikel/${article.id}/`}>{article.data.title}</a></h3><p>{article.data.description}</p><a class="read" href={`/artikel/${article.id}/`}>Mulai membaca →</a></article>)}</div></div></section>}
  <section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">Semua panduan</span><h2>Delapan artikel pilar untuk penerapan yang lebih matang</h2></div></div><div class="articles">{articles.map((article) => <article class="article-card" id={article.data.category.toLowerCase().replaceAll(' ', '-').replaceAll('&','dan')}><div class="thumb"><span>{article.data.category}</span></div><div><small>{article.data.readingTime} menit baca · Untuk {article.data.audience.toLowerCase()}</small><h2><a href={`/artikel/${article.id}/`}>{article.data.title}</a></h2><p>{article.data.description}</p><a class="read" href={`/artikel/${article.id}/`}>Baca panduan lengkap →</a></div></article>)}</div></div></section>
</BaseLayout>
<style>
  .trust{border-block:1px solid var(--line);background:white}.trust-grid{display:grid;grid-template-columns:.35fr 1fr;gap:40px;align-items:start}.trust p{margin:0}.themes{padding-bottom:48px}.theme-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:14px}.theme-card{position:relative;overflow:hidden;padding:24px;border:1px solid var(--line);border-radius:var(--radius);background:white;box-shadow:var(--shadow-soft);transition:transform .2s ease,border-color .2s ease}.theme-card::after{position:absolute;right:-24px;bottom:-24px;width:70px;height:70px;border-radius:50%;background:var(--green-100);content:''}.theme-card:hover{transform:translateY(-4px);border-color:var(--green-700)}.theme-card span,.featured-card small,.article-card small{color:var(--muted);font-size:.78rem}.theme-card h3{margin:24px 0 8px}.theme-card p{margin:0;font-size:.88rem}.featured-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.featured-card{padding:30px;border:1px solid var(--line);border-radius:var(--radius);background:white;color:var(--ink);box-shadow:var(--shadow-soft)}.featured-card:first-child{grid-column:span 2;min-height:280px;padding:clamp(32px,5vw,52px);background:linear-gradient(135deg,var(--green-950),#08603f);color:white}.featured-card:nth-child(3){background:var(--cream)}.featured-card h3{margin:16px 0;font-family:var(--font-display);font-size:1.55rem}.featured-card:first-child h3{max-width:680px;font-size:clamp(1.9rem,4vw,3rem)}.featured-card p{color:var(--muted)}.featured-card:first-child p{max-width:680px;color:#c3d9d1}.articles{display:grid;grid-template-columns:1fr 1fr;gap:22px}.article-card{overflow:hidden;border:1px solid var(--line);border-radius:var(--radius);background:white;box-shadow:var(--shadow-soft);scroll-margin-top:110px;transition:transform .2s ease,border-color .2s ease}.article-card:hover{transform:translateY(-4px);border-color:#b6cbbb}.article-card>div:last-child{padding:27px}.thumb{display:flex;min-height:190px;align-items:end;padding:22px;background:radial-gradient(circle at 80% 20%,rgba(207,224,174,.75),transparent 27%),linear-gradient(145deg,var(--green-950),var(--green-700))}.article-card:nth-child(3n+2) .thumb{background:radial-gradient(circle at 18% 18%,rgba(255,255,255,.2),transparent 22%),linear-gradient(140deg,#3e5633,#83a947)}.article-card:nth-child(3n+3) .thumb{background:radial-gradient(circle at 76% 22%,rgba(215,169,63,.25),transparent 24%),linear-gradient(140deg,#172f26,#526b61)}.thumb span{padding:7px 11px;border-radius:8px;background:rgba(255,255,255,.93);color:var(--green-900);font-size:.75rem;font-weight:800}.article-card h2{margin:12px 0;font-size:1.55rem}.article-card p{font-size:.94rem}.read{color:var(--green-800);font-weight:800}.featured-card:first-child .read{color:#d9edb5}@media(max-width:980px){.theme-grid{grid-template-columns:repeat(2,1fr)}.featured-grid{grid-template-columns:1fr 1fr}.featured-card:first-child{grid-column:span 2}}@media(max-width:700px){.trust-grid,.articles,.featured-grid,.theme-grid{grid-template-columns:1fr}.featured-card:first-child{grid-column:auto}.thumb{min-height:150px}}
</style>
