---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProofNavigator from '../components/ProofNavigator.astro';
import StoryCapture from '../components/StoryCapture.astro';
import { testimonials } from '../data/testimonials';
import { evidenceLayers } from '../data/proof-center';
import { networkSummary, networkGeneratedAt } from '../data/network';
import { pillars } from '../data/knowledge-architecture';

const articles = await getCollection('articles', ({ data }) => !data.draft);
const formatNumber = (value: number | undefined) => Number(value || 0).toLocaleString('id-ID');
const updated = networkGeneratedAt ? new Date(networkGeneratedAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) : 'mengikuti build terakhir';
const schema = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Pusat Bukti STIFIn Mulia',
  description: 'Testimoni bernama, dokumentasi kegiatan, data jaringan, standar editorial, dan transparansi sumber STIFIn Mulia.',
  url: new URL('/bukti/', Astro.site).toString(), isPartOf: { '@id': new URL('/#website', Astro.site).toString() },
  about: testimonials.map((item) => ({ '@type': 'Person', name: item.name, jobTitle: item.role })),
};
---
<BaseLayout title="Pusat Bukti STIFIn Mulia | Pengalaman, Proses, dan Transparansi" description="Periksa testimoni bernama, dokumentasi kegiatan, data jaringan, sumber materi, standar editorial, serta batas klaim sebelum mengambil keputusan." schema={schema}>
  <section class="proof-hero"><div class="container proof-hero-grid"><div><span class="eyebrow">Proof Center STIFIn Mulia</span><h1>Keyakinan tidak dibangun dari satu testimoni.</h1><p class="lead">Lihat orangnya, pahami konteksnya, periksa prosesnya, baca penjelasannya, lalu tentukan apakah langkah ini relevan bagi Anda.</p><div class="actions"><a class="button" href="#bukti-personal">Temukan Bukti yang Relevan</a><a class="button secondary" href="/standar-editorial/">Periksa Standar Editorial</a></div></div><div class="proof-stack"><div><span>01</span><strong>Pengalaman bernama</strong><small>Tokoh, profesi, konteks, dan asal publikasi jelas.</small></div><div><span>02</span><strong>Proses nyata</strong><small>Tes, pembelajaran, jaringan, dan tindak lanjut dapat dilihat.</small></div><div><span>03</span><strong>Batas klaim</strong><small>Pengalaman bukan jaminan hasil yang sama bagi semua orang.</small></div></div></div></section>

  <section class="section-tight metrics"><div class="container metric-grid"><div><strong>{testimonials.length}</strong><span>testimoni bernama dari publikasi pusat</span></div><div><strong>{pillars.length}</strong><span>panduan utama untuk memeriksa konteks</span></div><div><strong>{articles.length}</strong><span>artikel edukasi dan penerapan</span></div><div><strong>{formatNumber(networkSummary.promoters)}</strong><span>promotor aktif pada data cabang tersinkron</span></div></div><p class="container metric-note">Data jaringan diperbarui {updated}. Angka hanya mencakup cabang yang berhasil tersinkron dan bukan klaim keseluruhan jaringan nasional.</p></section>

  <section class="section evidence"><div class="container"><div class="section-head"><div><span class="eyebrow">Enam lapis kepercayaan</span><h2>Bukti yang baik menjawab pertanyaan berbeda.</h2><p class="lead">Testimoni menjawab pengalaman. Dokumentasi menjawab aktivitas. Data menjawab jangkauan. Standar editorial menjawab tanggung jawab.</p></div></div><div class="evidence-grid">{evidenceLayers.map((item) => <article><span>{item.level}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></div></section>

  <div id="bukti-personal"><ProofNavigator /></div>

  <section class="section activity"><div class="container"><div class="section-head"><div><span class="eyebrow">Aktivitas yang dapat dilihat</span><h2>Bukan gambar stok yang berpura-pura menjadi layanan.</h2><p class="lead">Dokumentasi berikut menunjukkan jenis kegiatan yang dijalankan dalam ekosistem STIFIn Mulia dan jaringan.</p></div></div><div class="activity-grid"><figure><img src="/images/kegiatan/pelaksanaan-tes.webp" width="1200" height="800" alt="Pelaksanaan Tes STIFIn" loading="lazy" /><figcaption><strong>Pelaksanaan tes</strong><span>Pemindaian dilakukan langsung menggunakan alat tes.</span></figcaption></figure><figure><img src="/images/kegiatan/layanan-peserta.webp" width="1200" height="800" alt="Penjelasan kepada peserta STIFIn" loading="lazy" /><figcaption><strong>Pendampingan peserta</strong><span>Hasil dibawa ke percakapan dan kebutuhan nyata.</span></figcaption></figure><figure><img src="/images/kegiatan/pembelajaran-promotor.webp" width="1200" height="800" alt="Pembelajaran promotor STIFIn" loading="lazy" /><figcaption><strong>Pembelajaran</strong><span>Pemahaman diperkuat agar tidak berhenti pada nama tipe.</span></figcaption></figure><figure><img src="/images/kegiatan/jaringan-promotor.webp" width="1200" height="800" alt="Jaringan promotor STIFIn" loading="lazy" /><figcaption><strong>Jaringan layanan</strong><span>Promotor terhubung untuk memperluas jangkauan pelayanan.</span></figcaption></figure></div></div></section>

  <section class="section transparency"><div class="container transparency-grid"><div><span class="eyebrow">Cara membaca bukti</span><h2>Apa yang dapat—dan tidak dapat—disimpulkan?</h2></div><div class="do-dont"><article><strong>Yang dapat disimpulkan</strong><p>Ada orang bernama yang membagikan pengalaman, ada aktivitas yang didokumentasikan, ada materi yang dapat dipelajari, dan ada jaringan yang dapat diperiksa melalui data sinkron.</p></article><article><strong>Yang tidak dapat disimpulkan</strong><p>Bahwa setiap orang pasti memperoleh hasil sama, bahwa tes menggantikan diagnosis profesional, atau bahwa menjadi promotor otomatis menghasilkan pendapatan tertentu.</p></article></div></div></section>

  <StoryCapture />
</BaseLayout>
<style>
  .proof-hero{padding:clamp(78px,10vw,130px) 0;background:radial-gradient(circle at 88% 10%,rgba(215,169,63,.18),transparent 24rem),linear-gradient(125deg,#f7f8f4 0 64%,#e4efe7 64%)}.proof-hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(45px,8vw,100px);align-items:center}.proof-hero h1{font-size:clamp(3rem,7vw,5.7rem);line-height:1.01;text-wrap:balance}.proof-stack{display:grid;gap:10px}.proof-stack>div{display:grid;grid-template-columns:44px 1fr;gap:3px 15px;padding:22px;border:1px solid var(--line);border-radius:16px;background:rgba(255,255,255,.92);box-shadow:var(--shadow-soft)}.proof-stack span{grid-row:1/3;display:grid;width:42px;height:42px;place-items:center;border-radius:50%;background:var(--green-100);color:var(--green-800);font-weight:900}.proof-stack strong,.proof-stack small{grid-column:2}.proof-stack small{color:var(--muted)}.metrics{border-block:1px solid var(--line);background:white}.metric-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line)}.metric-grid>div{padding:25px;background:white}.metric-grid strong,.metric-grid span{display:block}.metric-grid strong{color:var(--green-800);font-family:var(--font-display);font-size:2.1rem}.metric-grid span{color:var(--muted);font-size:.78rem}.metric-note{margin:15px auto 0;font-size:.72rem}.evidence-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.evidence-grid article{min-height:240px;padding:28px;border:1px solid var(--line);border-radius:var(--radius);background:white;box-shadow:var(--shadow-soft)}.evidence-grid span{color:var(--green-800);font-weight:900}.evidence-grid h3{margin:35px 0 12px}.activity{background:#fff}.activity-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.activity-grid figure{overflow:hidden;margin:0;border:1px solid var(--line);border-radius:var(--radius);background:white;box-shadow:var(--shadow-soft)}.activity-grid img{width:100%;aspect-ratio:16/9;object-fit:cover}.activity-grid figcaption{display:grid;padding:22px}.activity-grid span{color:var(--muted);font-size:.85rem}.transparency{background:var(--cream)}.transparency-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:70px}.do-dont{display:grid;gap:14px}.do-dont article{padding:24px;border-left:4px solid var(--lime-500);background:white}.do-dont article:last-child{border-color:var(--amber-500)}.do-dont p{margin:7px 0 0}@media(max-width:900px){.proof-hero-grid,.transparency-grid{grid-template-columns:1fr}.metric-grid,.evidence-grid{grid-template-columns:1fr 1fr}}@media(max-width:620px){.metric-grid,.evidence-grid,.activity-grid{grid-template-columns:1fr}}
</style>
