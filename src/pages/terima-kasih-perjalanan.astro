---
import CampaignLayout from '../layouts/CampaignLayout.astro';
import { site } from '../data/site';
---
<CampaignLayout title="Langkah Anda Sudah Tersimpan | STIFIn Mulia" description="Lanjutkan rekomendasi personal Anda melalui WhatsApp STIFIn Mulia." pixelEvent="Lead">
  <section class="journey-thanks"><div class="campaign-container thanks-grid"><div><span class="success-mark">✓</span><span class="campaign-kicker">Rekomendasi Anda siap</span><h1 id="thanks-title">Langkah Anda sudah lebih jelas.</h1><p class="lead">Kirim ringkasannya melalui WhatsApp agar tim dapat menanggapi sesuai kebutuhan Anda.</p><a id="journey-wa" class="thanks-button" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer">Kirim Ringkasan ke WhatsApp</a><p class="small-note">Nomor pusat STIFIn Mulia: {site.phoneDisplay}</p></div><aside><strong>Yang sudah kami siapkan</strong><ul><li>Tujuan utama yang Anda pilih</li><li>Siapa yang ingin Anda bantu</li><li>Kesiapan dan waktu mulai</li><li>Jalur tindak lanjut yang sesuai</li></ul><div class="reminder"><b>Anda tetap memegang keputusan.</b><span>Silakan bertanya dahulu sebelum menentukan tes, kelas, atau jalur promotor.</span></div></aside></div></section>
  <section class="after"><div class="campaign-container"><span class="campaign-kicker">Ingin melanjutkan sendiri?</span><h2>Gunakan rekomendasi sebagai awal, lalu pilih satu tindakan kecil.</h2><div class="next-grid"><a href="/artikel/"><strong>Baca pusat pengetahuan</strong><span>Temukan panduan yang dapat langsung dipraktikkan →</span></a><a href="/jaringan-promotor/"><strong>Cari layanan di kota Anda</strong><span>Lihat wilayah yang sudah terhubung →</span></a><a href="/perjalanan/"><strong>Ulangi perjalanan</strong><span>Ubah jawaban dan lihat jalur lain →</span></a></div></div></section>
  <script>
    const link = document.querySelector<HTMLAnchorElement>('#journey-wa');
    const title = document.querySelector<HTMLElement>('#thanks-title');
    let lead: Record<string,string> = {};
    try { lead = JSON.parse(sessionStorage.getItem('stifinJourneyLead') || '{}'); } catch {}
    if (lead.journey_label && title) title.textContent = `${lead.name ? `${lead.name}, ` : ''}jalur ${lead.journey_label} Anda sudah siap.`;
    const message = ['Assalamu’alaikum, saya sudah mengikuti Temukan Langkah Saya di stifinmulia.com.', `Nama: ${lead.name || '...'}`, `Kota: ${lead.city || '...'}`, `Kebutuhan: ${lead.journey_label || '...'}`, `Untuk: ${lead.audience || '...'}`, `Kesiapan: ${lead.readiness || '...'}`, `Waktu mulai: ${lead.timeframe || '...'}`, `Rekomendasi: ${lead.lead_temperature || '...'}`, `Sumber: ${lead.utm_source || 'website'} / ${lead.utm_campaign || '-'}`, 'Mohon bantu saya menentukan langkah berikutnya.'].join('\n');
    if (link) link.href = `${link.href}?text=${encodeURIComponent(message)}`;
  </script>
</CampaignLayout>
<style>.journey-thanks{min-height:72vh;padding:clamp(65px,10vw,125px) 0;background:radial-gradient(circle at 82% 10%,rgba(131,169,71,.18),transparent 25rem),#f7f8f4}.thanks-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(40px,8vw,95px);align-items:center}.success-mark{display:grid;width:60px;height:60px;margin-bottom:25px;place-items:center;border-radius:50%;background:var(--green-950);color:#fff;font-size:1.55rem;font-weight:900}.journey-thanks h1{max-width:760px;font-size:clamp(2.6rem,6vw,4.8rem)}.thanks-button{display:inline-flex;min-height:56px;align-items:center;margin-top:22px;padding:13px 22px;border-radius:12px;background:var(--green-950);color:#fff;font-weight:850}.small-note{margin-top:11px;font-size:.8rem}.journey-thanks aside{padding:clamp(26px,4vw,42px);border:1px solid var(--line);border-radius:22px;background:#fff;box-shadow:var(--shadow)}.journey-thanks aside>strong{font-family:var(--font-display);font-size:1.5rem}.journey-thanks li{margin:13px 0;color:var(--muted)}.reminder{padding:16px;border-radius:12px;background:var(--green-100)}.reminder b,.reminder span{display:block}.reminder span{margin-top:4px;color:var(--muted);font-size:.82rem}.after{padding:80px 0;background:#fff;text-align:center}.next-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;margin-top:35px;text-align:left}.next-grid a{display:grid;padding:23px;border:1px solid var(--line);border-radius:15px}.next-grid span{margin-top:8px;color:var(--muted);font-size:.86rem}@media(max-width:800px){.thanks-grid,.next-grid{grid-template-columns:1fr}}</style>
