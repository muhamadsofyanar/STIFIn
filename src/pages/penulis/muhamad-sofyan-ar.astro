---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Callout from '../../components/Callout.astro';
const personSchema = {'@context':'https://schema.org','@type':'Person',name:'Muhamad Sofyan AR',url:new URL('/penulis/muhamad-sofyan-ar/',Astro.site).toString(),image:new URL('/images/muhamad-sofyan-ar.webp',Astro.site).toString(),jobTitle:'Branch Manager STIFIn Genetic Indonesia Cabang Pekalongan',worksFor:{'@id':new URL('/#organization',Astro.site).toString()}};
---
<BaseLayout title="Muhamad Sofyan AR | STIFIn Mulia" description="Profil Muhamad Sofyan AR, pengelola STIFIn Mulia dan peninjau materi layanan serta pembelajaran STIFIn." schema={personSchema}>
  <section class="section dark"><div class="container author"><img src="/images/muhamad-sofyan-ar.webp" width="900" height="1200" alt="Muhamad Sofyan AR" /><div><span class="eyebrow">Pengelola dan peninjau materi</span><h1>Muhamad Sofyan AR</h1><p class="lead">Branch Manager STIFIn Genetic Indonesia Cabang Pekalongan yang mengembangkan layanan dari Bandung dan terhubung dengan jaringan lintas wilayah.</p><p>Ia meninjau artikel STIFIn Mulia pada konteks layanan, pembelajaran, penerapan, dan batas klaim. Latar studi Ilmu Al-Qur’an dan Tafsir di UIN Bandung turut membentuk perhatiannya pada sumber, adab, dan tanggung jawab penyampaian.</p><p>Fokus kerjanya adalah memperbanyak orang yang merasakan manfaat tes, melanjutkan pembelajaran melalui WSL 1, serta menumbuhkan promotor yang aktif melayani.</p><div class="actions"><a class="button light" href="/standar-editorial/">Lihat Standar Editorial</a><a class="button secondary" href="/tentang/">Tentang STIFIn Mulia</a></div></div></div></section>
  <Callout title="Ada pertanyaan tentang artikel atau layanan?" text="Kirim tautan artikel atau ceritakan kebutuhan Anda agar tim dapat mengarahkan percakapan dengan lebih tepat." message="Assalamu’alaikum, saya ingin bertanya tentang artikel/layanan STIFIn Mulia. Tautan atau topik: ..." />
</BaseLayout>
<style>.author{display:grid;grid-template-columns:minmax(280px,.75fr) 1.25fr;gap:clamp(40px,8vw,110px);align-items:center}.author img{width:100%;max-height:690px;object-fit:cover;object-position:center 25%;border-radius:90px 22px 22px 22px}.author h1{color:#fff}@media(max-width:760px){.author{grid-template-columns:1fr}.author img{max-height:520px}}</style>
