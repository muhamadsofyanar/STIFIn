---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProgressionTracker from '../components/ProgressionTracker.astro';
import '../styles/global.css';
import { site } from '../data/site';
interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  schema?: Record<string, unknown> | Record<string, unknown>[];
  funnelStage?: 'awareness' | 'tes' | 'wsl1' | 'promotor';
}
const {
  title = `${site.name} | ${site.tagline}`,
  description = site.description,
  image = '/images/og-default.png',
  noindex = false,
  ogType = 'website',
  schema: pageSchema,
  funnelStage = 'awareness',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': new URL('/#organization', Astro.site).toString(),
  name: site.name,
  url: new URL('/', Astro.site).toString(),
  description: site.description,
  founder: { '@type': 'Person', name: site.owner },
  telephone: '+62 813-3336-2649',
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+62 813-3336-2649',
    contactType: 'customer service',
    availableLanguage: 'Indonesian',
  },
  email: site.email,
  sameAs: [site.instagram, site.youtube, site.facebook, site.telegram],
  areaServed: ['Bandung', 'Kabupaten Bandung', 'Bandung Barat', 'Cimahi', 'Sumedang', 'Indonesia'],
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': new URL('/#website', Astro.site).toString(),
  url: new URL('/', Astro.site).toString(),
  name: site.name,
  inLanguage: 'id-ID',
  publisher: { '@id': new URL('/#organization', Astro.site).toString() },
  potentialAction: {
    '@type': 'SearchAction',
    target: `${new URL('/artikel/', Astro.site).toString()}?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
const schemas = [organizationSchema, websiteSchema, ...(Array.isArray(pageSchema) ? pageSchema : pageSchema ? [pageSchema] : [])];
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#063c32" />
    <link rel="icon" href="/icons/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Artikel STIFIn Mulia" href={new URL('/feed.xml', Astro.site)} />
    {schemas.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <title>{title}</title>
  </head>
  <body data-funnel-stage={funnelStage}>
    <ProgressionTracker stage={funnelStage} />
    <a class="skip-link" href="#main-content">Lewati ke konten utama</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
  </body>
</html>
