---
import { testimonialById } from '../data/testimonials';
interface Props { mode?: 'home' | 'test' | 'wsl' | 'promotor'; compact?: boolean }
const { mode = 'home', compact = false } = Astro.props;
const selections = {
  home: ['melly-goeslaw', 'seto-mulyadi', 'subiakto', 'asri-welas', 'arief-rachman', 'ibnu-ririn'],
  test: ['melly-goeslaw', 'asri-welas', 'arifia-maulida', 'ibnu-ririn'],
  wsl: ['melly-goeslaw', 'arief-rachman', 'kris-pujiatni'],
  promotor: ['subiakto', 'arief-rachman', 'kumaidi'],
};
const items = selections[mode].map((id) => testimonialById[id]);
const headings = {
  home: ['Testimoni terverifikasi', 'Bukan hanya reaksi anonim. Ini pengalaman yang dipublikasikan oleh STIFIn pusat.'],
  test: ['Pengalaman mengikuti Tes STIFIn', 'Mereka menemukan manfaat yang berbeda, sesuai kebutuhan hidupnya.'],
  wsl: ['Mengapa hasil perlu dipahami', 'Pengenalan diri menjadi lebih bernilai ketika dibawa ke belajar, keluarga, dan tindakan.'],
  promotor: ['Manfaat yang dapat diperluas', 'Konsep yang dipahami dengan baik dapat membuka percakapan di keluarga, pendidikan, dan dunia profesional.'],
};
---
<section class:list={['authority-proof', { compact }]}>
  <div class="authority-container">
    <div class="authority-head"><div><span>{headings[mode][0]}</span><h2>{headings[mode][1]}</h2></div><a href="/testimoni/">Lihat semua testimoni →</a></div>
    <div class="authority-grid">
      {items.map((item) => <article class="authority-card">
        <div class="person"><img src={item.image} width="600" height="600" alt={`Foto ${item.name}`} loading="lazy" decoding="async" style={`object-position:${item.objectPosition}`} /><div><h3>{item.name}</h3><p>{item.role}</p></div></div>
        <p class="summary">{item.summary}</p>
        <div class="card-foot"><span>{item.relevance}</span><em>{item.sourceLabel}</em></div>
      </article>)}
    </div>
    <p class="authority-note">Testimoni diringkas dari publikasi STIFIn pusat. Foto bersumber dari arsip galeri testimoni jaringan STIFIn. Mereka adalah pengguna atau narasumber jaringan STIFIn, bukan testimoni langsung layanan STIFIn Mulia.</p>
  </div>
</section>
<style>
  .authority-proof{padding:clamp(72px,9vw,110px) 0;background:#fff}.authority-container{width:min(calc(100% - 40px),1170px);margin-inline:auto}.authority-head{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:35px}.authority-head>div{max-width:850px}.authority-head span{color:var(--green-700);font-size:.75rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase}.authority-head h2{margin:11px 0 0;font-size:clamp(2rem,4.4vw,3.55rem);line-height:1.08;text-wrap:balance}.authority-head>a{flex:0 0 auto;color:var(--green-800);font-weight:850}.authority-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.authority-card{display:flex;min-height:330px;flex-direction:column;padding:24px;border:1px solid var(--line);border-radius:19px;background:#f9faf7;box-shadow:var(--shadow-soft)}.person{display:grid;grid-template-columns:72px 1fr;gap:15px;align-items:center}.person img{width:72px;height:72px;border:3px solid white;border-radius:50%;object-fit:cover;box-shadow:0 7px 20px rgba(4,63,43,.13)}.person h3{margin:0 0 4px;font-size:1.14rem}.person p{margin:0;color:var(--muted);font-size:.75rem;line-height:1.4}.summary{margin:24px 0;font-size:.91rem;line-height:1.72}.card-foot{display:flex;align-items:end;justify-content:space-between;gap:12px;margin-top:auto;padding-top:16px;border-top:1px solid var(--line)}.card-foot span{max-width:62%;color:var(--green-700);font-size:.68rem;font-weight:800;text-transform:uppercase}.card-foot em{max-width:38%;color:var(--muted);font-size:.65rem;font-style:normal;line-height:1.35;text-align:right}.authority-note{margin:25px 0 0;color:var(--muted);font-size:.7rem;line-height:1.6}.compact{padding:65px 0;background:linear-gradient(145deg,#f4f8f3,#e9f1e9)}.compact .authority-grid{grid-template-columns:repeat(3,1fr)}.compact .authority-card{min-height:315px}
  @media(max-width:960px){.authority-grid,.compact .authority-grid{grid-template-columns:1fr 1fr}.authority-head{align-items:start;flex-direction:column}}
  @media(max-width:620px){.authority-container{width:min(calc(100% - 28px),1170px)}.authority-grid,.compact .authority-grid{grid-template-columns:1fr}.authority-card{min-height:auto}.authority-head>a{padding:10px 0}.person{grid-template-columns:62px 1fr}.person img{width:62px;height:62px}}
</style>
