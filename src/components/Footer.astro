---
import Brand from './Brand.astro';
import { site, waLink } from '../data/site';
---
<footer class="footer">
  <div class="container footer-grid">
    <div><Brand light /><p>{site.description}</p></div>
    <div><strong>Layanan</strong><a href="/tes-stifin/">Tes STIFIn</a><a href="/jaringan-promotor/">Cari Promotor</a><a href="/jadi-promotor/">Jadi Promotor</a><a href="/kerja-sama/">Kerja Sama</a></div>
    <div><strong>Informasi</strong><a href="/tentang/">Tentang Kami</a><a href="/artikel/">Artikel Edukasi</a><a href="/faq/">Pertanyaan Umum</a><a href="/privasi/">Kebijakan Privasi</a><a href="/disclaimer/">Disclaimer</a></div>
    <div><strong>Hubungi & Ikuti</strong><a data-wa-intent="footer-konsultasi" href={waLink('Assalamu’alaikum, saya ingin berkonsultasi dengan STIFIn Mulia.')} target="_blank" rel="noopener noreferrer">WhatsApp {site.phoneDisplay}</a><a href={`mailto:${site.email}`}>{site.email}</a><a href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram</a><a href={site.youtube} target="_blank" rel="noopener noreferrer">YouTube</a><a href={site.facebook} target="_blank" rel="noopener noreferrer">Facebook</a><a href={site.telegram} target="_blank" rel="noopener noreferrer">Telegram</a><p>Wilayah utama: Bandung Raya dan Sumedang.</p></div>
  </div>
  <div class="container bottom"><span>© {new Date().getFullYear()} STIFIn Mulia.</span><span>Belajar, melayani, dan bertumbuh bersama.</span></div>
</footer>
<style>
  .footer { position:relative;padding: 78px 0 28px; border-top:5px solid var(--lime-500);background:linear-gradient(135deg,#032f21,var(--green-950)); color: white; }
  .footer-grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1.2fr; gap: 48px; }
  .footer p { max-width: 380px; margin-top: 18px; color: #bed3cc; font-size: .92rem; }
  .footer strong { display: block; margin-bottom: 18px; font-family:var(--font-display);font-size:1.08rem; }
  .footer a { display: block; margin: 10px 0; color: #bed3cc; font-size: .92rem;transition:color .2s ease,transform .2s ease; }
  .footer a:hover { color: white; transform:translateX(3px); }
  .bottom { display: flex; justify-content: space-between; gap: 24px; margin-top: 54px; padding-top: 22px; border-top: 1px solid rgba(255,255,255,.14); color: #9dbab0; font-size: .82rem; }
  @media (max-width: 850px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .footer-grid { grid-template-columns: 1fr; gap: 30px; } .bottom { flex-direction: column; } }
</style>
