---
import { site, waLink } from '../data/site';
---
<footer class="footer">
  <div class="container footer-grid">
    <div><a class="footer-lockup" href="/" aria-label="Beranda STIFIn Mulia"><img class="lockup-mark" src="/images/brand-stifin-mulia-mark.webp" width="58" height="58" alt="" aria-hidden="true" /><img class="lockup-word" src="/images/brand-stifin-mulia-wordmark.webp" width="245" height="130" alt="STIFIn Mulia" /></a><p>{site.description}</p></div>
    <div><strong>Mulai di sini</strong><a href="/tes-stifin/">Ikuti Tes STIFIn</a><a href="/jaringan-promotor/">Tes di Kota Saya</a><a href="/jadi-promotor/">Peluang Jadi Promotor</a><a href="/kerja-sama/">Program untuk Lembaga</a></div>
    <div><strong>Belajar</strong><a href="/mulai/">Mulai dari Kebutuhan</a><a href="/artikel/">Pusat Pengetahuan</a><a href="/istilah-stifin/">Kamus Istilah STIFIn</a><a href="/testimoni/">Cerita & Testimoni</a><a href="/faq/">Pertanyaan Umum</a><a href="/tentang/">Tentang Kami</a></div>
    <div><strong>Hubungi & Ikuti</strong><a class="portal-link" href={site.portal}>Buka Portal STIFIn Mulia</a><a data-wa-intent="footer-konsultasi" href={waLink('Assalamu’alaikum, saya ingin mengenal layanan STIFIn Mulia.')} target="_blank" rel="noopener noreferrer">WhatsApp {site.phoneDisplay}</a><a href={`mailto:${site.email}`}>{site.email}</a><a href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram</a><a href={site.youtube} target="_blank" rel="noopener noreferrer">YouTube</a><a href={site.facebook} target="_blank" rel="noopener noreferrer">Facebook</a><a href={site.telegram} target="_blank" rel="noopener noreferrer">Telegram</a><p>Berbasis di Bandung, terhubung untuk melayani berbagai kota melalui jaringan STIFIn.</p></div>
  </div>
  <div class="container bottom"><span>© {new Date().getFullYear()} STIFIn Mulia.</span><span>Belajar, melayani, dan bertumbuh bersama.</span></div>
</footer>
<style>
  .footer { position:relative;padding: 78px 0 28px; border-top:5px solid var(--lime-500);background:linear-gradient(135deg,#032f21,var(--green-950)); color: white; }
  .footer-grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1.2fr; gap: 48px; }
  .footer-lockup{display:flex;align-items:center;gap:14px;width:fit-content}.lockup-mark{width:58px;height:58px;border-radius:50%;object-fit:cover}.lockup-word{width:min(245px,calc(100vw - 125px));height:64px;object-fit:cover;object-position:center}
  .footer p { max-width: 380px; margin-top: 18px; color: #bed3cc; font-size: .92rem; }
  .footer strong { display: block; margin-bottom: 18px; font-family:var(--font-display);font-size:1.08rem; }
  .footer a { display: block; margin: 10px 0; color: #bed3cc; font-size: .92rem;transition:color .2s ease,transform .2s ease; }
  .footer a:hover { color: white; transform:translateX(3px); }.footer .portal-link{width:fit-content;padding:8px 11px;border:1px solid rgba(255,255,255,.22);border-radius:9px;color:#fff}
  .bottom { display: flex; justify-content: space-between; gap: 24px; margin-top: 54px; padding-top: 22px; border-top: 1px solid rgba(255,255,255,.14); color: #9dbab0; font-size: .82rem; }
  @media (max-width: 850px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .footer-grid { grid-template-columns: 1fr; gap: 30px; } .bottom { flex-direction: column; } }
</style>
