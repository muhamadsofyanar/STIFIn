---
import { testimonialById } from '../data/testimonials';
import { proofJourneys } from '../data/proof-center';
import { pillarBySlug } from '../data/knowledge-architecture';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<section class:list={['proof-navigator', { compact }]}>
  <div class="container">
    <div class="proof-head"><div><span class="eyebrow">Bukti sesuai kebutuhan Anda</span><h2>Jangan lihat testimoni yang paling terkenal. Lihat yang paling relevan.</h2></div><p>Pilih situasi Anda. Kami menampilkan pengalaman bernama, konteksnya, panduan untuk memeriksa lebih jauh, serta langkah yang dapat dipilih.</p></div>
    <div class="proof-tabs" role="tablist" aria-label="Pilih kebutuhan bukti">{proofJourneys.map((journey, index) => <button type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`proof-${journey.id}`} data-proof-tab={journey.id}>{journey.label}</button>)}</div>
    <div class="proof-panels">{proofJourneys.map((journey, index) => { const pillar = pillarBySlug[journey.pillarSlug]; return <article id={`proof-${journey.id}`} data-proof-panel={journey.id} hidden={index !== 0}><header><span>Bukti untuk {journey.label}</span><h3>{journey.question}</h3></header><div class="proof-people">{journey.testimonialIds.map((id) => { const item = testimonialById[id]; return <div><img src={item.image} width="600" height="600" alt={`Foto ${item.name}`} loading="lazy" style={`object-position:${item.objectPosition}`} /><div><strong>{item.name}</strong><small>{item.role}</small><p>{item.summary}</p><em>{item.sourceLabel}</em></div></div>; })}</div><footer><div><small>Jangan berhenti pada testimoni</small><a href={`/panduan/${pillar.slug}/`}>{pillar.title} →</a></div><a class="button" href={journey.cta}>{journey.ctaLabel}</a></footer></article>; })}</div>
    <p class="proof-disclosure">Seluruh tokoh di atas berasal dari publikasi jaringan STIFIn pusat, bukan klaim sebagai klien langsung STIFIn Mulia. Pengalaman seseorang tidak menjamin hasil yang sama bagi orang lain.</p>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('.proof-navigator').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-proof-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-proof-panel]')];
    const activate = (id: string) => { tabs.forEach((tab) => { const active = tab.dataset.proofTab === id; tab.setAttribute('aria-selected', String(active)); tab.tabIndex = active ? 0 : -1; }); panels.forEach((panel) => panel.hidden = panel.dataset.proofPanel !== id); };
    tabs.forEach((tab) => tab.addEventListener('click', () => activate(tab.dataset.proofTab || '')));
  });
</script>
<style>
  .proof-navigator{padding:clamp(76px,10vw,120px) 0;background:linear-gradient(145deg,#e7f1e9,#f8faf6)}.proof-head{display:grid;grid-template-columns:1.15fr .85fr;gap:60px;align-items:end;margin-bottom:35px}.proof-head h2{margin-bottom:0}.proof-head>p{margin:0}.proof-tabs{display:flex;gap:9px;overflow-x:auto;padding:3px 3px 14px}.proof-tabs button{flex:0 0 auto;padding:10px 15px;border:1px solid var(--line);border-radius:999px;background:white;color:var(--green-900);font-weight:800}.proof-tabs button[aria-selected="true"]{border-color:var(--green-950);background:var(--green-950);color:white}.proof-panels>article{overflow:hidden;border:1px solid var(--line);border-radius:var(--radius-lg);background:#fff;box-shadow:var(--shadow)}.proof-panels>article[hidden]{display:none}.proof-panels header{padding:clamp(28px,5vw,48px);background:var(--green-950);color:white}.proof-panels header span{color:#d4e6b5;font-size:.76rem;font-weight:900;text-transform:uppercase;letter-spacing:.1em}.proof-panels header h3{max-width:900px;margin:12px 0 0;font-family:var(--font-display);font-size:clamp(1.7rem,3.4vw,2.7rem)}.proof-people{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line)}.proof-people>div{display:grid;grid-template-columns:72px 1fr;gap:16px;padding:25px;background:#fff}.proof-people img{width:72px;height:72px;border-radius:50%;object-fit:cover}.proof-people strong,.proof-people small,.proof-people em{display:block}.proof-people small{color:var(--muted);font-size:.72rem}.proof-people p{margin:15px 0;font-size:.84rem}.proof-people em{color:var(--green-700);font-size:.65rem;font-style:normal;font-weight:800}.proof-panels footer{display:flex;align-items:center;justify-content:space-between;gap:25px;padding:24px 28px;background:#f6f8f4}.proof-panels footer small,.proof-panels footer a{display:block}.proof-panels footer small{color:var(--muted)}.proof-panels footer div>a{color:var(--green-800);font-family:var(--font-display);font-size:1.12rem;font-weight:700}.proof-disclosure{margin:18px 0 0;font-size:.72rem}.compact{padding:70px 0}.compact .proof-head h2{font-size:clamp(1.9rem,4vw,3rem)}@media(max-width:900px){.proof-head{grid-template-columns:1fr}.proof-people{grid-template-columns:1fr}.proof-people>div{grid-template-columns:64px 1fr}.proof-people img{width:64px;height:64px}}@media(max-width:620px){.proof-panels footer{align-items:stretch;flex-direction:column}.proof-panels footer .button{width:100%}}
</style>
