<div class="reading-progress" aria-hidden="true"><i></i></div>
<aside class="reading-tools" aria-label="Perangkat membaca">
  <div class="toc-block"><strong>Di halaman ini</strong><nav id="article-toc" aria-label="Daftar isi artikel"><span>Menyiapkan daftar isi…</span></nav></div>
  <div class="reading-note"><strong>Baca untuk diterapkan</strong><p>Pilih satu gagasan yang dekat dengan situasi Anda. Coba satu langkah kecil, lalu amati respons dan perubahannya.</p></div>
  <div class="share-tools"><button type="button" id="share-article">Bagikan artikel</button><button type="button" id="copy-article">Salin tautan</button><span id="copy-status" role="status" aria-live="polite"></span></div>
</aside>
<script>
  const slugify = (value: string) => value.toLowerCase().trim().replace(/[^a-z0-9\u00c0-\u024f\u1e00-\u1eff]+/g, '-').replace(/^-|-$/g, '');
  const prose = document.querySelector<HTMLElement>('.article-body .prose');
  const toc = document.querySelector<HTMLElement>('#article-toc');
  const headings = prose ? [...prose.querySelectorAll<HTMLElement>('h2, h3')] : [];
  if (toc) {
    toc.innerHTML = '';
    if (!headings.length) toc.innerHTML = '<span>Artikel ringkas tanpa bagian tambahan.</span>';
    headings.forEach((heading, index) => {
      if (!heading.id) heading.id = `${slugify(heading.textContent || 'bagian')}-${index + 1}`;
      const link = document.createElement('a');
      link.href = `#${heading.id}`;
      link.textContent = heading.textContent || `Bagian ${index + 1}`;
      if (heading.tagName === 'H3') link.classList.add('sub');
      toc.append(link);
    });
  }
  const progress = document.querySelector<HTMLElement>('.reading-progress i');
  const updateProgress = () => {
    if (!prose || !progress) return;
    const start = prose.getBoundingClientRect().top + window.scrollY - 130;
    const distance = Math.max(1, prose.offsetHeight - window.innerHeight * .55);
    const value = Math.min(1, Math.max(0, (window.scrollY - start) / distance));
    progress.style.transform = `scaleX(${value})`;
  };
  updateProgress();
  window.addEventListener('scroll', updateProgress, { passive: true });
  const status = document.querySelector<HTMLElement>('#copy-status');
  const copy = async () => {
    try { await navigator.clipboard.writeText(window.location.href); if (status) status.textContent = 'Tautan tersalin.'; }
    catch { if (status) status.textContent = 'Salin tautan dari bilah alamat peramban.'; }
  };
  document.querySelector('#copy-article')?.addEventListener('click', copy);
  document.querySelector('#share-article')?.addEventListener('click', async () => {
    if (navigator.share) { try { await navigator.share({ title: document.title, url: window.location.href }); } catch {} }
    else await copy();
  });
</script>
<style>
  .reading-progress{position:fixed;z-index:60;top:0;right:0;left:0;height:4px;background:transparent;pointer-events:none}.reading-progress i{display:block;width:100%;height:100%;background:linear-gradient(90deg,var(--lime-500),var(--amber-500));transform:scaleX(0);transform-origin:left center}.reading-tools{position:sticky;top:105px;display:grid;gap:0;overflow:hidden;border:1px solid #c8d8cc;border-radius:var(--radius-sm);background:#fff;box-shadow:var(--shadow-soft)}.reading-tools>div{padding:22px}.reading-tools>div+div{border-top:1px solid var(--line)}.toc-block>strong,.reading-note>strong{display:block;margin-bottom:12px}.toc-block nav{display:grid;gap:2px}.toc-block nav a{padding:7px 0;color:var(--green-800);font-size:.84rem;font-weight:760;line-height:1.35}.toc-block nav a.sub{padding-left:13px;color:var(--muted);font-size:.8rem}.toc-block nav span{color:var(--muted);font-size:.82rem}.reading-note{background:linear-gradient(145deg,#f4f1e8,#eef4ef)}.reading-note p{margin:0;font-size:.86rem}.share-tools{display:grid;grid-template-columns:1fr 1fr;gap:8px}.share-tools button{padding:9px;border:1px solid var(--line);border-radius:9px;background:#fff;color:var(--green-900);font-size:.78rem;font-weight:850}.share-tools button:hover{border-color:var(--green-700)}.share-tools span{grid-column:1/-1;color:var(--muted);font-size:.75rem}
</style>
