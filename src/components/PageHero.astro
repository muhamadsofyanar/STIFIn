---
interface Props { eyebrow: string; title: string; description: string }
const { eyebrow, title, description } = Astro.props;
---
<section class="page-hero">
  <div class="container"><span class="eyebrow">{eyebrow}</span><h1>{title}</h1><p class="lead">{description}</p><slot /></div>
</section>
<style>
  .page-hero { position: relative; overflow: hidden; padding: clamp(72px, 9vw, 118px) 0; background: radial-gradient(circle at 86% 18%, #d6ecd9, transparent 30%), linear-gradient(145deg, #fbfcfa, #eef6f1); }
  .page-hero::after { position: absolute; right: -120px; bottom: -220px; width: 520px; height: 520px; border: 1px solid rgba(10,103,87,.15); border-radius: 50%; content: ''; }
  h1 { max-width: 930px; margin-bottom: 24px; font-size: clamp(2.4rem, 6vw, 4.7rem); }
</style>
