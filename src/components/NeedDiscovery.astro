---
import type { CollectionEntry } from 'astro:content';
import { knowledgeJourneys } from '../data/knowledge';

interface Props {
  articles: CollectionEntry<'articles'>[];
  compact?: boolean;
}

const { articles, compact = false } = Astro.props;
const articleMap = new Map(articles.map((article) => [article.id, article]));
---
<section class:list={['need-discovery', { compact }]}>
  <div class="container">
    <div class="discovery-head">
      <div><span class="eyebrow">Mulai dari situasi Anda</span><h2>Tak perlu tahu istilahnya dulu. Pilih hal yang ingin Anda pahami.</h2></div>
      <p>Setiap pintu membawa Anda ke penjelasan yang relevan, bacaan pilihan, dan langkah berikutnya. Anda tetap memegang keputusan—kami membantu membuat jalannya lebih jelas.</p>
    </div>
    <div class="need-tabs" role="tablist" aria-label="Pilih kebutuhan">
      {knowledgeJourneys.map((journey, index) => <button type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`need-${journey.id}`} id={`tab-${journey.id}`} data-need-tab={journey.id}>{journey.label}</button>)}
    </div>
    <div class="need-panels">
      {knowledgeJourneys.map((journey, index) => <article class="need-panel" id={`need-${journey.id}`} role="tabpanel" aria-labelledby={`tab-${journey.id}`} data-need-panel={journey.id} hidden={index !== 0}>
        <div class="need-copy"><span class="need-number">{String(index + 1).padStart(2, '0')}</span><h3>{journey.question}</h3><p>{journey.answer}</p><a class="button" href={journey.actionHref}>{journey.actionLabel}</a></div>
        <div class="need-reading"><span>Bacaan yang membantu Anda mulai</span>{journey.articleIds.map((id) => { const article = articleMap.get(id); return article && <a href={`/artikel/${article.id}/`}><small>{article.data.readingTime} menit baca</small><strong>{article.data.title}</strong><i>Baca panduan →</i></a>; })}</div>
      </article>)}
    </div>
    {compact && <div class="all-needs"><a href="/mulai/">Lihat seluruh jalur berdasarkan kebutuhan →</a></div>}
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('.need-discovery').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-need-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-need-panel]')];
    const activate = (id: string, focus = false) => {
      tabs.forEach((tab) => {
        const active = tab.dataset.needTab === id;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && focus) tab.focus();
      });
      panels.forEach((panel) => { panel.hidden = panel.dataset.needPanel !== id; });
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(tab.dataset.needTab || ''));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
        activate(tabs[next].dataset.needTab || '', true);
      });
    });
  });
</script>
<style>
  .need-discovery{padding:clamp(76px,10vw,120px) 0;background:linear-gradient(145deg,#edf5ef,#f8faf6)}.discovery-head{display:grid;grid-template-columns:1.1fr .9fr;gap:70px;align-items:end;margin-bottom:38px}.discovery-head h2{max-width:760px;margin-bottom:0}.discovery-head>p{margin:0}.need-tabs{display:flex;gap:9px;overflow-x:auto;padding:3px 3px 14px;scrollbar-width:thin}.need-tabs button{flex:0 0 auto;padding:11px 16px;border:1px solid var(--line);border-radius:999px;background:#fff;color:var(--green-900);font-weight:800}.need-tabs button[aria-selected="true"]{border-color:var(--green-950);background:var(--green-950);color:#fff;box-shadow:0 10px 24px rgba(4,63,43,.15)}.need-panel{display:grid;grid-template-columns:.9fr 1.1fr;gap:2px;overflow:hidden;border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--line);box-shadow:var(--shadow)}.need-panel[hidden]{display:none}.need-copy{padding:clamp(32px,5vw,58px);background:var(--green-950);color:#fff}.need-copy p{color:#c5d9d1}.need-copy h3{max-width:620px;margin:25px 0 18px;font-family:var(--font-display);font-size:clamp(1.75rem,3.5vw,2.7rem);line-height:1.12}.need-number{display:grid;width:46px;height:46px;place-items:center;border-radius:50%;background:rgba(255,255,255,.11);color:#dceabf;font-weight:900}.need-copy .button{margin-top:12px;background:#d7a93f;color:#13271e}.need-reading{display:grid;gap:10px;padding:clamp(28px,4vw,46px);background:#fff}.need-reading>span{margin-bottom:4px;color:var(--green-800);font-size:.78rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase}.need-reading>a{display:grid;grid-template-columns:1fr auto;gap:5px 20px;padding:18px 0;border-bottom:1px solid var(--line)}.need-reading>a:last-child{border-bottom:0}.need-reading small{grid-column:1;color:var(--muted)}.need-reading strong{grid-column:1;font-family:var(--font-display);font-size:1.2rem;line-height:1.25}.need-reading i{grid-column:2;grid-row:1/3;align-self:center;color:var(--green-800);font-size:.82rem;font-style:normal;font-weight:850}.all-needs{margin-top:25px;text-align:right}.all-needs a{color:var(--green-800);font-weight:850}.compact .need-tabs button:nth-child(n+5),.compact .need-panel:nth-child(n+5){display:none}@media(max-width:820px){.discovery-head,.need-panel{grid-template-columns:1fr;gap:25px}.need-reading>a{grid-template-columns:1fr}.need-reading i{grid-column:1;grid-row:auto}}
</style>
