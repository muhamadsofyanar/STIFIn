---
interface Props { compact?: boolean; light?: boolean }
const { compact = false, light = false } = Astro.props;
---
<a class:list={['brand', { compact, light }]} href="/" aria-label="Beranda STIFIn Mulia">
  <span class="mark" aria-hidden="true"><span></span></span>
  {!compact && <span class="word"><strong>STIFIn</strong><b>Mulia</b></span>}
</a>
<style>
  .brand { display: inline-flex; align-items: center; gap: 11px; color: var(--green-950); }
  .mark { position: relative; display: grid; width: 42px; height: 42px; place-items: center; overflow: hidden; border: 2px solid var(--amber-500); border-radius: 50%; background: var(--green-950); }
  .mark::before, .mark::after { content: ''; position: absolute; top: 12px; width: 17px; height: 16px; background: var(--lime-500); }
  .mark::before { left: 5px; border-radius: 14px 3px 14px 3px; transform: rotate(35deg); }
  .mark::after { right: 5px; border-radius: 3px 14px 3px 14px; transform: rotate(-35deg); }
  .mark span { position: absolute; bottom: 8px; width: 25px; height: 3px; border-radius: 8px; background: var(--amber-500); }
  .word { display: flex; align-items: baseline; gap: 5px; font-size: 1.06rem; letter-spacing: -.025em; }
  .word strong { font-weight: 850; }
  .word b { color: var(--green-700); font-weight: 650; }
  .light { color: white; }
  .light .word b { color: #a7d659; }
</style>
